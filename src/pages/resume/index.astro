---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { siteContent } from '../../data/siteContent';
---

<BaseLayout
  title={siteContent.meta.resumeTitle}
  description={siteContent.meta.resumeDescription}
  canonicalPath="/resume"
>
  <Header variant="resume" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[960px] mx-auto px-6 sm:px-10 py-12 sm:py-20 focus:outline-none"
  >
    <!-- Document Actions Bar -->
    <div class="flex items-center justify-between pb-8 mb-10 border-b border-[var(--rule-hairline)] text-xs font-mono-spec print:hidden">
      <a
        href="/"
        class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1.5"
      >
        <span>← Return to Index</span>
      </a>

      <div class="flex items-center gap-2">
        <a
          href="/resume/tarik-gungor-resume.pdf"
          download="tarik-gungor-resume.pdf"
          class="px-3 py-1.5 bg-[var(--text-primary)] text-[var(--bg-surface)] font-semibold hover:bg-[var(--signal)] hover:text-white transition-colors"
        >
          Download PDF ↓
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="px-3 py-1.5 border border-[var(--rule-hairline)] hover:border-[var(--text-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        >
          Print ⎙
        </button>
        <a
          href="/resume/tarik-gungor-resume.json"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 border border-[var(--rule-hairline)] hover:border-[var(--text-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
        >
          JSON Schema ↗
        </a>
      </div>
    </div>

    <!-- Resume Article -->
    <article class="space-y-16 print:space-y-8">
      <!-- Header / Identity -->
      <header class="space-y-4">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--text-primary)] print:text-black">
          {siteContent.meta.name}
        </h1>
        <div class="text-base sm:text-lg text-[var(--signal)] font-medium font-sans print:text-black">
          {siteContent.resume.headline} — {siteContent.resume.subheadline}
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono-spec text-[var(--text-secondary)] print:text-black">
          <span>{siteContent.meta.region}</span>
          <span>·</span>
          <div class="inline-flex items-center gap-1.5">
            <a href={`mailto:${siteContent.meta.email}`} class="hover:text-[var(--signal)]">
              {siteContent.meta.email}
            </a>
            <button
              type="button"
              id="copy-email-btn"
              data-email={siteContent.meta.email}
              class="px-1 py-0.2 border border-[var(--rule-hairline)] text-[10px] text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer print:hidden"
            >
              [copy]
            </button>
          </div>
          <span>·</span>
          <a
            href={siteContent.meta.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--signal)]"
          >
            linkedin.com/in/tarikgungor
          </a>
          <span>·</span>
          <a
            href={siteContent.meta.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--signal)]"
          >
            github.com/gungortarik
          </a>
        </div>
      </header>

      <!-- Section: Professional Summary -->
      <section id="summary" class="space-y-4 scroll-mt-24">
        <h2 class="text-xs font-mono-spec font-bold text-[var(--signal)] uppercase tracking-wider pb-2 border-b border-[var(--rule-hairline)]">
          Summary
        </h2>
        <p class="text-base sm:text-[17px] text-[var(--text-secondary)] leading-[1.75] print:text-black">
          {siteContent.resume.summary}
        </p>
      </section>

      <!-- Section: Technical Skills -->
      <section id="skills" class="space-y-6 scroll-mt-24">
        <h2 class="text-xs font-mono-spec font-bold text-[var(--signal)] uppercase tracking-wider pb-2 border-b border-[var(--rule-hairline)]">
          Technical Skills &amp; Competencies
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 text-sm">
          {
            siteContent.resume.skills.map((skill) => (
              <div class="space-y-1.5">
                <div class="text-[11px] font-mono-spec uppercase text-[var(--text-muted)]">
                  {skill.category}
                </div>
                <div class="font-medium text-[var(--text-primary)] leading-snug print:text-black">
                  {skill.items.join(' · ')}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Professional Experience -->
      <section id="experience" class="space-y-8 scroll-mt-24">
        <h2 class="text-xs font-mono-spec font-bold text-[var(--signal)] uppercase tracking-wider pb-2 border-b border-[var(--rule-hairline)]">
          Professional Experience
        </h2>
        <div class="space-y-10 divide-y divide-[var(--rule-hairline)]">
          {
            siteContent.resume.experience.map((job, idx) => (
              <div class={idx > 0 ? 'pt-8' : ''}>
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div>
                    <h3 class="font-display text-xl sm:text-2xl font-bold text-[var(--text-primary)] print:text-black">
                      {job.company}
                    </h3>
                    <div class="text-sm font-sans font-medium text-[var(--signal)] mt-0.5 print:text-black">
                      {job.role} <span class="text-xs text-[var(--text-muted)] font-mono-spec font-normal">({job.scaleBadge})</span>
                    </div>
                  </div>
                  <div class="text-xs font-mono-spec text-[var(--text-muted)] mt-1 sm:mt-0">
                    <span>{job.location}</span>
                    <span class="mx-1.5">·</span>
                    <span class="text-[var(--text-primary)] font-semibold print:text-black">{job.period}</span>
                  </div>
                </div>

                <ul class="mt-4 space-y-2 text-sm text-[var(--text-secondary)] leading-relaxed print:text-black">
                  {job.highlights.map((bullet) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-[var(--signal)] text-xs mt-1 shrink-0">▪</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Verified Infrastructure Labs -->
      <section id="labs" class="space-y-6 scroll-mt-24">
        <h2 class="text-xs font-mono-spec font-bold text-[var(--signal)] uppercase tracking-wider pb-2 border-b border-[var(--rule-hairline)]">
          Verified Infrastructure Labs &amp; Configurations
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono-spec">
          {
            siteContent.resume.labs.map((lab) => (
              <div class="p-4 bg-[var(--bg-panel)]/50 border border-[var(--rule-hairline)] space-y-1.5">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-bold text-[var(--signal)]">{lab.id}</span>
                  <span class="text-[var(--text-muted)]">{lab.category}</span>
                </div>
                <div class="font-display font-semibold text-sm text-[var(--text-primary)] print:text-black">
                  {lab.name}
                </div>
                <div class="text-[12px] text-[var(--text-secondary)] font-sans leading-relaxed print:text-neutral-800">
                  {lab.description}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Education & Credentials -->
      <section id="education" class="space-y-6 scroll-mt-24">
        <h2 class="text-xs font-mono-spec font-bold text-[var(--signal)] uppercase tracking-wider pb-2 border-b border-[var(--rule-hairline)]">
          Education &amp; Polytechnic Training
        </h2>
        <div class="space-y-6 divide-y divide-[var(--rule-hairline)]">
          {
            siteContent.resume.education.map((edu, idx) => (
              <div class={idx > 0 ? 'pt-6' : ''}>
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div>
                    <h3 class="font-display text-lg sm:text-xl font-bold text-[var(--text-primary)] print:text-black">
                      {edu.institution}
                    </h3>
                    <div class="text-sm text-[var(--text-secondary)] font-medium mt-0.5 print:text-neutral-700">
                      {edu.credential}
                    </div>
                  </div>
                  <div class="text-xs font-mono-spec text-[var(--text-muted)] mt-1 sm:mt-0">
                    {edu.location && <span>{edu.location} · </span>}
                    <span class="text-[var(--text-primary)] font-semibold print:text-black">{edu.period}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = '[copied ✓]';
      setTimeout(() => {
        copyBtn.textContent = '[copy]';
      }, 1800);
    } catch {}
  });
</script>
