---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { siteContent } from '../../data/siteContent';

const r = siteContent.resume;
---

<BaseLayout title={siteContent.meta.resumeTitle} description={siteContent.meta.resumeDescription} canonicalPath="/resume">
  <main id="main-content" class="wrap pt-40 sm:pt-52 pb-28 sm:pb-40">
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-16 sm:pb-24">
      <div class="lg:col-span-8">
        <h1 class="display text-[clamp(3rem,8vw,7.5rem)]">{siteContent.meta.name}</h1>
        <p class="mt-6 text-[clamp(1.2rem,2vw,1.7rem)] tracking-[-0.015em] text-[var(--ink-2)]">
          {r.headline} — {r.subheadline}
        </p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[15px] text-[var(--muted)]">
          <span>{siteContent.meta.region}</span>
          <a href={`mailto:${siteContent.meta.email}`} class="hover:text-[var(--ink)]">{siteContent.meta.email}</a>
          <a href={siteContent.meta.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">LinkedIn</a>
          <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">GitHub</a>
        </div>
      </div>
      <div class="lg:col-span-3 lg:col-start-10 flex lg:justify-end items-end gap-3 print:hidden">
        <a href="/resume/tarik-gungor-resume.pdf" download class="round-btn btn-fill" data-magnetic="0.4">
          <span data-magnetic-inner>Download PDF</span>
        </a>
      </div>
    </header>

    <section id="summary" class="grid grid-cols-1 lg:grid-cols-12 gap-6 border-t border-[var(--line)] py-12 sm:py-16">
      <h2 class="lg:col-span-3 text-[13px] text-[var(--muted)]">Summary</h2>
      <p class="lg:col-span-8 text-[clamp(1.15rem,1.7vw,1.45rem)] leading-[1.5] tracking-[-0.01em]">{r.summary}</p>
    </section>

    <section id="experience" class="grid grid-cols-1 lg:grid-cols-12 gap-6 border-t border-[var(--line)] py-12 sm:py-16">
      <h2 class="lg:col-span-3 text-[13px] text-[var(--muted)]">Experience</h2>
      <div class="lg:col-span-8 space-y-14">
        {
          r.experience.map((job) => (
            <div>
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-[1.6rem] tracking-[-0.02em]">{job.company}</h3>
                <span class="text-[15px] text-[var(--muted)] tabular-nums">{job.period}</span>
              </div>
              <div class="mt-1 text-[15px] text-[var(--ink-2)]">
                {job.role} · {job.location} · {job.scaleBadge}
              </div>
              <ul class="mt-5 space-y-2 text-[15px] leading-relaxed text-[var(--ink-2)] list-disc pl-5 marker:text-[var(--muted)]">
                {job.highlights.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="skills" class="grid grid-cols-1 lg:grid-cols-12 gap-6 border-t border-[var(--line)] py-12 sm:py-16">
      <h2 class="lg:col-span-3 text-[13px] text-[var(--muted)]">Skills</h2>
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-7">
        {
          r.skills.map((s) => (
            <div>
              <div class="text-[13px] text-[var(--muted)] capitalize">{s.category.toLowerCase()}</div>
              <div class="mt-1.5 text-[16px]">{s.items.join(', ')}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="labs" class="grid grid-cols-1 lg:grid-cols-12 gap-6 border-t border-[var(--line)] py-12 sm:py-16">
      <h2 class="lg:col-span-3 text-[13px] text-[var(--muted)]">Lab environments</h2>
      <div class="lg:col-span-8 space-y-8">
        {
          r.labs.map((lab) => (
            <div>
              <h3 class="text-[1.2rem] tracking-[-0.015em]">{lab.name}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-[var(--ink-2)]">{lab.description}</p>
              <p class="mt-1 text-[13px] text-[var(--muted)]">{lab.protocols.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="education" class="grid grid-cols-1 lg:grid-cols-12 gap-6 border-y border-[var(--line)] py-12 sm:py-16">
      <h2 class="lg:col-span-3 text-[13px] text-[var(--muted)]">Education</h2>
      <div class="lg:col-span-8 space-y-10">
        {
          r.education.map((e) => (
            <div>
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-[1.6rem] tracking-[-0.02em]">{e.institution}</h3>
                <span class="text-[15px] text-[var(--muted)] tabular-nums">{e.period}</span>
              </div>
              <div class="mt-1 text-[15px] text-[var(--ink-2)]">{e.credential}</div>
              <div class="mt-1 text-[13px] text-[var(--muted)]">{e.focus}</div>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
