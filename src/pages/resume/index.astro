---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { siteContent } from '../../data/siteContent';

const r = siteContent.resume;
---

<BaseLayout title={siteContent.meta.resumeTitle} description={siteContent.meta.resumeDescription} canonicalPath="/resume">
  <main id="main-content" class="wrap pt-12 sm:pt-20 pb-28 sm:pb-40 space-y-16">
    <!-- Header -->
    <header class="tactile-card p-8 sm:p-12 space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 pb-8 border-b border-[var(--line)]">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-subtle)] border border-[var(--line)] text-xs font-mono text-[var(--accent)] font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>{r.headline} · {r.subheadline}</span>
          </div>
          <h1 class="font-heading text-4xl sm:text-6xl font-bold tracking-tight text-[var(--ink)]">
            {siteContent.meta.name}
          </h1>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs sm:text-sm font-mono text-[var(--muted)]">
            <span>{siteContent.meta.region}, Canada</span>
            <span class="text-[var(--line-strong)]">·</span>
            <a href={`mailto:${siteContent.meta.email}`} class="text-[var(--ink)] hover:text-[var(--accent)]">{siteContent.meta.email}</a>
            <span class="text-[var(--line-strong)]">·</span>
            <a href={siteContent.meta.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)] hover:text-[var(--accent)]">LinkedIn ↗</a>
            <span class="text-[var(--line-strong)]">·</span>
            <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)] hover:text-[var(--accent)]">GitHub ↗</a>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 shrink-0 print:hidden">
          <a href="/resume/tarik-gungor-resume.pdf" download class="btn-primary" data-magnetic="0.3">
            <span data-magnetic-inner class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download PDF</span>
            </span>
          </a>
          <button type="button" onclick="window.print()" class="btn-secondary" data-magnetic="0.3">
            <span data-magnetic-inner>Print</span>
          </button>
        </div>
      </div>

      <!-- Professional Summary -->
      <div class="space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Professional Summary</h2>
        <p class="text-base sm:text-lg leading-relaxed text-[var(--ink-2)] max-w-4xl">
          {r.summary}
        </p>
      </div>
    </header>

    <!-- Experience -->
    <section id="experience" class="tactile-card p-8 sm:p-12 space-y-8">
      <div class="border-b border-[var(--line)] pb-4">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Work History</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink)] mt-1">Professional Experience</h2>
      </div>

      <div class="space-y-12">
        {
          r.experience.map((job) => (
            <div class="space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <h3 class="font-heading text-xl sm:text-2xl font-bold text-[var(--ink)]">{job.company}</h3>
                  <div class="text-sm font-medium text-[var(--accent)] mt-0.5">
                    {job.role} · {job.location} · <span class="font-mono text-xs">{job.scaleBadge}</span>
                  </div>
                </div>
                <span class="text-xs font-mono text-[var(--muted)]">{job.period}</span>
              </div>
              <ul class="space-y-2 text-sm sm:text-[15px] leading-relaxed text-[var(--ink-2)] list-disc pl-5 marker:text-[var(--accent)]">
                {job.highlights.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Technical Skills Grid -->
    <section id="skills" class="tactile-card p-8 sm:p-12 space-y-8">
      <div class="border-b border-[var(--line)] pb-4">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Core Competencies</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink)] mt-1">Technical Skills</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          r.skills.map((s) => (
            <div class="p-4 rounded-xl bg-[var(--bg-subtle)] border border-[var(--line)] space-y-2">
              <div class="text-xs font-mono uppercase tracking-wider text-[var(--muted)]">{s.category}</div>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {s.items.map((item) => (
                  <span class="tech-pill font-mono">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Lab Environments -->
    <section id="labs" class="tactile-card p-8 sm:p-12 space-y-8">
      <div class="border-b border-[var(--line)] pb-4">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Practical Engineering</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink)] mt-1">Virtual Lab Environments</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          r.labs.map((lab) => (
            <div class="p-5 rounded-xl bg-[var(--bg-subtle)] border border-[var(--line)] flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-[var(--accent)] mb-2">
                  <span>{lab.id}</span>
                  <span class="text-[var(--muted)]">{lab.category}</span>
                </div>
                <h3 class="font-heading text-lg font-bold text-[var(--ink)]">{lab.name}</h3>
                <p class="mt-2 text-sm text-[var(--ink-2)] leading-relaxed">{lab.description}</p>
              </div>
              <div class="pt-3 border-t border-[var(--line)] flex flex-wrap gap-1.5">
                {lab.protocols.map((p) => (
                  <span class="tech-pill text-[11px] font-mono">{p}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section id="education" class="tactile-card p-8 sm:p-12 space-y-8">
      <div class="border-b border-[var(--line)] pb-4">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Academic Foundation</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink)] mt-1">Education</h2>
      </div>

      <div class="space-y-8">
        {
          r.education.map((e) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-6 border-b border-[var(--line)] last:border-b-0 last:pb-0">
              <div>
                <h3 class="font-heading text-xl font-bold text-[var(--ink)]">{e.institution}</h3>
                <div class="text-sm font-medium text-[var(--accent)] mt-0.5">{e.credential}</div>
                <div class="mt-1 text-xs font-mono text-[var(--muted)]">{e.focus}</div>
              </div>
              <span class="text-xs font-mono text-[var(--muted)] shrink-0">{e.period}</span>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
