---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { siteContent } from '../../data/siteContent';
---

<BaseLayout
  title={siteContent.meta.resumeTitle}
  description={siteContent.meta.resumeDescription}
  canonicalPath="/resume"
>
  <Header variant="resume" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[960px] mx-auto px-6 sm:px-8 py-12 sm:py-20 focus:outline-none"
  >
    <!-- Document Actions Bar -->
    <div class="flex items-center justify-between pb-8 mb-12 border-b border-[var(--rule-hairline)] text-xs font-mono-spec print:hidden">
      <a
        href="/"
        class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1.5"
      >
        <span>← Back to home</span>
      </a>

      <div class="flex items-center gap-2">
        <a
          href="/resume/tarik-gungor-resume.pdf"
          download="tarik-gungor-resume.pdf"
          class="px-3.5 py-1.5 rounded bg-[var(--text-primary)] text-[var(--bg-surface)] font-medium hover:opacity-85 transition-opacity"
        >
          Download PDF ↓
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="px-3 py-1.5 rounded border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        >
          Print
        </button>
      </div>
    </div>

    <article class="space-y-14 print:space-y-8">
      <!-- Header / Identity -->
      <header class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start">
        <div class="md:col-span-3 pt-1 text-xs font-mono-spec text-[var(--text-muted)] space-y-1">
          <div class="text-[var(--text-primary)] font-medium">{siteContent.meta.region}</div>
          <div>Curriculum Vitae</div>
        </div>

        <div class="md:col-span-9 space-y-4">
          <div>
            <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-[var(--text-primary)] print:text-black">
              {siteContent.meta.name}
            </h1>
            <div class="text-base text-[var(--text-secondary)] mt-1 print:text-black">
              {siteContent.resume.headline} · {siteContent.resume.subheadline}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-xs font-mono-spec text-[var(--text-secondary)] print:text-black">
            <a href={`mailto:${siteContent.meta.email}`} class="hover:text-[var(--text-primary)]">
              {siteContent.meta.email}
            </a>
            <span>·</span>
            <a
              href={siteContent.meta.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--text-primary)]"
            >
              linkedin.com/in/tarikgungor
            </a>
            <span>·</span>
            <a
              href={siteContent.meta.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--text-primary)]"
            >
              github.com/gungortarik
            </a>
          </div>
        </div>
      </header>

      <!-- Section: Summary -->
      <section id="summary" class="pt-10 border-t border-[var(--rule-hairline)] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start scroll-mt-24">
        <h2 class="md:col-span-3 text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
          Summary
        </h2>
        <p class="md:col-span-9 text-[15.5px] text-[var(--text-secondary)] leading-[1.75] print:text-black">
          {siteContent.resume.summary}
        </p>
      </section>

      <!-- Section: Experience -->
      <section id="experience" class="pt-10 border-t border-[var(--rule-hairline)] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start scroll-mt-24">
        <h2 class="md:col-span-3 text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
          Experience
        </h2>
        <div class="md:col-span-9 space-y-10 divide-y divide-[var(--rule-hairline)]">
          {
            siteContent.resume.experience.map((job, idx) => (
              <div class={idx > 0 ? 'pt-8' : ''}>
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div>
                    <h3 class="font-display text-lg font-semibold text-[var(--text-primary)] print:text-black">
                      {job.company}
                    </h3>
                    <div class="text-sm text-[var(--text-secondary)] mt-0.5 print:text-black">
                      {job.role} <span class="text-xs text-[var(--text-muted)] font-mono-spec">· {job.scaleBadge}</span>
                    </div>
                  </div>
                  <div class="text-xs font-mono-spec text-[var(--text-muted)]">
                    {job.location} · {job.period}
                  </div>
                </div>

                <ul class="mt-3.5 space-y-1.5 text-sm text-[var(--text-secondary)] leading-relaxed list-disc pl-4 print:text-black">
                  {job.highlights.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Technical Skills -->
      <section id="skills" class="pt-10 border-t border-[var(--rule-hairline)] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start scroll-mt-24">
        <h2 class="md:col-span-3 text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
          Skills
        </h2>
        <div class="md:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
          {
            siteContent.resume.skills.map((skill) => (
              <div class="space-y-1">
                <div class="text-[11px] font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
                  {skill.category}
                </div>
                <div class="text-[var(--text-primary)] leading-snug print:text-black">
                  {skill.items.join(' · ')}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Systems Labs -->
      <section id="labs" class="pt-10 border-t border-[var(--rule-hairline)] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start scroll-mt-24">
        <h2 class="md:col-span-3 text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
          Systems Labs
        </h2>
        <div class="md:col-span-9 divide-y divide-[var(--rule-hairline)]">
          {
            siteContent.resume.labs.map((lab, idx) => (
              <div class={idx > 0 ? 'pt-4 mt-4' : ''}>
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-display text-sm font-semibold text-[var(--text-primary)] print:text-black">
                    {lab.name}
                  </h3>
                  <span class="text-xs font-mono-spec text-[var(--text-muted)]">
                    {lab.protocols.join(' · ')}
                  </span>
                </div>
                <p class="text-sm text-[var(--text-secondary)] mt-1 leading-relaxed print:text-neutral-800">
                  {lab.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Education -->
      <section id="education" class="pt-10 border-t border-[var(--rule-hairline)] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-start scroll-mt-24">
        <h2 class="md:col-span-3 text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
          Education
        </h2>
        <div class="md:col-span-9 space-y-6 divide-y divide-[var(--rule-hairline)]">
          {
            siteContent.resume.education.map((edu, idx) => (
              <div class={idx > 0 ? 'pt-6' : ''}>
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div>
                    <h3 class="font-display text-base font-semibold text-[var(--text-primary)] print:text-black">
                      {edu.institution}
                    </h3>
                    <div class="text-sm text-[var(--text-secondary)] mt-0.5 print:text-neutral-700">
                      {edu.credential}
                    </div>
                  </div>
                  <div class="text-xs font-mono-spec text-[var(--text-muted)]">
                    {edu.location && <span>{edu.location} · </span>}
                    <span>{edu.period}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>
