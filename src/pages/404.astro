---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found — Tarik Gungor" description="This page doesn't exist." canonicalPath="/404" includeStructuredPerson={false}>
  <main id="main-content" class="flex-1 wrap flex items-center justify-center py-32">
    <div class="tactile-card p-10 sm:p-16 max-w-lg text-center space-y-6">
      <div class="font-mono text-xs text-[var(--accent)] uppercase tracking-wider font-semibold">Error 404 // Host Unreachable</div>
      <div class="font-heading text-6xl sm:text-8xl font-bold text-[var(--ink)]">404</div>
      <p class="text-base text-[var(--ink-2)] leading-relaxed">
        The requested routing path does not exist on this gateway, or the resource has been relocated.
      </p>
      <div class="pt-2">
        <a href="/" class="btn-primary" data-magnetic="0.3">
          <span data-magnetic-inner>Return to Gateway Home →</span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
