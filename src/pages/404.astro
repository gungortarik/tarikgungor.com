---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 — Page Not Found | Tarik Gungor"
  description="The requested page could not be found."
  canonicalPath="/404"
  includeStructuredPerson={false}
>
  <Header variant="home" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[960px] mx-auto px-6 sm:px-8 py-24 sm:py-32 focus:outline-none"
  >
    <div class="max-w-md space-y-4">
      <div class="text-xs font-mono-spec text-[var(--text-muted)]">404</div>
      <h1 class="font-display font-semibold text-2xl sm:text-3xl text-[var(--text-primary)] tracking-tight">
        Page not found
      </h1>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
        The page you are looking for doesn't exist or has been moved.
      </p>
      <div class="pt-2">
        <a
          href="/"
          class="text-sm font-medium text-[var(--text-primary)] hover:underline inline-flex items-center gap-1"
        >
          <span>← Back to home</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
