---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Tarik Gungor" description="This page doesn't exist." canonicalPath="/404" includeStructuredPerson={false}>
  <main id="main-content" class="flex-1 bg-[var(--bg-soft)] flex items-end">
    <div class="wrap pb-16 pt-48">
      <div class="display text-[clamp(7rem,26vw,24rem)]">404</div>
      <div class="mt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-8">
        <p class="text-[clamp(1.2rem,2vw,1.7rem)] tracking-[-0.015em] text-[var(--ink-2)]">This page doesn't exist — or it moved.</p>
        <a href="/" class="pill-btn btn-fill self-start" data-magnetic="0.25"><span data-magnetic-inner>Back home</span></a>
      </div>
    </div>
  </main>
</BaseLayout>
