---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/siteContent';

const labTopologies: Record<string, { map: string; verify: string; rationale: string }> = {
  'LAB-01': {
    map: `WAN / ISP gateway (10.0.0.1)
 └─ pfSense — NAT & firewall
     ├─ VLAN 10  192.168.10.0/24   workstations
     ├─ VLAN 20  192.168.20.0/24   domain controllers, servers
     └─ VLAN 30  192.168.30.0/24   isolated management & SAN`,
    verify: 'pfctl -sr | grep pass',
    rationale: 'Segregates untrusted client workstations from core domain infrastructure using strict 802.1Q sub-interfaces and firewall rules.',
  },
  'LAB-02': {
    map: `corp.local
 └─ OU  Toronto
     ├─ OU  Workstations   GPO: BitLocker, LAPS, firewall baseline
     ├─ OU  Users          security groups, tiered access
     └─ OU  Servers        DC01 + DC02 DFSR replication`,
    verify: 'Get-ADOrganizationalUnit -Filter * | select DistinguishedName',
    rationale: 'Implements Microsoft Tiered Administration Model to mitigate lateral privilege escalation across the domain.',
  },
  'LAB-03': {
    map: `client ──> AD-integrated DNS (192.168.20.10 / .11)
 ├─ zone   corp.local   secure dynamic updates + PTR
 └─ forwarders          1.1.1.1 / 9.9.9.9`,
    verify: 'Resolve-DnsName dc01.corp.local -Server 192.168.20.10',
    rationale: 'Crucial for Kerberos ticket issuance, domain controller discovery, and secure hostname resolution across VLANs.',
  },
  'LAB-04': {
    map: `Ubuntu Server — isc-dhcp-server
 ├─ scope VLAN 10   192.168.10.50 – .200   24h lease
 ├─ scope VLAN 20   192.168.20.50 – .100
 └─ reservations    printers, management interfaces`,
    verify: 'systemctl status isc-dhcp-server && dhcp-lease-list',
    rationale: 'Centralized Linux-based lease provisioning across trunked segments with lease expiration tracking and MAC reservations.',
  },
  'LAB-05': {
    map: `TrueNAS target — RAID 10
 └─ iSCSI portal :3260 (storage subnet)
     ├─ Hyper-V host 01   MPIO path A
     └─ Hyper-V host 02   MPIO path B`,
    verify: 'iscsicli ListTargets',
    rationale: 'Block storage presentation over TCP/IP with redundant multipathing (MPIO) to survive single NIC failures.',
  },
  'LAB-06': {
    map: `node 01 (file server) <── heartbeat ──> node 02 (file server)
 └─ shared VHD Set on iSCSI storage + file share witness`,
    verify: 'Get-ClusterNode; Get-ClusterResource',
    rationale: 'Zero-downtime high-availability file cluster with automatic failover between nodes upon host failure.',
  },
  'LAB-07': {
    map: `physical host
 └─ nested VMware ESXi 8.0
     ├─ vSwitch0   management (vmk0)
     └─ vSwitch1   lab trunk, 802.1Q tagged`,
    verify: 'esxcli network vswitch standard list',
    rationale: 'Nested hypervisor testing environment enabling multi-tenant VMware vSphere validation inside a single physical workstation.',
  },
};

const path = [
  {
    years: '2026 — now',
    title: 'George Brown College',
    sub: 'Computer Systems Technology, Advanced Diploma',
    text: 'Networking, routing & switching, Linux, Windows Server and virtualization — while building Sonoma and CertForge on the side.',
  },
  {
    years: '2024 — now',
    title: 'BETA PREP',
    sub: 'IT Specialist · 38 endpoints, hybrid',
    text: 'Windows 10/11 devices, Microsoft 365 accounts, new staff device setups and day-to-day connectivity issues (DNS, DHCP, IP config).',
  },
  {
    years: '2023 — now',
    title: 'Bestof Floor LTD',
    sub: 'IT Support Specialist · 23 devices, on-prem & AD',
    text: 'Hardware and software troubleshooting, Active Directory accounts, and keeping the internal network and daily operations running.',
  },
  {
    years: '2023',
    title: 'Payment Source',
    sub: 'IT Analyst, Internship · 50+ endpoints',
    text: 'Device configuration with ManageEngine Endpoint Central, MDM rollouts and structured policy deployment.',
  },
  {
    years: '2022 — 2023',
    title: 'BCIT',
    sub: 'Technology Support Professional',
    text: 'Hands-on training across Windows infrastructure, networking, virtualization, Linux and IT support.',
  },
];

const note = siteContent.notes[0];
---

<BaseLayout title={siteContent.meta.title} description={siteContent.meta.description} canonicalPath="/">
  <main id="main-content">
    <!-- HERO (Balanced, Proportional Dennis Snellenberg Editorial Layout) -->
    <section class="relative h-[100svh] min-h-[640px] max-h-[1050px] bg-[var(--bg-soft)] overflow-hidden">
      <!-- signature -->
      <img
        src="/assets/logos/tarik-gungor-signature.svg"
        alt="Tarik Gungor signature"
        width="1330"
        height="420"
        class="hero-sig absolute inset-x-0 mx-auto top-[18%] sm:top-[16%] w-[min(76vw,680px)] h-auto opacity-[0.92] select-none pointer-events-none"
      />

      <!-- location pill -->
      <div class="absolute left-0 top-[48%] sm:top-[44%] hidden sm:flex items-center gap-6 bg-[var(--dark)] text-white rounded-r-full pl-[var(--pad)] pr-3 py-3 shadow-lg">
        <span class="text-[14px] leading-tight">Located<br />in Toronto,<br />Canada</span>
        <span class="w-[64px] h-[64px] rounded-full bg-white/10 grid place-items-center">
          <svg class="spin-slow w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="12" cy="12" r="9.5"></circle>
            <ellipse cx="12" cy="12" rx="4.2" ry="9.5"></ellipse>
            <path d="M2.5 12h19M4 7h16M4 17h16"></path>
          </svg>
        </span>
      </div>

      <!-- role -->
      <div class="absolute right-[var(--pad)] top-[48%] sm:top-[44%] text-[clamp(1.25rem,2.2vw,2rem)] leading-[1.2] tracking-[-0.02em]">
        <svg class="w-5 h-5 mb-4 sm:mb-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M5 5l14 14M19 8v11H8"></path>
        </svg>
        IT Support &amp; Systems<br />Student &amp; Builder
      </div>

      <!-- marquee (clean, fully visible within viewport) -->
      <div class="absolute bottom-6 sm:bottom-10 left-0 w-full overflow-hidden select-none" aria-hidden="true">
        <div class="marquee-track display !leading-[1] text-[clamp(4.2rem,11.5vw,10.8rem)] text-[var(--ink)]" data-marquee>
          <span>Tarik Gungor — Systems &amp; Support —</span>
          <span>Tarik Gungor — Systems &amp; Support —</span>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="wrap pt-28 sm:pt-40 pb-24 sm:pb-36">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <p class="lg:col-span-8 text-[clamp(1.55rem,2.9vw,2.7rem)] leading-[1.28] tracking-[-0.022em]" data-reveal>
          I study Computer Systems Technology in Toronto and work in IT support — keeping Windows machines, networks and
          Microsoft 365 accounts running for real teams. On the side I build practical software and virtual lab environments
          to understand how systems actually work.
        </p>
        <div class="lg:col-span-3 lg:col-start-10 flex flex-col justify-between gap-10" data-reveal>
          <p class="text-[15px] leading-relaxed text-[var(--ink-2)]">
            Building systems. Learning continuously. Living intentionally. This site is where I document the work, the
            lessons, and the life around them.
          </p>
          <a href="/resume" data-magnetic="0.4" class="round-btn btn-fill self-start lg:self-end">
            <span data-magnetic-inner>Resume</span>
          </a>
        </div>
      </div>
    </section>

    <!-- WORK (Dennis Snellenberg Cursor-Follower Preview + Josh Comeau Interactive Touch) -->
    <section id="work" class="wrap pb-28 sm:pb-40 scroll-mt-8">
      <div class="text-[13px] text-[var(--muted)] mb-6">Recent work</div>

      <div class="work-list border-b border-[var(--line)]">
        <!-- Sonoma Row -->
        <div
          data-work-index="0"
          class="work-row block border-t border-[var(--line)] py-10 sm:py-14 group"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="work-title">
              <h3 class="display text-[clamp(2.6rem,6.5vw,6.2rem)] pl-0 md:pl-4 group-hover:translate-x-2 transition-transform duration-500">Sonoma</h3>
              <p class="md:pl-5 mt-3 text-[15px] text-[var(--ink-2)] max-w-xl">
                A private expense and document tool I built for myself — receipts, recurring costs and a clear monthly picture,
                without handing my records to a third-party aggregator.
              </p>
            </div>
            <div class="text-[15px] md:text-right shrink-0 md:pr-4">
              <div>Private tool</div>
              <div class="text-[var(--muted)]">Next.js · TypeScript · Tailwind</div>
              <a
                href="/assets/projects/sonoma-dashboard.png"
                data-lightbox
                data-lightbox-src="/assets/projects/sonoma-dashboard.png"
                data-lightbox-alt="Sonoma dashboard"
                class="mt-2 inline-block text-xs font-mono text-[var(--accent)] hover:underline cursor-zoom-in"
              >
                Inspect dashboard ↗
              </a>
            </div>
          </div>
          <!-- Visible Dashboard Preview -->
          <div class="mt-8 md:ml-4 rounded-xl overflow-hidden bg-[#e2e5e9] p-4 sm:p-6 max-w-2xl border border-[var(--line)] shadow-sm">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-black/10 text-xs font-mono text-[var(--ink-2)]">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-black/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-black/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-black/20"></span>
              </div>
              <span>sonoma.internal / private vault</span>
            </div>
            <img src="/assets/projects/sonoma-dashboard.png" alt="Sonoma dashboard" loading="lazy" class="w-full rounded shadow" />
          </div>
        </div>

        <!-- CertForge Row -->
        <div
          data-work-index="1"
          class="work-row block border-t border-[var(--line)] py-10 sm:py-14 group"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="work-title">
              <h3 class="display text-[clamp(2.6rem,6.5vw,6.2rem)] md:pl-4 group-hover:translate-x-2 transition-transform duration-500">CertForge</h3>
              <p class="md:pl-5 mt-3 text-[15px] text-[var(--ink-2)] max-w-xl">
                An open-source study platform for CompTIA Network+ and Cisco CCNA — active recall for OSI layers, subnetting,
                routing and VLANs instead of passive reading.
              </p>
            </div>
            <div class="text-[15px] md:text-right shrink-0 md:pr-4">
              <div>Open source</div>
              <a href="https://github.com/gungortarik/certforge" target="_blank" rel="noopener noreferrer" class="text-[var(--muted)] hover:text-[var(--ink)] underline">github.com/gungortarik ↗</a>
            </div>
          </div>

          <!-- Josh Comeau Active Recall Drill Widget inside CertForge -->
          <div class="mt-8 md:ml-4 p-6 sm:p-7 rounded-2xl bg-[var(--bg-soft)] border border-[var(--line)] max-w-3xl">
            <div class="flex items-center justify-between pb-3 border-b border-[var(--line)] text-xs font-mono text-[var(--muted)]">
              <span class="text-[var(--accent)] font-semibold flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
                <span id="drill-domain">CompTIA Network+ // Subnetting &amp; CIDR</span>
              </span>
              <span id="drill-step">Drill 1 of 4</span>
            </div>
            <div class="my-4">
              <p id="drill-question" class="text-[16px] sm:text-[18px] font-medium text-[var(--ink)] leading-snug">
                How many usable host IP addresses are available in a /27 IPv4 subnet?
              </p>
            </div>
            <div id="drill-options" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- Rendered via JS -->
            </div>
            <div id="drill-feedback" class="mt-4 p-3.5 rounded-lg bg-[var(--bg)] border border-[var(--line)] text-xs sm:text-sm text-[var(--ink-2)] hidden">
              <div id="feedback-text"></div>
            </div>
            <div class="mt-4 pt-3 border-t border-[var(--line)] flex items-center justify-between text-xs font-mono">
              <span class="text-[var(--muted)]">Interactive CCNA &amp; Network+ Simulator</span>
              <button type="button" id="drill-next-btn" class="text-[var(--accent)] hover:underline font-semibold cursor-pointer">Next Drill →</button>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16 flex justify-center">
        <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="pill-btn btn-fill" data-magnetic="0.25">
          <span data-magnetic-inner>More on GitHub</span>
        </a>
      </div>

      <!-- Floating preview (Dennis Snellenberg cursor follower) -->
      <div id="work-preview" class="hidden md:block fixed top-0 left-0 z-30 w-[420px] h-[300px] overflow-hidden pointer-events-none rounded-xl shadow-2xl" style="transform: scale(0)">
        <div id="work-preview-track" class="transition-transform duration-700 ease-[cubic-bezier(.76,0,.24,1)]">
          <div class="w-[420px] h-[300px] bg-[#d7dbe0] grid place-items-center p-6">
            <img src="/assets/projects/sonoma-dashboard.png" alt="Sonoma" class="w-full rounded shadow-xl" />
          </div>
          <div class="w-[420px] h-[300px] bg-[#1a2030] text-white flex flex-col justify-between p-7">
            <div class="text-[12px] font-mono text-white/50">github.com/gungortarik/certforge</div>
            <div>
              <div class="display text-[3.2rem]">CertForge</div>
              <div class="mt-2 text-sm text-white/70">Network+ · CCNA · Subnetting · VLANs</div>
            </div>
            <div class="text-xs font-mono text-indigo-400">Interactive Active Recall Drills</div>
          </div>
        </div>
      </div>
      <div id="work-cursor" class="hidden md:grid fixed top-0 left-0 z-30 w-20 h-20 rounded-full bg-[var(--accent)] text-white text-sm place-items-center pointer-events-none shadow-lg" style="transform: scale(0)">
        View
      </div>
    </section>

    <!-- RIGHT NOW -->
    <section id="now" class="bg-[var(--bg-soft)]">
      <div class="wrap py-24 sm:py-32">
        <div class="text-[13px] text-[var(--muted)] mb-10">Right now</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-12">
          {
            siteContent.rightNow.map((item) => (
              <div class="border-t border-[var(--line)] pt-6" data-reveal>
                <div class="text-[13px] text-[var(--muted)] capitalize">{item.label.toLowerCase()}</div>
                <h3 class="mt-3 text-[1.45rem] leading-tight tracking-[-0.02em]">{item.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-[var(--ink-2)]">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- LABS (Expandable Systems Workbench with 1-Click Copy) -->
    <section id="labs" class="wrap py-28 sm:py-40 scroll-mt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 sm:mb-20">
        <h2 class="lg:col-span-6 display text-[clamp(2.6rem,5.5vw,5.2rem)]" data-reveal>Lab work</h2>
        <p class="lg:col-span-5 lg:col-start-8 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-[var(--ink-2)] self-end" data-reveal>
          A lot of what I know comes from breaking and rebuilding things in Hyper-V and nested ESXi. These are the environments
          I've built so far — open one to see how it's wired.
        </p>
      </div>

      <div class="border-b border-[var(--line)]">
        {
          siteContent.resume.labs.map((lab, i) => (
            <details class="lab-row group border-t border-[var(--line)]">
              <summary class="flex items-center justify-between gap-6 py-7 sm:py-9 cursor-pointer">
                <div class="flex items-baseline gap-5 sm:gap-10 min-w-0">
                  <span class="text-[13px] text-[var(--muted)] tabular-nums w-6 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="text-[clamp(1.3rem,2.4vw,2.2rem)] tracking-[-0.025em] leading-tight group-hover:translate-x-2 transition-transform duration-500">
                    {lab.name}
                  </h3>
                </div>
                <div class="flex items-center gap-6 shrink-0">
                  <span class="hidden md:block text-[15px] text-[var(--muted)]">{lab.category}</span>
                  <span class="lab-plus text-2xl font-light leading-none">+</span>
                </div>
              </summary>
              <div class="pb-10 grid grid-cols-1 lg:grid-cols-12 gap-8 sm:pl-[4.25rem]">
                <div class="lg:col-span-4 space-y-4">
                  <p class="text-[15px] leading-relaxed text-[var(--ink-2)]">{lab.description}</p>
                  <p class="text-[13px] text-[var(--muted)]">{lab.protocols.join(' · ')}</p>
                </div>
                {labTopologies[lab.id] && (
                  <div class="lg:col-span-8 rounded-lg bg-[var(--bg-soft)] p-6 overflow-x-auto">
                    <pre class="font-mono text-[12.5px] leading-[1.75] text-[var(--ink)]">{labTopologies[lab.id].map}</pre>
                    <div class="mt-5 pt-4 border-t border-[var(--line)] font-mono text-[12px] text-[var(--ink-2)] flex items-center justify-between">
                      <div>
                        <span class="text-[var(--muted)]">$ </span>{labTopologies[lab.id].verify}
                      </div>
                      <button
                        type="button"
                        class="copy-cmd-btn text-xs font-mono text-[var(--accent)] hover:underline cursor-pointer"
                        data-cmd={labTopologies[lab.id].verify}
                      >
                        Copy Command
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- PATH -->
    <section id="path" class="wrap pb-28 sm:pb-40">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 sm:mb-20">
        <h2 class="lg:col-span-7 display text-[clamp(2.2rem,4.6vw,4.4rem)] !leading-[1.04]" data-reveal>
          Not a perfect roadmap. Just the path that actually happened.
        </h2>
      </div>

      <div class="border-b border-[var(--line)]">
        {
          path.map((p) => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 border-t border-[var(--line)] py-8 sm:py-10" data-reveal>
              <div class="md:col-span-2 text-[15px] text-[var(--muted)] tabular-nums">{p.years}</div>
              <div class="md:col-span-4">
                <h3 class="text-[1.5rem] tracking-[-0.02em] leading-tight">{p.title}</h3>
                <div class="mt-1 text-[15px] text-[var(--muted)]">{p.sub}</div>
              </div>
              <p class="md:col-span-5 md:col-start-8 text-[15px] leading-relaxed text-[var(--ink-2)]">{p.text}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 flex flex-wrap gap-4">
        <a href="/resume" class="pill-btn btn-fill" data-magnetic="0.25"><span data-magnetic-inner>Full resume</span></a>
        <a href="/resume/tarik-gungor-resume.pdf" download class="pill-btn btn-fill" data-magnetic="0.25">
          <span data-magnetic-inner>Download PDF</span>
        </a>
      </div>
    </section>

    <!-- WRITING -->
    <section id="writing" class="wrap pb-28 sm:pb-40 scroll-mt-8">
      <div class="text-[13px] text-[var(--muted)] mb-6">Writing</div>
      <a href="/notes/flexible-but-not-free" class="group block border-y border-[var(--line)] py-10 sm:py-14">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="max-w-3xl">
            <h3 class="display text-[clamp(2.2rem,5vw,4.6rem)] group-hover:translate-x-2 transition-transform duration-500">
              {note.title}
            </h3>
            <p class="mt-4 text-[clamp(1.05rem,1.4vw,1.25rem)] text-[var(--ink-2)]">{note.subtitle}</p>
          </div>
          <div class="text-[15px] md:text-right shrink-0">
            <div>{note.date}</div>
            <div class="text-[var(--muted)]">{note.readTime} · Read →</div>
          </div>
        </div>
      </a>
    </section>
  </main>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Name marquee — direction follows scroll direction
    const track = document.querySelector<HTMLElement>('[data-marquee]');
    if (track && !reduced) {
      const loop = gsap.to(track, { xPercent: -50, duration: 24, ease: 'none', repeat: -1 });
      ScrollTrigger.create({
        trigger: document.body,
        start: 0,
        end: 'max',
        onUpdate: (self) => {
          gsap.to(loop, { timeScale: self.direction === 1 ? 1 : -1, duration: 0.4, overwrite: true });
        },
      });
      // gentle parallax on the signature
      gsap.to('.hero-sig', {
        yPercent: -35,
        ease: 'none',
        scrollTrigger: { trigger: '.hero-sig', start: 'top top', end: 'bottom top', scrub: true },
      });
    }

    // Floating project preview following the cursor (Dennis Snellenberg)
    const preview = document.getElementById('work-preview');
    const previewTrack = document.getElementById('work-preview-track');
    const cursor = document.getElementById('work-cursor');
    if (preview && previewTrack && cursor && window.matchMedia('(pointer: fine)').matches) {
      gsap.set([preview, cursor], { xPercent: -50, yPercent: -50, scale: 0 });
      const px = gsap.quickTo(preview, 'x', { duration: 0.8, ease: 'power3' });
      const py = gsap.quickTo(preview, 'y', { duration: 0.8, ease: 'power3' });
      const cx = gsap.quickTo(cursor, 'x', { duration: 0.45, ease: 'power3' });
      const cy = gsap.quickTo(cursor, 'y', { duration: 0.45, ease: 'power3' });

      window.addEventListener('pointermove', (e) => {
        px(e.clientX);
        py(e.clientY);
        cx(e.clientX);
        cy(e.clientY);
      });

      const list = document.querySelector('.work-list');
      document.querySelectorAll<HTMLElement>('[data-work-index]').forEach((row) => {
        row.addEventListener('mouseenter', () => {
          const i = Number(row.dataset.workIndex || 0);
          previewTrack.style.transform = `translateY(-${i * 300}px)`;
        });
      });
      list?.addEventListener('mouseenter', () => {
        gsap.to([preview, cursor], { scale: 1, duration: 0.5, ease: 'power3.out' });
      });
      list?.addEventListener('mouseleave', () => {
        gsap.to([preview, cursor], { scale: 0, duration: 0.4, ease: 'power3.in' });
      });
    }

    // Copy command buttons in Lab work
    document.querySelectorAll<HTMLButtonElement>('.copy-cmd-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const cmd = btn.getAttribute('data-cmd') || '';
        try {
          await navigator.clipboard.writeText(cmd);
          const orig = btn.textContent;
          btn.textContent = '✓ Copied!';
          setTimeout(() => { btn.textContent = orig; }, 2000);
        } catch (err) {}
      });
    });

    // CertForge Interactive Drill Engine (Josh Comeau style)
    const drills = [
      {
        domain: 'CompTIA Network+ // Subnetting & CIDR',
        question: 'How many usable host IP addresses are available in a /27 IPv4 subnet?',
        options: [
          { text: '30 hosts', correct: true, explain: 'Correct! Formula: 2^(32 - 27) - 2 = 32 - 2 = 30 usable hosts. First is Network ID, last is Broadcast.' },
          { text: '32 hosts', correct: false, explain: '32 is total addresses in block (2^5), but 2 are reserved for Network & Broadcast.' },
          { text: '62 hosts', correct: false, explain: '62 usable hosts corresponds to a /26 block.' },
          { text: '14 hosts', correct: false, explain: '14 usable hosts corresponds to a /28 block.' }
        ]
      },
      {
        domain: 'Cisco CCNA // OSI Layer Switching',
        question: 'At which OSI layer does a standard network switch inspect frames and make forwarding decisions?',
        options: [
          { text: 'Layer 2 (Data Link)', correct: true, explain: 'Correct! Switches inspect Ethernet frame MAC headers and use the CAM table.' },
          { text: 'Layer 3 (Network)', correct: false, explain: 'Layer 3 routers inspect IP packets. Standard switches operate at Layer 2.' },
          { text: 'Layer 1 (Physical)', correct: false, explain: 'Layer 1 devices are hubs repeating electrical bits on the wire.' },
          { text: 'Layer 4 (Transport)', correct: false, explain: 'Layer 4 handles TCP/UDP ports and segment reassembly.' }
        ]
      },
      {
        domain: 'CompTIA Network+ // Protocol Resolution',
        question: 'Which protocol dynamically resolves an IPv4 address to a physical MAC address?',
        options: [
          { text: 'ARP (Address Resolution Protocol)', correct: true, explain: 'Correct! ARP broadcasts "Who has IP X? Tell my MAC" across the local broadcast domain.' },
          { text: 'DNS (Domain Name System)', correct: false, explain: 'DNS resolves domain names to IP addresses, not IPs to MACs.' },
          { text: 'DHCP (Dynamic Host Configuration)', correct: false, explain: 'DHCP issues IP lease configurations to network endpoints.' },
          { text: 'ICMP (Internet Control Message Protocol)', correct: false, explain: 'ICMP handles diagnostics and error reporting like ping.' }
        ]
      },
      {
        domain: 'Cisco CCNA // VLAN Trunking',
        question: 'Which industry standard protocol inserts a 4-byte tag into an Ethernet frame for VLAN trunking?',
        options: [
          { text: 'IEEE 802.1Q', correct: true, explain: 'Correct! IEEE 802.1Q inserts a 4-byte tag with a 12-bit VLAN ID directly into the frame header.' },
          { text: 'Cisco ISL', correct: false, explain: 'ISL was Cisco proprietary; 802.1Q is the universal open standard.' },
          { text: 'IEEE 802.1D', correct: false, explain: '802.1D defines Spanning Tree Protocol (STP).' },
          { text: 'IEEE 802.1X', correct: false, explain: '802.1X defines port-based access control and enterprise authentication.' }
        ]
      }
    ];

    let currentDrill = 0;
    let answered = false;

    function renderDrillUI() {
      const d = drills[currentDrill];
      answered = false;

      const domainEl = document.getElementById('drill-domain');
      const stepEl = document.getElementById('drill-step');
      const qEl = document.getElementById('drill-question');
      const optContainer = document.getElementById('drill-options');
      const fb = document.getElementById('drill-feedback');
      const fbText = document.getElementById('feedback-text');

      if (!domainEl || !stepEl || !qEl || !optContainer || !fb || !fbText) return;

      domainEl.textContent = d.domain;
      stepEl.textContent = `Drill ${currentDrill + 1} of ${drills.length}`;
      qEl.textContent = d.question;
      fb.classList.add('hidden');
      optContainer.innerHTML = '';

      d.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left p-3 rounded-lg border border-[var(--line)] bg-[var(--bg)] hover:bg-[var(--bg-soft)] text-sm text-[var(--ink)] font-medium transition-all duration-200 cursor-pointer';
        btn.textContent = opt.text;

        btn.addEventListener('click', () => {
          if (answered) return;
          answered = true;
          fb.classList.remove('hidden');

          if (opt.correct) {
            btn.className = 'w-full text-left p-3 rounded-lg border border-emerald-500 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 text-sm font-medium';
            fbText.innerHTML = `<strong>✓ Correct!</strong> ${opt.explain}`;
          } else {
            btn.className = 'w-full text-left p-3 rounded-lg border border-rose-400 bg-rose-50 dark:bg-rose-950/30 text-rose-800 dark:text-rose-300 text-sm font-medium';
            fbText.innerHTML = `<strong>✕ Incorrect.</strong> ${opt.explain}`;
          }
        });

        optContainer.appendChild(btn);
      });
    }

    document.getElementById('drill-next-btn')?.addEventListener('click', () => {
      currentDrill = (currentDrill + 1) % drills.length;
      renderDrillUI();
    });

    renderDrillUI();
  </script>
</BaseLayout>
