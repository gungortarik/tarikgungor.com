        <!-- Right 10 Cols: Full Resume Dispatch -->
        <div class="lg:col-span-10 p-6 sm:p-10 lg:p-14 bg-[var(--bg-panel)] flex flex-col lg:flex-row lg:items-end justify-between gap-8">
          <div class="max-w-[640px]">
            <span class="font-mono-spec text-[10.5px] uppercase tracking-[0.2em] text-[var(--signal)] block mb-2">
              TRADITIONAL DOCUMENTATION // 60+ ENDPOINTS SUPPORTED
            </span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-[-0.03em] text-[var(--text-primary)]">
              Experience, education, and technical work.
            </h2>
            <p class="text-[15px] text-[var(--text-secondary)] leading-[1.65] mt-3">
              A concise version of my professional background — covering BETA PREP, Bestof Floor
