---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/siteContent';

const labTopologies: Record<string, string> = {
  'LAB-01': `WAN / ISP Gateway (10.0.0.1)
  └── pfSense NAT & Firewall Appliance
        ├── VLAN 10 (192.168.10.0/24) ── Client Workstations
        └── VLAN 20 (192.168.20.0/24) ── Domain Controllers & Core Servers`,
  'LAB-02': `Forest Root: corp.local
  └── OU: Toronto Operations
        ├── OU: Workstations   (GPO: BitLocker, LAPS, Firewall Baseline)
        ├── OU: User Accounts  (Security Groups & Tiered RBAC)
        └── OU: Servers        (DC01 + DC02 Multi-Master Replication)`,
  'LAB-03': `Client Resolver ──> AD-Integrated DNS (192.168.20.10 / 192.168.20.11)
  ├── Authoritative Zone: corp.local (Secure Dynamic Updates + PTR)
  └── Conditional & Upstream Forwarders (1.1.1.1 / 9.9.9.9)`,
  'LAB-04': `Ubuntu Server (isc-dhcp-server)
  ├── Scope VLAN 10: 192.168.10.50 – 192.168.10.200 (24h lease)
  ├── Scope VLAN 20: 192.168.20.50 – 192.168.20.100 (Infrastructure)
  └── Static MAC Reservations for network printers & management interfaces`,
  'LAB-05': `SAN Target (TrueNAS Core · RAID 10 Striped Mirror)
  └── iSCSI Portal (TCP 3260 · Dedicated Storage Subnet)
        ├── Hyper-V Host 01 (MPIO Active/Optimized Path A)
        └── Hyper-V Host 02 (MPIO Active/Optimized Path B)`,
  'LAB-06': `Node 01 (File Server) <── Cluster Heartbeat ──> Node 02 (File Server)
  └── Shared VHD Set on iSCSI Cluster Storage + SMB Witness Quorum`,
  'LAB-07': `Physical Host
  └── Nested VMware ESXi Hypervisor
        ├── vSwitch0: Management Network (vmk0)
        └── vSwitch1: Segmented Lab Trunk (802.1Q VLAN Tagging)`,
};
---

<BaseLayout
  title={siteContent.meta.title}
  description={siteContent.meta.description}
  canonicalPath="/"
>
  <Header variant="home" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[960px] mx-auto px-6 sm:px-8 focus:outline-none"
  >
    <!-- ==========================================================
         INTRODUCTION
         ========================================================== -->
    <section class="pt-14 sm:pt-20 lg:pt-24 pb-16 sm:pb-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <!-- Left Column: Location & Context -->
        <div class="md:col-span-3 pt-1 text-xs text-[var(--text-muted)] space-y-1 font-mono-spec">
          <div class="text-[var(--text-primary)] font-medium">Toronto, Canada</div>
          <div>Systems &amp; Software</div>
        </div>

        <!-- Right Column: Headline & Bio -->
        <div class="md:col-span-9 space-y-6">
          <h1 class="font-display font-semibold text-3xl sm:text-4xl lg:text-[42px] tracking-[-0.025em] text-[var(--text-primary)] leading-[1.16]">
            Building systems. Learning continuously. <span class="text-[var(--signal)]">Living</span> intentionally.
          </h1>

          <div class="space-y-4 text-base sm:text-[17px] text-[var(--text-secondary)] leading-[1.75] max-w-2xl">
            <p>
              I'm Tarik Gungor. I study Computer Systems Technology at George Brown College in Toronto and work in IT support across hybrid Windows and network environments.
            </p>
            <p>
              Outside of classes and day-to-day support, I build practical tools around problems I actually have, configure virtualized infrastructure labs, and document the lessons along the way.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13.5px] font-medium">
            <a
              href="/resume"
              class="text-[var(--text-primary)] hover:text-[var(--signal)] transition-colors inline-flex items-center gap-1"
            >
              <span>View Resume</span>
              <span>→</span>
            </a>
            <a
              href={siteContent.meta.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              GitHub ↗
            </a>
            <a
              href={siteContent.meta.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              LinkedIn ↗
            </a>
            <a
              href={`mailto:${siteContent.meta.email}`}
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors font-mono-spec text-xs"
            >
              {siteContent.meta.email}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         RIGHT NOW
         ========================================================== -->
    <section id="right-now" class="py-14 sm:py-18 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3">
          <h2 class="text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
            Right Now
          </h2>
        </div>

        <div class="md:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
          {
            siteContent.rightNow.map((item) => (
              <div class="space-y-1.5">
                <div class="text-[11px] font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
                  {item.label}
                </div>
                <h3 class="font-display text-lg font-semibold text-[var(--text-primary)]">
                  {item.title}
                </h3>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         PROJECTS (SONOMA & CERTFORGE)
         ========================================================== -->
    <section id="projects" class="py-14 sm:py-18 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3">
          <h2 class="text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
            Projects
          </h2>
          <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
            Software built around personal workflows and study.
          </p>
        </div>

        <div class="md:col-span-9 space-y-14">
          <!-- Project 1: Sonoma -->
          <article class="space-y-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-baseline gap-3">
                <h3 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-primary)]">
                  Sonoma
                </h3>
                <span class="text-xs font-mono-spec text-[var(--text-muted)]">
                  Private · In Progress
                </span>
              </div>
              <span class="text-xs font-mono-spec text-[var(--text-muted)]">
                Next.js · TypeScript · Tailwind CSS
              </span>
            </div>

            <p class="text-[15px] text-[var(--text-secondary)] leading-relaxed max-w-2xl">
              A private expense and document management tool I built for personal use. Designed around fast receipt indexing, recurring cashflow tracking, and structured monthly financial visibility without exposing personal records to third-party aggregators.
            </p>

            <button
              type="button"
              data-lightbox
              data-lightbox-src="/assets/projects/sonoma-dashboard.png"
              data-lightbox-alt="Sonoma — Private expense and document management dashboard"
              class="group block w-full text-left rounded-lg border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] bg-[var(--bg-panel)] overflow-hidden transition-colors cursor-pointer"
            >
              <img
                src="/assets/projects/sonoma-dashboard.png"
                alt="Sonoma private expense and document management dashboard"
                width="1440"
                height="900"
                loading="lazy"
                class="w-full h-auto object-cover"
              />
            </button>
          </article>

          <hr class="border-[var(--rule-hairline)]" />

          <!-- Project 2: CertForge -->
          <article class="space-y-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-baseline gap-3">
                <h3 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-primary)]">
                  CertForge
                </h3>
                <span class="text-xs font-mono-spec text-[var(--text-muted)]">
                  Open Source · Study Platform
                </span>
              </div>
              <a
                href="https://github.com/gungortarik/certforge"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono-spec text-[var(--text-primary)] hover:text-[var(--signal)] transition-colors"
              >
                github.com/gungortarik/certforge ↗
              </a>
            </div>

            <p class="text-[15px] text-[var(--text-secondary)] leading-relaxed max-w-2xl">
              An IT certification study platform I built around CompTIA Network+ and Cisco CCNA preparation. Built to turn passive textbook reading into active recall across OSI layers, subnetting math, routing protocols, and hands-on troubleshooting scenarios.
            </p>

            <div class="pt-1 flex flex-wrap gap-x-6 gap-y-2 text-xs font-mono-spec text-[var(--text-muted)]">
              <span>CompTIA Network+</span>
              <span>·</span>
              <span>Cisco CCNA Routing &amp; Switching</span>
              <span>·</span>
              <span>Next.js &amp; TypeScript</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         SYSTEMS & INFRASTRUCTURE LABS
         ========================================================== -->
    <section id="labs-showcase" class="py-14 sm:py-18 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3">
          <h2 class="text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
            Systems Labs
          </h2>
          <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
            Virtualized network &amp; server topologies.
          </p>
        </div>

        <div class="md:col-span-9 space-y-6">
          <p class="text-[15px] text-[var(--text-secondary)] leading-relaxed max-w-2xl">
            Alongside software, a large part of my hands-on work happens in virtualized lab environments (Hyper-V and nested VMware ESXi) where I configure, test, and troubleshoot enterprise infrastructure.
          </p>

          <div class="divide-y divide-[var(--rule-hairline)] border-y border-[var(--rule-hairline)]">
            {
              siteContent.resume.labs.map((lab, idx) => (
                <details class="group py-4" open={idx === 0}>
                  <summary class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 cursor-pointer list-none select-none">
                    <div class="flex items-baseline gap-2.5">
                      <span class="text-xs font-mono-spec text-[var(--text-muted)] group-open:text-[var(--signal)] transition-colors">
                        <span class="group-open:hidden">+</span>
                        <span class="hidden group-open:inline">−</span>
                      </span>
                      <h3 class="font-display text-base font-medium text-[var(--text-primary)] group-hover:text-[var(--signal)] transition-colors">
                        {lab.name}
                      </h3>
                    </div>
                    <span class="text-xs font-mono-spec text-[var(--text-muted)] pl-4 sm:pl-0">
                      {lab.protocols.join(' · ')}
                    </span>
                  </summary>

                  <div class="mt-3 pl-4 space-y-3">
                    <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
                      {lab.description}
                    </p>
                    {labTopologies[lab.id] && (
                      <pre class="p-3.5 rounded bg-[var(--bg-panel)] border border-[var(--rule-hairline)] font-mono-spec text-[11.5px] leading-relaxed text-[var(--text-secondary)] overflow-x-auto">{labTopologies[lab.id]}</pre>
                    )}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         WRITING / NOTES
         ========================================================== -->
    <section id="notes" class="py-14 sm:py-18 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3">
          <h2 class="text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
            Writing
          </h2>
        </div>

        <div class="md:col-span-9 space-y-6">
          {
            siteContent.notes.map((note) => (
              <article class="group">
                <a href="/notes/flexible-but-not-free" class="block space-y-2">
                  <div class="flex items-center gap-2 text-xs font-mono-spec text-[var(--text-muted)]">
                    <span>{note.date}</span>
                    <span>·</span>
                    <span>{note.readTime}</span>
                  </div>
                  <h3 class="font-display text-xl sm:text-2xl font-semibold text-[var(--text-primary)] group-hover:text-[var(--signal)] transition-colors">
                    {note.title}
                  </h3>
                  <p class="text-sm sm:text-[15px] text-[var(--text-primary)] font-medium">
                    {note.subtitle}
                  </p>
                  <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-2xl pt-1">
                    {note.summary}
                  </p>
                  <div class="pt-2 text-xs font-medium text-[var(--text-primary)] group-hover:text-[var(--signal)] inline-flex items-center gap-1 transition-colors">
                    <span>Read note</span>
                    <span>→</span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         PATH SO FAR
         ========================================================== -->
    <section id="path" class="py-14 sm:py-18 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3">
          <h2 class="text-xs font-mono-spec uppercase tracking-wider text-[var(--text-muted)]">
            Path So Far
          </h2>
          <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
            Not a perfect roadmap. Just the path that actually happened.
          </p>
        </div>

        <div class="md:col-span-9 space-y-10">
          <div class="divide-y divide-[var(--rule-hairline)]">
            <div class=" pb-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline">
              <div class="sm:col-span-3 text-xs font-mono-spec text-[var(--text-muted)]">
                2026 — Present
              </div>
              <div class="sm:col-span-9 space-y-1">
                <h3 class="font-display text-base font-semibold text-[var(--text-primary)]">
                  George Brown College
                </h3>
                <div class="text-xs text-[var(--text-muted)]">
                  Computer Systems Technology (Advanced Diploma) · Toronto, ON
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
                  Studying networking, routing and switching, Linux systems, Windows Server infrastructure, and virtualization while building Sonoma and CertForge.
                </p>
              </div>
            </div>

            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline">
              <div class="sm:col-span-3 text-xs font-mono-spec text-[var(--text-muted)]">
                2024 — Present
              </div>
              <div class="sm:col-span-9 space-y-1">
                <h3 class="font-display text-base font-semibold text-[var(--text-primary)]">
                  BETA PREP — IT Specialist
                </h3>
                <div class="text-xs text-[var(--text-muted)]">
                  Toronto, ON · Hybrid Environment (38 Endpoints)
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
                  Supporting and maintaining Windows 10/11 devices, Microsoft 365 accounts, staff device deployments, and day-to-day network connectivity (DNS, DHCP, IP configuration).
                </p>
              </div>
            </div>

            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline">
              <div class="sm:col-span-3 text-xs font-mono-spec text-[var(--text-muted)]">
                2023 — Present
              </div>
              <div class="sm:col-span-9 space-y-1">
                <h3 class="font-display text-base font-semibold text-[var(--text-primary)]">
                  Bestof Floor LTD — IT Support Specialist
                </h3>
                <div class="text-xs text-[var(--text-muted)]">
                  Toronto, ON · On-Prem &amp; Active Directory (23 Devices)
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
                  Providing hardware/software diagnostics, Active Directory user account management, and internal network support.
                </p>
              </div>
            </div>

            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline">
              <div class="sm:col-span-3 text-xs font-mono-spec text-[var(--text-muted)]">
                2023
              </div>
              <div class="sm:col-span-9 space-y-1">
                <h3 class="font-display text-base font-semibold text-[var(--text-primary)]">
                  Payment Source — IT Analyst (Internship)
                </h3>
                <div class="text-xs text-[var(--text-muted)]">
                  Toronto, ON · Endpoint Management (50+ Endpoints)
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
                  Worked on endpoint configuration with ManageEngine Endpoint Central, mobile device management (MDM) rollouts, and policy implementation.
                </p>
              </div>
            </div>

            <div class="pt-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline">
              <div class="sm:col-span-3 text-xs font-mono-spec text-[var(--text-muted)]">
                2022 — 2023
              </div>
              <div class="sm:col-span-9 space-y-1">
                <h3 class="font-display text-base font-semibold text-[var(--text-primary)]">
                  BCIT — Technology Support Professional
                </h3>
                <div class="text-xs text-[var(--text-muted)]">
                  British Columbia Institute of Technology
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
                  Completed hands-on foundational training across Windows infrastructure, networking, virtualization, Linux, and enterprise IT support.
                </p>
              </div>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4 text-xs font-mono-spec">
            <a
              href="/resume"
              class="px-4 py-2 rounded bg-[var(--text-primary)] text-[var(--bg-surface)] font-medium hover:opacity-85 transition-opacity"
            >
              Full Resume →
            </a>
            <a
              href="/resume/tarik-gungor-resume.pdf"
              download="tarik-gungor-resume.pdf"
              class="px-4 py-2 rounded border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Download PDF ↓
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
