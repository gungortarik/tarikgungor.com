---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/siteContent';
---

<BaseLayout
  title={siteContent.meta.title}
  description={siteContent.meta.description}
  canonicalPath="/"
>
  <Header variant="home" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[1240px] mx-auto px-6 sm:px-10 focus:outline-none"
  >
    <!-- ==========================================================
         HERO // JOSH COMEAU & BRITTANY CHIANG INSPIRED STUDIO INTRO
         ========================================================== -->
    <section class="pt-12 sm:pt-20 lg:pt-24 pb-16 sm:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left 7 Cols: Greeting, Expressive Headline, Bio & Magnetic Actions -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[var(--bg-panel)] border border-[var(--rule-hairline)] text-xs font-mono-spec text-[var(--text-secondary)] wave-on-hover cursor-default">
            <span class="wave-emoji text-sm">👋</span>
            <span>Hi, I'm <strong class="text-[var(--text-primary)]">Tarik Gungor</strong></span>
            <span class="text-[var(--text-muted)]">·</span>
            <span class="text-[var(--signal)]">Toronto, Canada</span>
          </div>

          <h1 class="font-display font-bold text-4xl sm:text-6xl lg:text-[64px] tracking-[-0.03em] text-[var(--text-primary)] leading-[1.06]">
            <span class="clip-line">
              <span data-hero-line class="clip-line-inner">
                Building <span class="gradient-headline-accent">systems.</span>
              </span>
            </span>
            <span class="clip-line">
              <span data-hero-line class="clip-line-inner text-[var(--text-secondary)]">
                Learning continuously.
              </span>
            </span>
            <span class="clip-line">
              <span data-hero-line class="clip-line-inner">
                <span class="wavy-underline text-[var(--text-primary)]">Living</span> intentionally.
              </span>
            </span>
          </h1>

          <p data-hero-spec class="text-base sm:text-lg text-[var(--text-secondary)] leading-[1.75] max-w-2xl">
            {siteContent.hero.bio}
          </p>

          <!-- Magnetic CTA Buttons -->
          <div data-hero-spec class="pt-2 flex flex-wrap items-center gap-3.5 text-xs sm:text-[13px] font-medium">
            <a
              href="#projects"
              data-magnetic
              class="px-5 py-3 rounded-xl bg-[var(--signal)] text-slate-950 font-semibold shadow-lg shadow-sky-500/15 hover:opacity-95 transition-all inline-flex items-center gap-2"
            >
              <span>Explore Projects</span>
              <span>↓</span>
            </a>
            <a
              href="#labs-showcase"
              data-magnetic
              class="px-5 py-3 rounded-xl bg-[var(--bg-panel)] border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-primary)] transition-all inline-flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-[var(--signal-emerald)]"></span>
              <span>Interactive Lab Topology</span>
            </a>
            <a
              href="/resume"
              data-magnetic
              class="px-4 py-3 rounded-xl text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1.5"
            >
              <span>Resume</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Right 5 Cols: Interactive ~/now Workstation Card -->
        <div data-hero-spec class="lg:col-span-5">
          <div class="tactile-card p-6 sm:p-7 space-y-5 relative overflow-hidden">
            <!-- Top Window Bar -->
            <div class="flex items-center justify-between pb-4 border-b border-[var(--rule-hairline)]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
                <span class="ml-2 font-mono-spec text-xs font-semibold text-[var(--text-primary)]">
                  ~/tarik/now
                </span>
              </div>
              <div class="flex items-center gap-2 font-mono-spec text-[11px] text-[var(--text-muted)]">
                <span class="w-2 h-2 rounded-full bg-[var(--signal-emerald)] animate-pulse"></span>
                <span data-toronto-clock>--:--:-- EDT</span>
              </div>
            </div>

            <!-- Live State Rows -->
            <div class="space-y-3.5 font-mono-spec text-xs">
              <div class="flex items-start justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-surface)]/60 border border-[var(--rule-hairline)]">
                <span class="text-[var(--text-muted)]">building</span>
                <span class="text-[var(--text-primary)] font-medium text-right">Sonoma · CertForge</span>
              </div>
              <div class="flex items-start justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-surface)]/60 border border-[var(--rule-hairline)]">
                <span class="text-[var(--text-muted)]">studying</span>
                <span class="text-[var(--text-primary)] font-medium text-right">Computer Systems Tech @ GBC</span>
              </div>
              <div class="flex items-start justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-surface)]/60 border border-[var(--rule-hairline)]">
                <span class="text-[var(--text-muted)]">supporting</span>
                <span class="text-[var(--signal-emerald)] font-medium text-right">60+ Hybrid Endpoints</span>
              </div>
              <div class="flex items-start justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-surface)]/60 border border-[var(--rule-hairline)]">
                <span class="text-[var(--text-muted)]">focus</span>
                <span class="text-[var(--signal)] font-medium text-right">Network+ · CCNA · Linux</span>
              </div>
            </div>

            <!-- Interactive Micro-Playground: Ping Test -->
            <div class="pt-3 border-t border-[var(--rule-hairline)] flex items-center justify-between gap-3 text-xs font-mono-spec">
              <div id="hero-ping-output" class="text-[11px] text-[var(--text-muted)] truncate">
                Host: toronto-lab.local (Ready)
              </div>
              <button
                type="button"
                id="hero-ping-btn"
                class="shrink-0 px-3 py-1.5 rounded-lg bg-[var(--signal-soft)] text-[var(--signal)] hover:bg-[var(--signal)] hover:text-slate-950 font-semibold transition-all cursor-pointer active:scale-95"
              >
                ⚡ Ping Host
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         SECTION 01 // RIGHT NOW (4 TACTILE SPRING CARDS)
         ========================================================== -->
    <section id="right-now" class="py-16 sm:py-22 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="font-mono-spec text-xs font-semibold uppercase tracking-wider text-[var(--signal)]">
            Current Focus
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mt-1">
            What I'm working on right now
          </h2>
        </div>
        <p class="text-xs font-mono-spec text-[var(--text-muted)]">
          Toronto, ON · 2026
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger-group>
        {
          siteContent.rightNow.map((item) => (
            <div data-stagger-item class="tactile-card tactile-card-interactive p-6 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono-spec mb-4">
                  <span class="px-2.5 py-0.5 rounded-md bg-[var(--signal-soft)] text-[var(--signal)] font-semibold">
                    {item.label}
                  </span>
                  <span class="text-[var(--text-muted)] text-[11px]">{item.metric}</span>
                </div>
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)]">
                  {item.title}
                </h3>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed mt-2.5">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ==========================================================
         SECTION 02 // FEATURED PROJECTS (SONOMA & CERTFORGE)
         ========================================================== -->
    <section id="projects" class="py-16 sm:py-24 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <span class="font-mono-spec text-xs font-semibold uppercase tracking-wider text-[var(--signal)]">
            Software &amp; Tooling
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-[var(--text-primary)] mt-1">
            Selected Projects
          </h2>
        </div>
        <p class="text-sm text-[var(--text-secondary)] max-w-md">
          Practical web applications built around personal financial privacy and active IT certification study.
        </p>
      </div>

      <div class="space-y-16">
        <!-- Project 01: Sonoma -->
        <article class="tactile-card p-6 sm:p-8 lg:p-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <!-- Left 7 Cols: Interactive Preview & Architecture Switcher -->
            <div class="lg:col-span-7 space-y-3">
              <div class="flex items-center justify-between text-xs font-mono-spec">
                <div class="inline-flex p-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)]" role="tablist">
                  <button
                    type="button"
                    data-sonoma-tab="ui"
                    role="tab"
                    aria-selected="true"
                    class="px-3 py-1 rounded-md bg-[var(--signal)] text-slate-950 font-semibold transition-all cursor-pointer"
                  >
                    Dashboard UI
                  </button>
                  <button
                    type="button"
                    data-sonoma-tab="arch"
                    role="tab"
                    aria-selected="false"
                    class="px-3 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer"
                  >
                    Privacy Architecture
                  </button>
                </div>

                <button
                  type="button"
                  data-lightbox
                  data-lightbox-src="/assets/projects/sonoma-dashboard.png"
                  data-lightbox-alt="Sonoma — Private Expense and Document Vault"
                  class="px-2.5 py-1 rounded-md bg-[var(--bg-surface)] border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                >
                  ⤢ Expand Image
                </button>
              </div>

              <!-- UI Panel -->
              <div id="sonoma-panel-ui" class="rounded-xl border border-[var(--rule-hairline)] bg-[var(--bg-surface)] overflow-hidden shadow-lg">
                <img
                  src="/assets/projects/sonoma-dashboard.png"
                  alt="Sonoma private expense and document management dashboard"
                  width="1440"
                  height="900"
                  loading="lazy"
                  class="w-full h-auto object-cover hover:scale-[1.01] transition-transform duration-500"
                />
              </div>

              <!-- Privacy Architecture Panel -->
              <div id="sonoma-panel-arch" class="hidden rounded-xl border border-[var(--rule-hairline)] bg-[var(--bg-surface)] p-6 font-mono-spec text-xs space-y-4">
                <div class="flex items-center justify-between text-[var(--signal)] font-semibold">
                  <span>LOCAL-FIRST DATA ISOLATION</span>
                  <span class="text-[var(--signal-emerald)]">● ZERO TELEMETRY</span>
                </div>
                <p class="text-[var(--text-secondary)] font-sans text-sm leading-relaxed">
                  Sonoma keeps personal financial records, uploaded receipts, and recurring cashflow schedules strictly isolated from third-party cloud aggregators.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                  <div class="p-3 rounded-lg bg-[var(--bg-panel)] border border-[var(--rule-hairline)]">
                    <div class="text-[var(--text-primary)] font-semibold">1. Receipt Vault</div>
                    <div class="text-[11px] text-[var(--text-muted)] mt-1">Instant metadata indexing &amp; local document staging</div>
                  </div>
                  <div class="p-3 rounded-lg bg-[var(--bg-panel)] border border-[var(--rule-hairline)]">
                    <div class="text-[var(--text-primary)] font-semibold">2. SQLite Ledger</div>
                    <div class="text-[11px] text-[var(--text-muted)] mt-1">Deterministic monthly cashflow &amp; category rules</div>
                  </div>
                  <div class="p-3 rounded-lg bg-[var(--bg-panel)] border border-[var(--rule-hairline)]">
                    <div class="text-[var(--text-primary)] font-semibold">3. Zero Tracking</div>
                    <div class="text-[11px] text-[var(--text-muted)] mt-1">No external bank scraping or ad-analytics scripts</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right 5 Cols: Project Details -->
            <div class="lg:col-span-5 space-y-5">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--signal-soft)] text-[var(--signal)] text-xs font-mono-spec font-semibold">
                <span>Private Product · Active Development</span>
              </div>

              <h3 class="font-display text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
                Sonoma
              </h3>

              <p class="text-[15.5px] text-[var(--text-secondary)] leading-relaxed">
                A private expense and document management tool I built for my own daily use. Designed around zero-friction bookkeeping, receipt indexing, and structured monthly financial visibility.
              </p>

              <ul class="space-y-2 text-sm text-[var(--text-secondary)] pt-2">
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal)] mt-0.5">✦</span>
                  <span>Private expense ledger with recurring cashflow tracking</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal)] mt-0.5">✦</span>
                  <span>Document vault with fast metadata tagging and receipt search</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal)] mt-0.5">✦</span>
                  <span>High-contrast interface tailored for daily financial clarity</span>
                </li>
              </ul>

              <div class="pt-4 border-t border-[var(--rule-hairline)] flex flex-wrap gap-2 font-mono-spec text-xs">
                <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">Next.js</span>
                <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">TypeScript</span>
                <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">Tailwind CSS</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Project 02: CertForge -->
        <article class="tactile-card p-6 sm:p-8 lg:p-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <!-- Left 7 Cols: Visual & Interactive Routing Drill -->
            <div class="lg:col-span-7 space-y-3">
              <div class="flex items-center justify-between text-xs font-mono-spec">
                <div class="inline-flex p-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)]" role="tablist">
                  <button
                    type="button"
                    data-certforge-mode="visual"
                    role="tab"
                    aria-selected="true"
                    class="px-3 py-1 rounded-md bg-[var(--signal)] text-slate-950 font-semibold transition-all cursor-pointer"
                  >
                    Study Interface
                  </button>
                  <button
                    type="button"
                    data-certforge-mode="drills"
                    role="tab"
                    aria-selected="false"
                    class="px-3 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer"
                  >
                    Interactive CLI Drill
                  </button>
                </div>

                <a
                  href="https://github.com/gungortarik/certforge"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2.5 py-1 rounded-md bg-[var(--bg-surface)] border border-[var(--rule-hairline)] hover:border-[var(--signal)] text-[var(--signal)] transition-colors"
                >
                  GitHub Repo ↗
                </a>
              </div>

              <!-- Visual Interface Panel -->
              <div id="certforge-panel-visual" class="rounded-xl border border-[var(--rule-hairline)] bg-[var(--bg-surface)] overflow-hidden shadow-lg">
                <img
                  src="/assets/projects/certforge-platform.svg"
                  alt="CertForge IT Certification Study Platform Interface"
                  width="1440"
                  height="900"
                  loading="lazy"
                  class="w-full h-auto object-cover"
                />
              </div>

              <!-- Interactive Cisco IOS Simulator -->
              <div id="certforge-panel-drills" class="hidden rounded-xl border border-[var(--rule-hairline)] bg-slate-950 text-slate-100 p-5 font-mono-spec text-xs space-y-4">
                <div class="flex items-center justify-between pb-2.5 border-b border-slate-800 text-[11px]">
                  <span class="text-sky-400 font-semibold">CISCO IOS DRILL ENGINE // R1-CORE</span>
                  <span class="text-emerald-400">● CCNA / NET+ LAB</span>
                </div>

                <div class="flex flex-wrap items-center gap-2 text-[11px]">
                  <span class="text-slate-400">Try command:</span>
                  <button type="button" data-cisco-cmd="route" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-200 transition-colors cursor-pointer">
                    show ip route
                  </button>
                  <button type="button" data-cisco-cmd="vlan" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-200 transition-colors cursor-pointer">
                    show vlan brief
                  </button>
                  <button type="button" data-cisco-cmd="ping" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-200 transition-colors cursor-pointer">
                    ping 192.168.10.1
                  </button>
                  <button type="button" data-cisco-cmd="trace" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-200 transition-colors cursor-pointer">
                    traceroute 8.8.8.8
                  </button>
                </div>

                <div
                  id="cisco-terminal-screen"
                  class="p-4 bg-slate-900/90 border border-slate-800 rounded-lg min-h-[165px] max-h-[210px] overflow-y-auto space-y-2 text-[11px] leading-relaxed select-text"
                >
                  <div class="text-slate-400">Cisco IOS Software, C2900 (C2900-UNIVERSALK9-M), Version 15.7(4)M</div>
                  <div class="text-emerald-400">R1-CORE# interface Gi0/0/0.10 UP · 802.1Q VLAN 10 active</div>
                  <div class="text-slate-300">Select a diagnostic command above to inspect live routing output.</div>
                </div>
              </div>
            </div>

            <!-- Right 5 Cols: CertForge Details -->
            <div class="lg:col-span-5 space-y-5">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-[var(--signal-emerald)] text-xs font-mono-spec font-semibold">
                <span>Open Source · Study Platform</span>
              </div>

              <h3 class="font-display text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
                CertForge
              </h3>

              <p class="text-[15.5px] text-[var(--text-secondary)] leading-relaxed">
                An IT certification study platform I built around CompTIA Network+ and Cisco CCNA preparation — turning passive textbook reading into active recall across OSI layers, subnetting math, and routing protocols.
              </p>

              <ul class="space-y-2 text-sm text-[var(--text-secondary)] pt-2">
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal-emerald)] mt-0.5">✦</span>
                  <span>CompTIA Network+ objective mapping &amp; timed active drills</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal-emerald)] mt-0.5">✦</span>
                  <span>Cisco CCNA routing, switching &amp; VLAN topology simulations</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--signal-emerald)] mt-0.5">✦</span>
                  <span>Subnetting calculator and packet inspection drill engine</span>
                </li>
              </ul>

              <div class="pt-4 border-t border-[var(--rule-hairline)] flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-2 font-mono-spec text-xs">
                  <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">Next.js</span>
                  <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">TypeScript</span>
                  <span class="px-3 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--rule-hairline)] text-[var(--text-secondary)]">Tailwind</span>
                </div>

                <a
                  href="https://github.com/gungortarik/certforge"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono-spec font-semibold text-[var(--signal)] hover:underline inline-flex items-center gap-1"
                >
                  <span>View Source</span>
                  <span>↗</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ==========================================================
         SECTION 03 // INTERACTIVE NETWORK & SYSTEMS LAB PLAYGROUND
         ========================================================== -->
    <section id="labs-showcase" class="py-16 sm:py-24 border-t border-[var(--rule-hairline)] scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="font-mono-spec text-xs font-semibold uppercase tracking-wider text-[var(--signal)]">
            Hands-On Infrastructure
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-[var(--text-primary)] mt-1">
            Systems &amp; Network Lab Playground
          </h2>
        </div>
        <p class="text-sm text-[var(--text-secondary)] max-w-md">
          Select any of the 7 virtualized enterprise topologies below to inspect its live architecture, subnet layout, and verification commands.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left 5 Cols: Tactile Lab Selector -->
        <div class="lg:col-span-5 space-y-2.5" role="tablist">
          {
            siteContent.resume.labs.map((lab, idx) => (
              <button
                type="button"
                data-lab-node={lab.id}
                data-lab-name={lab.name}
                data-lab-desc={lab.description}
                data-lab-proto={lab.protocols.join(' · ')}
                class={`w-full p-4 rounded-xl border text-left transition-all cursor-pointer ${
                  idx === 0
                    ? 'border-[var(--signal)] bg-[var(--signal-soft)] shadow-sm'
                    : 'border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] bg-[var(--bg-panel)]/60'
                }`}
              >
                <div class="flex items-center justify-between text-xs font-mono-spec">
                  <span class="text-[var(--signal)] font-bold">{lab.id}</span>
                  <span class="text-[11px] text-[var(--text-muted)]">{lab.category}</span>
                </div>
                <div class="font-display font-semibold text-base text-[var(--text-primary)] mt-1">
                  {lab.name}
                </div>
              </button>
            ))
          }
        </div>

        <!-- Right 7 Cols: Interactive SVG Topology Canvas + Specs -->
        <div class="lg:col-span-7 tactile-card p-6 sm:p-8 space-y-6">
