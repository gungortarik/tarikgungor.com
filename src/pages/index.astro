---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/siteContent';
---

<BaseLayout
  title={siteContent.meta.title}
  description={siteContent.meta.description}
  canonicalPath="/"
>
  <Header variant="home" />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full max-w-[1600px] mx-auto border-x border-[var(--rule-hairline)] focus:outline-none"
  >
    <!-- ==========================================================
         SECTION 01 // HERO & RIGHT NOW SPECIFICATION LEDGER
         ========================================================== -->
    <section
      data-section-title="SEC.01 // SYSTEMS & DIRECTION"
      class="border-b border-[var(--rule-hairline)]"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Left Sticky Architectural Gutter (Cols 1-2) -->
        <div
          class="lg:col-span-2 p-5 sm:p-6 lg:p-8 border-b lg:border-b-0 lg:border-r border-[var(--rule-hairline)] font-mono-spec text-[11px] text-[var(--text-muted)]"
        >
          <div class="lg:sticky lg:top-[74px] flex lg:flex-col justify-between gap-8">
            <div>
              <span class="text-[var(--signal)] font-semibold block">INDEX // 01</span>
              <span class="uppercase tracking-widest mt-1 block text-[var(--text-primary)] font-medium">
                OVERVIEW
              </span>
              <span class="hidden lg:block text-[10px] text-[var(--text-muted)] mt-3 leading-relaxed">
                Systems engineering, networking, and software built in Toronto.
              </span>
            </div>

            <div class="hidden lg:block pt-6 border-t border-[var(--rule-hairline)] space-y-1.5 text-[10px]">
              <div class="text-[var(--text-primary)] font-semibold">TORONTO, CANADA</div>
              <div>{siteContent.meta.coordinates.lat}</div>
              <div>{siteContent.meta.coordinates.lng}</div>
              <div class="pt-2 text-[var(--signal)] font-medium">A LIFE IN PROGRESS</div>
            </div>
          </div>
        </div>

        <!-- Main Poster & Bio Column (Cols 3-12) -->
        <div class="lg:col-span-10 flex flex-col justify-between">
          <!-- Upper Display Statement -->
          <div class="p-6 sm:p-10 lg:p-14 xl:p-16 border-b border-[var(--rule-hairline)]">
            <div
              data-hero-spec
              class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-[var(--rule-hairline)] font-mono-spec text-[11px] text-[var(--text-muted)]"
            >
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[var(--signal)] inline-block"></span>
                <span>SPECIFICATION // PERSONAL PLATFORM &amp; LAB ARCHIVE</span>
              </span>
              <span>GEORGE BROWN COLLEGE (CST) · 60+ ENDPOINTS SUPPORTED</span>
            </div>

            <h1
              class="font-display font-bold text-[42px] sm:text-[64px] lg:text-[78px] xl:text-[92px] leading-[0.93] tracking-[-0.045em] uppercase text-[var(--text-primary)]"
            >
              <span class="clip-line">
                <span data-hero-line class="clip-line-inner">Building systems.</span>
              </span>
              <span class="clip-line">
                <span data-hero-line class="clip-line-inner text-[var(--text-secondary)]">
                  Learning continuously.
                </span>
              </span>
              <span class="clip-line">
                <span data-hero-line class="clip-line-inner">
                  <span class="text-[var(--signal)]">Living</span> intentionally.
                </span>
              </span>
            </h1>

            <!-- Bio + ~/now Tabular & Coordinate Blueprint Split -->
            <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 xl:gap-12 pt-10 sm:pt-14 items-stretch">
              <div data-hero-spec class="xl:col-span-7 flex flex-col justify-between gap-8">
                <p class="text-[16px] sm:text-[18.5px] text-[var(--text-secondary)] leading-[1.68] max-w-[650px] font-normal">
                  {siteContent.hero.bio}
                </p>

                <!-- Key Metrics Bar -->
                <div class="grid grid-cols-3 border border-[var(--rule-hairline)] bg-[var(--bg-panel)]/50 divide-x divide-[var(--rule-hairline)] font-mono-spec">
                  <div class="p-3.5 sm:p-4">
                    <span class="text-[9.5px] text-[var(--text-muted)] block uppercase">
                      ENDPOINT FLEET
                    </span>
                    <span class="font-display font-bold text-xl sm:text-2xl text-[var(--text-primary)] mt-0.5 block">
                      60+ HOSTS
                    </span>
                  </div>
                  <div class="p-3.5 sm:p-4">
                    <span class="text-[9.5px] text-[var(--text-muted)] block uppercase">
                      INFRA LABS
                    </span>
                    <span class="font-display font-bold text-xl sm:text-2xl text-[var(--text-primary)] mt-0.5 block">
                      07 TOPOLOGIES
                    </span>
                  </div>
                  <div class="p-3.5 sm:p-4">
                    <span class="text-[9.5px] text-[var(--text-muted)] block uppercase">
                      SOFTWARE
                    </span>
                    <span class="font-display font-bold text-xl sm:text-2xl text-[var(--signal)] mt-0.5 block">
                      02 PRODUCTS
                    </span>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-0 border border-[var(--rule-strong)] w-fit font-mono-spec text-xs">
                  <a
                    href="#projects"
                    class="px-6 py-3.5 bg-[var(--text-primary)] text-[var(--bg-surface)] font-semibold uppercase tracking-wider hover:bg-[var(--signal)] hover:text-white transition-colors"
                  >
                    01 / Explore Work ↓
                  </a>
                  <a
                    href="#labs-showcase"
                    class="px-6 py-3.5 bg-[var(--bg-surface)] text-[var(--text-primary)] font-medium uppercase tracking-wider border-l border-[var(--rule-strong)] hover:bg-[var(--bg-panel)] transition-colors"
                  >
                    02 / Systems Labs ↓
                  </a>
                  <a
                    href="/resume"
                    class="px-6 py-3.5 bg-[var(--bg-surface)] text-[var(--text-primary)] font-medium uppercase tracking-wider border-l border-[var(--rule-strong)] hover:bg-[var(--bg-panel)] transition-colors"
                  >
                    03 / Full CV →
                  </a>
                </div>
              </div>

              <!-- Right 5 Cols: Raw Tabular ~/now Readout + Original World Coordinate Map -->
              <div
                data-hero-spec
                class="xl:col-span-5 border border-[var(--rule-hairline)] bg-[var(--bg-panel)] font-mono-spec text-xs flex flex-col justify-between"
              >
                <div>
                  <div class="px-4 py-3 border-b border-[var(--rule-hairline)] flex items-center justify-between text-[10.5px] uppercase tracking-wider">
                    <span class="font-semibold text-[var(--text-primary)]">~/NOW — STATE READOUT</span>
                    <span class="text-[var(--signal)] font-semibold">SYS.HUMAN // v{siteContent.meta.systemVersion}</span>
                  </div>
                  <dl class="divide-y divide-[var(--rule-hairline)] text-[11.5px]">
                    {
                      siteContent.hero.nowTerminal.map((row) => (
                        <div class="grid grid-cols-12 px-4 py-2.5 items-baseline">
                          <dt class="col-span-4 text-[var(--text-muted)] uppercase">&gt; {row.key}</dt>
                          <dd class="col-span-8 text-[var(--text-primary)] font-medium">
                            {row.value}
                          </dd>
                        </div>
                      ))
                    }
                  </dl>
                </div>

                <!-- Preserved Original World Dot-Matrix Constellation + Coordinate Reticle -->
                <div class="p-4 border-t border-[var(--rule-hairline)] bg-[var(--bg-surface)]/60 flex items-center justify-between gap-4">
                  <div class="space-y-1 text-[10px]">
                    <div class="text-[var(--text-muted)] uppercase">SECTOR // ORIGIN</div>
                    <div class="text-[var(--text-primary)] font-semibold">TORONTO, ON [CA]</div>
                    <div class="text-[var(--signal)]">
                      {siteContent.meta.coordinates.lat} / {siteContent.meta.coordinates.lng}
                    </div>
                  </div>

                  <svg
                    viewBox="0 0 160 50"
                    fill="currentColor"
                    class="w-[140px] h-auto text-[var(--text-muted)] shrink-0"
                    aria-label="World coordinate dot matrix highlighting Toronto"
                  >
                    <circle cx="20" cy="12" r="1.1"></circle>
                    <circle cx="26" cy="10" r="1.1"></circle>
                    <circle cx="32" cy="14" r="1.1"></circle>
                    <circle cx="24" cy="18" r="1.1"></circle>
                    <circle cx="30" cy="20" r="1.1"></circle>
                    <circle cx="28" cy="26" r="1.1"></circle>
                    <circle cx="34" cy="30" r="1.1"></circle>
                    <circle cx="38" cy="36" r="1.1"></circle>
                    <circle cx="36" cy="42" r="1.1"></circle>
                    <!-- Toronto Target Reticle -->
                    <circle cx="32" cy="18" r="3" class="text-[var(--signal)]"></circle>
                    <line x1="25" y1="18" x2="39" y2="18" stroke="var(--signal)" stroke-width="0.6"></line>
                    <line x1="32" y1="11" x2="32" y2="25" stroke="var(--signal)" stroke-width="0.6"></line>
                    <circle cx="72" cy="12" r="1.1"></circle>
                    <circle cx="78" cy="10" r="1.1"></circle>
                    <circle cx="84" cy="14" r="1.1"></circle>
                    <circle cx="76" cy="18" r="1.1"></circle>
                    <circle cx="82" cy="22" r="1.1"></circle>
                    <circle cx="78" cy="28" r="1.1"></circle>
                    <circle cx="84" cy="32" r="1.1"></circle>
                    <circle cx="86" cy="38" r="1.1"></circle>
                    <circle cx="82" cy="42" r="1.1"></circle>
                    <circle cx="102" cy="12" r="1.1"></circle>
                    <circle cx="110" cy="10" r="1.1"></circle>
                    <circle cx="118" cy="14" r="1.1"></circle>
                    <circle cx="126" cy="16" r="1.1"></circle>
                    <circle cx="108" cy="20" r="1.1"></circle>
                    <circle cx="116" cy="22" r="1.1"></circle>
                    <circle cx="124" cy="24" r="1.1"></circle>
                    <circle cx="132" cy="26" r="1.1"></circle>
                    <circle cx="114" cy="30" r="1.1"></circle>
                    <circle cx="122" cy="32" r="1.1"></circle>
                    <circle cx="132" cy="40" r="1.1"></circle>
                    <circle cx="138" cy="42" r="1.1"></circle>
                    <circle cx="134" cy="46" r="1.1"></circle>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Lower Band: RIGHT NOW 4-Column Structural Matrix (#right-now) -->
          <div id="right-now" class="scroll-mt-14">
            <div class="px-6 sm:px-10 py-3 border-b border-[var(--rule-hairline)] bg-[var(--bg-panel)] flex items-center justify-between font-mono-spec text-[10.5px] uppercase tracking-[0.2em] text-[var(--text-muted)]">
              <span>RIGHT NOW // ACTIVE OPERATIONAL PILLARS</span>
              <span>01 — 04</span>
            </div>

            <div
              data-stagger-group
              class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-[var(--rule-hairline)]"
            >
              {
                siteContent.rightNow.map((item) => (
                  <div
                    data-stagger-item
                    class="p-6 sm:p-8 flex flex-col justify-between min-h-[220px] hover:bg-[var(--bg-panel)] transition-colors group"
                  >
                    <div>
                      <div class="flex items-center justify-between font-mono-spec text-[11px] text-[var(--text-muted)] mb-4">
                        <span class="text-[var(--signal)] font-semibold">{item.index}</span>
                        <span class="tracking-widest uppercase">{item.label}</span>
                      </div>
                      <h2 class="font-display text-xl sm:text-[22px] font-bold tracking-tight text-[var(--text-primary)]">
                        {item.title}
                      </h2>
                      <p class="text-[13.5px] text-[var(--text-secondary)] leading-[1.62] mt-2.5">
                        {item.description}
                      </p>
                    </div>

                    <div class="pt-5 mt-6 border-t border-[var(--rule-hairline)] flex items-center justify-between font-mono-spec text-[10.5px] text-[var(--text-muted)]">
                      <span>OUTPUT</span>
                      <span class="text-[var(--text-primary)] font-medium">{item.metric}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         SECTION 02 // SOFTWARE PROJECTS (#projects — SONOMA & CERTFORGE)
         ========================================================== -->
    <section
      id="projects"
      data-section-title="SEC.02 // SELECTED SOFTWARE WORK"
      class="border-b border-[var(--rule-hairline)] scroll-mt-14"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Left Sticky Architectural Gutter -->
        <div
          class="lg:col-span-2 p-5 sm:p-6 lg:p-8 border-b lg:border-b-0 lg:border-r border-[var(--rule-hairline)] font-mono-spec text-[11px] text-[var(--text-muted)]"
        >
          <div class="lg:sticky lg:top-[74px] flex lg:flex-col justify-between gap-8">
            <div>
              <span class="text-[var(--signal)] font-semibold block">INDEX // 02</span>
              <span class="uppercase tracking-widest mt-1 block text-[var(--text-primary)] font-medium">
                SELECTED WORK
              </span>
              <span class="hidden lg:block text-[10px] text-[var(--text-muted)] mt-3 leading-relaxed">
                Full-stack TypeScript tools built around personal operations and network study.
              </span>
            </div>
            <span class="hidden lg:block text-[10px] pt-6 border-t border-[var(--rule-hairline)]">
              02.A SONOMA<br />02.B CERTFORGE
            </span>
          </div>
        </div>

        <!-- Right 10 Cols: Case Study Rows -->
        <div class="lg:col-span-10 divide-y divide-[var(--rule-hairline)]">
          <!-- Section Header Bar -->
          <div class="p-6 sm:p-10 lg:px-14 lg:py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4 bg-[var(--bg-panel)]/50">
            <div>
              <span class="font-mono-spec text-[10.5px] uppercase tracking-[0.2em] text-[var(--signal)] block mb-2">
                PRACTICAL SOFTWARE ENGINEERING
              </span>
              <h2 class="clip-line font-display text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-[-0.03em] uppercase text-[var(--text-primary)] leading-none">
                <span data-reveal-heading class="clip-line-inner">Built for real workflows.</span>
              </h2>
            </div>
            <p class="font-mono-spec text-xs text-[var(--text-muted)]">
              STACK // NEXT.JS · TYPESCRIPT · TAILWIND CSS
            </p>
          </div>

          <!-- CASE STUDY 01: SONOMA (With Interactive Viewport & Lightbox Zoom) -->
          <article class="grid grid-cols-1 xl:grid-cols-12">
            <!-- Left 6 Cols: Specifications -->
            <div class="xl:col-span-6 p-6 sm:p-10 lg:p-14 border-b xl:border-b-0 xl:border-r border-[var(--rule-hairline)] flex flex-col justify-between gap-8">
              <div>
                <div class="flex items-center justify-between font-mono-spec text-xs mb-6">
                  <span class="text-[var(--signal)] font-semibold">PROJECT // 02.A</span>
                  <span class="px-2 py-0.5 border border-[var(--rule-hairline)] text-[10.5px] uppercase">
                    Private · In Progress
                  </span>
                </div>

                <h3 class="font-display text-3xl sm:text-4xl font-bold tracking-[-0.03em] text-[var(--text-primary)]">
                  Sonoma
                </h3>
                <p class="text-[15.5px] text-[var(--text-primary)] font-medium leading-[1.6] mt-3">
                  {siteContent.projects[0].summary}
                </p>
                <p class="text-[14px] text-[var(--text-secondary)] leading-[1.65] mt-3">
                  {siteContent.projects[0].architectureNote}
                </p>

                <ul class="mt-5 space-y-1.5 font-mono-spec text-xs text-[var(--text-secondary)]">
                  {
                    siteContent.projects[0].highlights.map((hl) => (
                      <li class="flex items-start gap-2">
                        <span class="text-[var(--signal)]">—</span>
                        <span>{hl}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- Tabular Spec Sheet -->
              <div class="border-t border-[var(--rule-hairline)] pt-5 font-mono-spec text-xs space-y-2.5">
                <div class="grid grid-cols-12">
                  <span class="col-span-4 text-[var(--text-muted)]">STACK</span>
                  <span class="col-span-8 text-[var(--text-primary)]">
                    Next.js · TypeScript · Tailwind CSS
                  </span>
                </div>
                <div class="grid grid-cols-12">
                  <span class="col-span-4 text-[var(--text-muted)]">MODULES</span>
                  <span class="col-span-8 text-[var(--text-secondary)]">
                    Expense Ledger · Document Vault · Cashflow
                  </span>
                </div>
                <div class="grid grid-cols-12">
                  <span class="col-span-4 text-[var(--text-muted)]">ACCESS</span>
                  <span class="col-span-8 text-[var(--text-muted)]">
                    Private project (Internal personal deployment)
                  </span>
                </div>
              </div>
            </div>

            <!-- Right 6 Cols: Interactive Dual-Mode Inspector for Sonoma -->
            <div class="xl:col-span-6 p-6 sm:p-10 lg:p-12 bg-[var(--bg-panel)] flex flex-col justify-between">
              <div class="w-full border border-[var(--rule-hairline)] bg-[var(--bg-surface)]">
                <!-- Inspector Mode Tabs -->
                <div
                  class="flex items-center justify-between border-b border-[var(--rule-hairline)] font-mono-spec text-[10.5px]"
                  role="tablist"
                  aria-label="Sonoma view mode"
                >
                  <button
                    type="button"
                    role="tab"
                    aria-selected="true"
                    data-sonoma-tab="ui"
                    class="flex-1 py-2.5 px-4 text-left font-semibold bg-[var(--text-primary)] text-[var(--bg-surface)] cursor-pointer transition-colors"
                  >
                    01 // UI VIEWPORT
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-sonoma-tab="arch"
                    class="flex-1 py-2.5 px-4 text-left text-[var(--text-muted)] hover:text-[var(--text-primary)] border-l border-[var(--rule-hairline)] cursor-pointer transition-colors"
                  >
                    02 // PRIVACY SCHEMATIC
                  </button>
                </div>

                <!-- Panel 1: Screenshot Viewport with Lightbox Zoom Trigger -->
                <div id="sonoma-panel-ui" class="p-2">
                  <div
                    data-lightbox
                    data-lightbox-src="/assets/projects/sonoma-dashboard.png"
                    data-lightbox-alt="Sonoma Expense & Document Management Dashboard"
                    class="aspect-[16/10] overflow-hidden relative bg-[#141413] cursor-zoom-in group"
                  >
                    <img
                      data-parallax-img
                      src="/assets/projects/sonoma-dashboard.png"
                      alt="Sonoma private expense and document management dashboard"
                      width="720"
                      height="450"
                      loading="lazy"
                      class="w-full h-full object-cover object-[14%_8%] group-hover:scale-[1.03] transition-transform duration-300"
                    />
                    <div class="absolute bottom-2.5 right-2.5 px-2 py-1 bg-black/80 text-white font-mono-spec text-[10px] opacity-0 group-hover:opacity-100 transition-opacity">
                      [CLICK TO ZOOM ⤢]
                    </div>
                  </div>
                </div>

                <!-- Panel 2: Architecture Blueprint -->
                <div
                  id="sonoma-panel-arch"
                  class="hidden p-5 aspect-[16/10] bg-blueprint-grid font-mono-spec text-xs flex flex-col justify-between"
                >
                  <div class="flex items-center justify-between text-[10px] text-[var(--text-muted)]">
                    <span>DATA ISOLATION PIPELINE</span>
                    <span class="text-[var(--signal)] font-semibold">ZERO 3RD-PARTY BANK SYNC</span>
                  </div>

                  <div class="grid grid-cols-3 gap-3 my-auto">
                    <div class="border border-[var(--rule-strong)] bg-[var(--bg-surface)] p-3">
                      <span class="text-[9.5px] text-[var(--signal)] block">INGEST // 01</span>
                      <div class="font-display font-bold text-sm mt-1">Receipt &amp; PDF Vault</div>
                      <p class="text-[10.5px] text-[var(--text-secondary)] mt-1">
                        Structured document metadata &amp; local categorization.
                      </p>
                    </div>
                    <div class="border border-[var(--rule-strong)] bg-[var(--bg-surface)] p-3">
                      <span class="text-[9.5px] text-[var(--signal)] block">ENGINE // 02</span>
                      <div class="font-display font-bold text-sm mt-1">Typed Ledger Core</div>
                      <p class="text-[10.5px] text-[var(--text-secondary)] mt-1">
                        Strict TypeScript schema for recurring &amp; fixed obligations.
                      </p>
                    </div>
                    <div class="border border-[var(--rule-strong)] bg-[var(--bg-surface)] p-3">
                      <span class="text-[9.5px] text-[var(--signal)] block">OUTPUT // 03</span>
                      <div class="font-display font-bold text-sm mt-1">Monthly Telemetry</div>
                      <p class="text-[10.5px] text-[var(--text-secondary)] mt-1">
                        Instant burn-rate &amp; category variance readouts.
                      </p>
                    </div>
                  </div>

                  <div class="text-[10px] text-[var(--text-muted)] flex justify-between border-t border-[var(--rule-hairline)] pt-2">
                    <span>HOST: PRIVATE INSTANCE</span>
                    <span>AUTH: SINGLE-TENANT</span>
                  </div>
                </div>

                <div class="px-3 py-2 border-t border-[var(--rule-hairline)] flex items-center justify-between font-mono-spec text-[10px] text-[var(--text-muted)]">
                  <span>FIG 01. SONOMA WORKSPACE</span>
                  <span>CLICK IMAGE FOR FULLSCREEN VIEWPORT</span>
                </div>
              </div>
            </div>
          </article>

          <!-- CASE STUDY 02: CERTFORGE (With High-Res Platform Visual & Lightbox Zoom) -->
          <article class="grid grid-cols-1 xl:grid-cols-12">
            <!-- Left 6 Cols: Specifications -->
            <div class="xl:col-span-6 p-6 sm:p-10 lg:p-14 border-b xl:border-b-0 xl:border-r border-[var(--rule-hairline)] flex flex-col justify-between gap-8">
              <div>
                <div class="flex items-center justify-between font-mono-spec text-xs mb-6">
                  <span class="text-[var(--signal)] font-semibold">PROJECT // 02.B</span>
                  <span class="px-2 py-0.5 border border-[var(--rule-hairline)] text-[10.5px] uppercase">
                    Study Platform · Web App
                  </span>
                </div>

                <h3 class="font-display text-3xl sm:text-4xl font-bold tracking-[-0.03em] text-[var(--text-primary)]">
                  CertForge
                </h3>
                <p class="text-[15.5px] text-[var(--text-primary)] font-medium leading-[1.6] mt-3">
                  {siteContent.projects[1].summary}
                </p>
                <p class="text-[14px] text-[var(--text-secondary)] leading-[1.65] mt-3">
                  {siteContent.projects[1].architectureNote}
                </p>

                <ul class="mt-5 space-y-1.5 font-mono-spec text-xs text-[var(--text-secondary)]">
                  {
                    siteContent.projects[1].highlights.map((hl) => (
                      <li class="flex items-start gap-2">
                        <span class="text-[var(--signal)]">—</span>
                        <span>{hl}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- Tabular Spec Sheet + Repository Link -->
              <div class="border-t border-[var(--rule-hairline)] pt-5 font-mono-spec text-xs space-y-2.5">
                <div class="grid grid-cols-12">
                  <span class="col-span-4 text-[var(--text-muted)]">STACK</span>
                  <span class="col-span-8 text-[var(--text-primary)]">
                    Next.js · TypeScript · Tailwind CSS
                  </span>
                </div>
                <div class="grid grid-cols-12">
