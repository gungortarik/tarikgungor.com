---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/siteContent';

const labs = siteContent.resume.labs;

const labDetails: Record<string, { map: string; verify: string; rationale: string }> = {
  'LAB-01': {
    map: `WAN / ISP Gateway (10.0.0.1)
 └─ pfSense — Dual-NIC NAT & State Table
     ├─ VLAN 10 (192.168.10.0/24) ── Workstations & Clients
     ├─ VLAN 20 (192.168.20.0/24) ── Domain Controllers (DC01, DC02)
     └─ VLAN 30 (192.168.30.0/24) ── Isolated Storage & Hypervisors`,
    verify: 'pfctl -sr | grep pass',
    rationale: 'Segregates untrusted client workstations from core domain infrastructure using strict 802.1Q sub-interfaces and firewall rules.',
  },
  'LAB-02': {
    map: `corp.local (Forest Root)
 └─ OU: Toronto
     ├─ OU: Workstations ── GPO: BitLocker, LAPS, Firewall Baseline
     ├─ OU: Users        ── Tiered Security Groups, Role-Based Access
     └─ OU: Servers      ── DC01 & DC02 DFSR Multi-Master Replication`,
    verify: 'Get-ADOrganizationalUnit -Filter * | select DistinguishedName',
    rationale: 'Implements Microsoft Tiered Administration Model to mitigate lateral privilege escalation across the enterprise domain.',
  },
  'LAB-03': {
    map: `Workstation Client ──> AD-Integrated DNS (192.168.20.10 / .11)
 ├─ Forward Zone: corp.local  ── Secure Dynamic Updates & SRV Records
 ├─ Reverse Zone: 20.168.192  ── PTR Records for Kerberos SPNs
 └─ Forwarders                ── 1.1.1.1 / 9.9.9.9 (Encrypted DNS)`,
    verify: 'Resolve-DnsName dc01.corp.local -Server 192.168.20.10',
    rationale: 'Crucial for Kerberos ticket issuance, domain controller locator discovery, and secure hostname resolution across VLANs.',
  },
  'LAB-04': {
    map: `Ubuntu Server 22.04 LTS (isc-dhcp-server)
 ├─ Scope VLAN 10: 192.168.10.50 – .200 (24h Lease, Option 3 Router)
 ├─ Scope VLAN 20: 192.168.20.50 – .100 (Servers Static Reservations)
 └─ Relay Agent  : pfSense DHCP-Relay helper IP forwarding`,
    verify: 'systemctl status isc-dhcp-server && dhcp-lease-list',
    rationale: 'Centralized Linux-based lease provisioning across trunked segments with lease expiration tracking and MAC reservations.',
  },
  'LAB-05': {
    map: `TrueNAS Core Storage Target (ZFS RAID-Z2 Pool)
 └─ iSCSI Portal :3260 (Dedicated 192.168.30.0/24 Subnet)
     ├─ Hyper-V Host 01 (MPIO Path A: 192.168.30.11)
     └─ Hyper-V Host 02 (MPIO Path B: 192.168.30.12)`,
    verify: 'iscsicli ListTargets',
    rationale: 'Block storage presentation over TCP/IP with redundant multipathing (MPIO) to survive single NIC failures.',
  },
  'LAB-06': {
    map: `Node 01 (WS2022) <── Heartbeat Network (10.1.1.0/30) ──> Node 02 (WS2022)
 └─ Shared Clustered Shared Volume (CSV) on TrueNAS iSCSI SAN
 └─ File Share Witness (Quorum Majority Arbitrator)`,
    verify: 'Get-ClusterNode; Get-ClusterResource | Format-Table Name, State',
    rationale: 'Zero-downtime high-availability file cluster with automatic failover between nodes upon host failure.',
  },
  'LAB-07': {
    map: `Physical Bare-Metal Host (Hyper-V Hypervisor)
 └─ Nested VMware ESXi 8.0 Virtual Host (Promiscuous Mode vSwitch)
     ├─ vSwitch0 ── VMkernel Management (vmk0: 192.168.20.55)
     └─ vSwitch1 ── 802.1Q VLAN Trunk Port Group (VLAN ID 4095)`,
    verify: 'esxcli network vswitch standard list',
    rationale: 'Nested hypervisor testing environment enabling multi-tenant VMware vSphere validation inside a single physical workstation.',
  },
};

const experience = [
  {
    years: '2026 — Present',
    org: 'George Brown College',
    role: 'Computer Systems Technology',
    scale: 'Advanced Diploma · Toronto, ON',
    points: [
      'Advanced networking, multi-area OSPF routing, enterprise switching & VLAN trunking.',
      'Linux systems administration, shell automation, kernel security & user management.',
      'Windows Server directory services, Group Policy design, and enterprise storage architectures.',
    ],
  },
  {
    years: '2024 — Present',
    org: 'BETA PREP',
    role: 'IT Specialist',
    scale: '38 Endpoints · Hybrid Fleet',
    points: [
      'Direct administration of 38 Windows 10/11 endpoints across physical offices and remote staff.',
      'Microsoft 365 tenant management: Exchange Online, multi-factor authentication (MFA) and SharePoint permissions.',
      'Diagnosing day-to-day connectivity, TCP/IP lease renegotiations, and local DNS/DHCP issues.',
    ],
  },
  {
    years: '2023 — Present',
    org: 'Bestof Floor LTD',
    role: 'IT Support Specialist',
    scale: '23 Devices · On-Prem Active Directory',
    points: [
      'On-premise Active Directory domain support: user onboarding, security groups, and shared drive NTFS ACLs.',
      'Hardware maintenance, desktop lifecycle provisioning, automated backup verification, and printer network routing.',
      'Maintained 99.8% workstation uptime across internal sales and operational personnel.',
    ],
  },
  {
    years: '2023',
    org: 'Payment Source',
    role: 'IT Analyst Intern',
    scale: '50+ Corporate Endpoints',
    points: [
      'Fleet configuration using ManageEngine Endpoint Central, rolling out security patches and software packages.',
      'Implemented automated compliance scripts and standardized Windows workstation images.',
      'Collaborated with senior infrastructure engineers on enterprise MDM policies and remote wipe protocols.',
    ],
  },
  {
    years: '2022 — 2023',
    org: 'BCIT',
    role: 'Technology Support Professional',
    scale: 'Comprehensive Technical Program · Vancouver, BC',
    points: [
      'Hands-on foundation across enterprise Windows administration, network topology design, and virtualization.',
      'Built physical patch-panel cabling, configured managed Cisco switches, and learned structured IT service operations.',
    ],
  },
];

const note = siteContent.notes[0];
---

<BaseLayout title={siteContent.meta.title} description={siteContent.meta.description} canonicalPath="/">
  <main id="main-content" class="space-y-28 sm:space-y-36 pb-28 pt-8 sm:pt-14">

    <!-- HERO SECTION -->
    <section class="wrap pt-6 sm:pt-12">
      <div class="max-w-4xl space-y-8">
        <!-- Live status pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[var(--bg-subtle)] border border-[var(--line)] text-xs font-mono text-[var(--ink-2)]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Computer Systems Technology · George Brown College</span>
          <span class="text-[var(--muted)]">/</span>
          <span class="text-[var(--accent)] font-medium">IT Specialist</span>
        </div>

        <!-- Headline -->
        <h1 class="font-heading text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[var(--ink)] leading-[1.08]">
          Building reliable systems. <br />
          <span class="text-[var(--ink-2)]">Learning by breaking things in the lab.</span>
        </h1>

        <!-- Personal Narrative -->
        <p class="text-lg sm:text-xl text-[var(--ink-2)] leading-relaxed max-w-3xl">
          I'm Tarik Gungor. I study Computer Systems Technology in Toronto and work in IT support — managing Windows infrastructure,
          hybrid networks, and Microsoft 365 for real business teams. On the side, I build practical software tools like
          <strong class="text-[var(--ink)] font-semibold">Sonoma</strong> and <strong class="text-[var(--ink)] font-semibold">CertForge</strong>,
          and engineer multi-hypervisor lab environments to understand how systems operate under the hood.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="#projects" class="btn-primary" data-magnetic="0.3">
            <span data-magnetic-inner class="flex items-center gap-2">
              <span>View Projects</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </a>

          <a href="#workbench" class="btn-secondary" data-magnetic="0.3">
            <span data-magnetic-inner class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
              <span>Open Lab Studio</span>
            </span>
          </a>

          <a href="/resume" class="btn-secondary" data-magnetic="0.3">
            <span data-magnetic-inner>Resume &amp; Credentials →</span>
          </a>
        </div>
      </div>

      <!-- Telemetry Strip (Josh Comeau / Engineer's Workbench feel) -->
      <div class="mt-14 sm:mt-20 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-8 border-t border-[var(--line)]">
        <div class="space-y-1">
          <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider">Active Fleet</div>
          <div class="font-heading text-2xl font-bold text-[var(--ink)]">60+ Hosts</div>
          <div class="text-xs text-[var(--ink-2)]">BETA PREP &amp; Bestof Floor</div>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider">Virtual Labs</div>
          <div class="font-heading text-2xl font-bold text-[var(--ink)]">7 Environments</div>
          <div class="text-xs text-[var(--ink-2)]">Hyper-V · ESXi 8.0 · TrueNAS</div>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider">Focus Areas</div>
          <div class="font-heading text-2xl font-bold text-[var(--ink)]">Network+ · CCNA</div>
          <div class="text-xs text-[var(--ink-2)]">Subnetting · VLANs · Active Directory</div>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider">Base of Operations</div>
          <div class="font-heading text-2xl font-bold text-[var(--accent)]" data-toronto-clock>Toronto, ON</div>
          <div class="text-xs text-[var(--ink-2)]">George Brown College (T147)</div>
        </div>
      </div>
    </section>

    <!-- RIGHT NOW (CURRENT FOCUS) -->
    <section class="wrap">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[var(--line)]">
        <div class="space-y-1">
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Active Threads</span>
          <h2 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink)]">What I'm focused on right now</h2>
        </div>
        <span class="text-xs font-mono text-[var(--muted)] hidden sm:block">Spring 2026 Status</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          siteContent.rightNow.map((item) => (
            <div class="tactile-card p-6 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-[var(--muted)] mb-4">
                  <span class="text-[var(--accent)] font-semibold">{item.index}</span>
                  <span>{item.label}</span>
                </div>
                <h3 class="font-heading text-lg font-bold text-[var(--ink)] leading-snug">{item.title}</h3>
                <p class="mt-2.5 text-sm text-[var(--ink-2)] leading-relaxed">{item.description}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-[var(--line)] text-xs font-mono text-[var(--muted)]">
                {item.metric}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FEATURED PROJECTS SECTION -->
    <section id="projects" class="wrap scroll-mt-24">
      <div class="space-y-2 mb-12">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Engineering &amp; Code</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">Featured Projects</h2>
        <p class="text-[16px] text-[var(--ink-2)] max-w-2xl leading-relaxed">
          I build practical tools around problems I actually encounter — from personal finance privacy to interactive network certification preparation.
        </p>
      </div>

      <div class="space-y-12">

        <!-- PROJECT 1: SONOMA -->
        <article class="tactile-card overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-6 sm:p-10">
            <!-- Screenshot Preview in Browser Window Frame -->
            <div class="lg:col-span-7 space-y-3">
              <div class="rounded-xl overflow-hidden border border-[var(--line)] bg-[var(--bg-elevated)] shadow-xl group">
                <!-- Browser Bar -->
                <div class="flex items-center justify-between px-4 py-2.5 bg-[var(--bg-subtle)] border-b border-[var(--line)] text-xs text-[var(--muted)] font-mono">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                  </div>
                  <div class="px-3 py-0.5 rounded bg-[var(--bg-card)] border border-[var(--line)] text-[11px] text-[var(--ink-2)]">
                    https://sonoma.internal/dashboard
                  </div>
                  <span class="text-[11px]">Private Vault</span>
                </div>
                <!-- Image with Lightbox click -->
                <a
                  href="/assets/projects/sonoma-dashboard.png"
                  data-lightbox
                  data-lightbox-src="/assets/projects/sonoma-dashboard.png"
                  data-lightbox-alt="Sonoma private expense and document management dashboard"
                  class="block relative cursor-zoom-in overflow-hidden"
                >
                  <img
                    src="/assets/projects/sonoma-dashboard.png"
                    alt="Sonoma private expense and document management dashboard"
                    loading="lazy"
                    class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black/75 text-white text-xs px-3.5 py-1.5 rounded-full font-mono backdrop-blur-sm">
                      Click to inspect full image ↗
                    </span>
                  </div>
                </a>
              </div>
            </div>

            <!-- Content Details -->
            <div class="lg:col-span-5 space-y-6">
              <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-500 text-xs font-mono font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  <span>Private Product · Daily Production</span>
                </div>
                <h3 class="font-heading text-3xl font-bold text-[var(--ink)]">Sonoma</h3>
                <p class="text-sm font-medium text-[var(--accent)] font-mono">Personal Expense &amp; Document Vault</p>
              </div>

              <p class="text-sm sm:text-[15px] text-[var(--ink-2)] leading-relaxed">
                A private financial ledger and document management vault I built for myself. Tracks receipts, recurring cashflow,
                and tax documents with complete local privacy — eliminating the need to expose sensitive banking credentials to third-party aggregators.
              </p>

              <!-- Feature Highlights -->
              <ul class="space-y-2.5 text-xs sm:text-sm text-[var(--ink-2)]">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span><strong>Zero-Aggregation Architecture:</strong> Financial records remain strictly on trusted devices.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span><strong>Receipt &amp; Tax Tagging:</strong> Fast metadata filtering by fiscal year and expense category.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span><strong>Operational High-Contrast UI:</strong> Tailored for rapid daily entry with keyboard shortcuts.</span>
                </li>
              </ul>

              <!-- Tech Stack Pills -->
              <div class="flex flex-wrap gap-2 pt-2">
                <span class="tech-pill">Next.js 15</span>
                <span class="tech-pill">TypeScript</span>
                <span class="tech-pill">Tailwind CSS</span>
                <span class="tech-pill font-mono">Local-First Storage</span>
              </div>
            </div>
          </div>
        </article>

        <!-- PROJECT 2: CERTFORGE WITH LIVE INTERACTIVE DRILL (JOSH COMEAU STYLE) -->
        <article class="tactile-card overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch p-6 sm:p-10">

            <!-- Content Details -->
            <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="space-y-2">
                  <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                    <span>Open Source · Active Recall Platform</span>
                  </div>
                  <h3 class="font-heading text-3xl font-bold text-[var(--ink)]">CertForge</h3>
                  <p class="text-sm font-medium text-[var(--accent)] font-mono">Network+ &amp; CCNA Certification Drills</p>
                </div>

                <p class="text-sm sm:text-[15px] text-[var(--ink-2)] leading-relaxed">
                  An open-source technical training platform designed around active recall instead of passive reading.
                  Drills students on subnetting calculations under time constraints, OSI packet tracing, and VLAN routing topologies.
                </p>

                <!-- Highlights -->
                <ul class="space-y-2.5 text-xs sm:text-sm text-[var(--ink-2)]">
                  <li class="flex items-start gap-2.5">
                    <span class="text-[var(--accent)] font-bold">●</span>
                    <span><strong>Subnetting &amp; CIDR Drills:</strong> Rapid calculation of usable hosts, masks, and network boundaries.</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-[var(--accent)] font-bold">●</span>
                    <span><strong>OSI &amp; Packet Flow:</strong> Tracing encapsulation from Layer 7 Application down to Layer 1 Physical bits.</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-[var(--accent)] font-bold">●</span>
                    <span><strong>CLI Verification Mode:</strong> Practicing live Cisco IOS and Linux ip-route commands.</span>
                  </li>
                </ul>

                <!-- Tech Stack -->
                <div class="flex flex-wrap gap-2 pt-2">
                  <span class="tech-pill">Next.js 15</span>
                  <span class="tech-pill">TypeScript</span>
                  <span class="tech-pill">Network Engineering</span>
                  <span class="tech-pill">Tailwind CSS</span>
                </div>
              </div>

              <!-- Links -->
              <div class="pt-6 border-t border-[var(--line)] flex flex-wrap gap-3">
                <a
                  href="https://github.com/gungortarik/certforge"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary !py-2 !px-4 !text-xs"
                >
                  <span>View on GitHub ↗</span>
                </a>
                <a
                  href="/assets/projects/certforge-platform.svg"
                  data-lightbox
                  data-lightbox-src="/assets/projects/certforge-platform.svg"
                  data-lightbox-alt="CertForge Platform Architecture"
                  class="btn-secondary !py-2 !px-4 !text-xs cursor-zoom-in"
                >
                  <span>Platform Architecture SVG ↗</span>
                </a>
              </div>
            </div>

            <!-- Interactive Hands-on Drill Widget (PURE JOSH COMEAU INTERACTIVITY) -->
            <div class="lg:col-span-7 flex flex-col">
              <div class="rounded-xl border border-[var(--line)] bg-[var(--code-bg)] p-6 sm:p-7 flex-1 flex flex-col justify-between shadow-2xl relative overflow-hidden">
                <!-- Background subtle glow -->
                <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-[var(--accent)] opacity-10 blur-3xl pointer-events-none"></div>

                <!-- Drill Header -->
                <div>
                  <div class="flex items-center justify-between pb-4 border-b border-[var(--code-border)] text-xs font-mono">
                    <div class="flex items-center gap-2 text-indigo-400">
                      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                      <span id="drill-domain">CompTIA Network+ // Subnetting &amp; CIDR</span>
                    </div>
                    <div class="text-[var(--muted)]">
                      <span id="drill-step">Drill 1 of 4</span>
                      <span class="mx-1.5">·</span>
                      <span id="drill-score" class="text-emerald-400 font-semibold">Score: 0</span>
                    </div>
                  </div>

                  <!-- Question Box -->
                  <div class="mt-6 mb-6">
                    <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider mb-2">Practice Question:</div>
                    <p id="drill-question" class="font-heading text-lg sm:text-xl font-bold text-slate-100 leading-snug">
                      How many usable host IP addresses are available in a /27 IPv4 subnet?
                    </p>
                  </div>

                  <!-- Options Container -->
                  <div id="drill-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- Populated via script below -->
                  </div>

                  <!-- Explanation Box (Appears after answer) -->
                  <div id="drill-feedback" class="mt-5 p-4 rounded-lg bg-slate-900/90 border border-slate-700/60 hidden transition-all duration-300">
                    <div class="flex items-start gap-3">
                      <span id="feedback-icon" class="text-lg"></span>
                      <div class="text-xs sm:text-sm leading-relaxed text-slate-300 space-y-1">
                        <strong id="feedback-title" class="block font-semibold"></strong>
                        <p id="feedback-text"></p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Next Drill Action -->
                <div class="mt-6 pt-4 border-t border-[var(--code-border)] flex items-center justify-between text-xs font-mono">
                  <span class="text-[var(--muted)]">Interactive CCNA &amp; Network+ Simulator</span>
                  <button
                    type="button"
                    id="drill-next-btn"
                    class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium transition-colors cursor-pointer flex items-center gap-1.5"
                  >
                    <span>Next Drill</span>
                    <span>→</span>
                  </button>
                </div>
              </div>
            </div>

          </div>
        </article>

      </div>
    </section>

    <!-- INTERACTIVE LAB WORKBENCH (THE SYSTEMS CORE) -->
    <section id="workbench" class="wrap scroll-mt-24">
      <div class="space-y-2 mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Systems Infrastructure Studio</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">Virtual Lab Workbench</h2>
        <p class="text-[16px] text-[var(--ink-2)] max-w-2xl leading-relaxed">
          A lot of what I know comes from building, configuring, and breaking virtual environments in Hyper-V and nested VMware ESXi.
          Select an environment to inspect its topology diagram and live verification syntax.
        </p>
      </div>

      <!-- Workbench Container -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Lab Selector List (Left Column) -->
        <div class="lg:col-span-5 space-y-2">
          {
            labs.map((lab, index) => (
              <button
                type="button"
                data-lab-id={lab.id}
                data-lab-index={index}
                class={`lab-tab w-full text-left p-4 rounded-xl border transition-all duration-200 cursor-pointer flex items-center justify-between gap-4 ${
                  index === 0
                    ? 'active bg-[var(--bg-elevated)] border-[var(--accent)] shadow-md'
                    : 'bg-[var(--bg-subtle)] border-[var(--line)] hover:border-[var(--line-strong)]'
                }`}
              >
                <div class="flex items-center gap-3.5 min-w-0">
                  <span class="text-xs font-mono font-semibold text-[var(--accent)] shrink-0">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-heading text-sm font-bold text-[var(--ink)] truncate">
                      {lab.name}
                    </h3>
                    <div class="text-xs text-[var(--muted)] font-mono truncate">
                      {lab.category}
                    </div>
                  </div>
                </div>
                <span class="text-xs font-mono text-[var(--muted)] shrink-0">→</span>
              </button>
            ))
          }
        </div>

        <!-- Active Lab Studio Display (Right Column) -->
        <div class="lg:col-span-7">
          <div class="tactile-card p-6 sm:p-8 space-y-6">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--line)]">
              <div>
                <span id="active-lab-category" class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
                  {labs[0].category}
                </span>
                <h3 id="active-lab-name" class="font-heading text-2xl font-bold text-[var(--ink)] mt-1">
                  {labs[0].name}
                </h3>
              </div>
              <span id="active-lab-id" class="px-2.5 py-1 rounded-md bg-[var(--bg-subtle)] border border-[var(--line)] text-xs font-mono text-[var(--muted)] shrink-0">
                {labs[0].id}
              </span>
            </div>

            <!-- Objective / Rationale -->
            <div class="space-y-1">
              <div class="text-xs font-mono text-[var(--muted)] uppercase tracking-wider">Engineering Purpose:</div>
              <p id="active-lab-rationale" class="text-sm sm:text-[15px] text-[var(--ink-2)] leading-relaxed">
                {labDetails['LAB-01'].rationale}
              </p>
            </div>

            <!-- ASCII Topology Diagram -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs font-mono text-[var(--muted)]">
                <span>Network Topology Diagram:</span>
                <span class="text-emerald-400">● 802.1Q Segmented</span>
              </div>
              <div class="rounded-xl bg-[var(--code-bg)] border border-[var(--code-border)] p-5 overflow-x-auto">
                <pre id="active-lab-map" class="font-mono text-xs sm:text-[13px] leading-[1.8] text-slate-200">{labDetails['LAB-01'].map}</pre>
              </div>
            </div>

            <!-- Verification Command with 1-Click Copy -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs font-mono text-[var(--muted)]">
                <span>Verification &amp; Diagnostic Syntax:</span>
                <button
                  type="button"
                  id="copy-cmd-btn"
                  class="text-[var(--accent)] hover:underline flex items-center gap-1 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span id="copy-btn-text">Copy Command</span>
                </button>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-lg bg-[var(--code-bg)] border border-[var(--code-border)] font-mono text-xs sm:text-sm text-emerald-400">
                <div class="flex items-center gap-2 overflow-x-auto">
                  <span class="text-[var(--muted)] select-none">$</span>
                  <code id="active-lab-verify">{labDetails['LAB-01'].verify}</code>
                </div>
              </div>
            </div>

            <!-- Protocols -->
            <div class="pt-4 border-t border-[var(--line)] flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono text-[var(--muted)] mr-2">Protocols:</span>
              <div id="active-lab-protocols" class="flex flex-wrap gap-1.5">
                {
                  labs[0].protocols.map((proto) => (
                    <span class="tech-pill font-mono">{proto}</span>
                  ))
                }
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- EXPERIENCE & PATH (TIMELINE) -->
    <section id="experience" class="wrap scroll-mt-24">
      <div class="space-y-2 mb-12">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Career &amp; Foundations</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">Experience &amp; Education</h2>
        <p class="text-[16px] text-[var(--ink-2)] max-w-2xl leading-relaxed">
          Real endpoints under management, physical and virtual infrastructure deployments, and ongoing systems education.
        </p>
      </div>

      <div class="space-y-6">
        {
          experience.map((item) => (
            <div class="tactile-card p-6 sm:p-8">
              <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 pb-4 border-b border-[var(--line)]">
                <div>
                  <h3 class="font-heading text-xl sm:text-2xl font-bold text-[var(--ink)]">{item.org}</h3>
                  <div class="text-sm font-medium text-[var(--accent)] mt-0.5">{item.role}</div>
                </div>
                <div class="flex flex-col md:items-end text-xs font-mono text-[var(--muted)]">
                  <span class="text-[var(--ink)] font-semibold text-sm">{item.years}</span>
                  <span>{item.scale}</span>
                </div>
              </div>

              <ul class="mt-5 space-y-2.5 text-sm sm:text-[15px] text-[var(--ink-2)] list-disc pl-5 marker:text-[var(--accent)]">
                {item.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/resume" class="btn-primary" data-magnetic="0.25">
          <span data-magnetic-inner>Full Publication Resume →</span>
        </a>
        <a href="/resume/tarik-gungor-resume.pdf" download class="btn-secondary" data-magnetic="0.25">
          <span data-magnetic-inner>Download Resume PDF ↓</span>
        </a>
      </div>
    </section>

    <!-- WRITING / FIELD NOTE -->
    <section id="writing" class="wrap scroll-mt-24">
      <div class="space-y-2 mb-8">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">Thoughts &amp; Essays</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">Writing</h2>
      </div>

      <a href="/notes/flexible-but-not-free" class="tactile-card block p-6 sm:p-10 group">
        <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
          <div class="space-y-3 max-w-2xl">
            <div class="text-xs font-mono text-[var(--accent)] font-semibold uppercase tracking-wider">
              {note.category} · {note.date}
            </div>
            <h3 class="font-heading text-2xl sm:text-3xl font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
              {note.title}
            </h3>
            <p class="text-[15px] text-[var(--ink-2)] leading-relaxed">
              {note.subtitle}
            </p>
            <p class="text-sm text-[var(--muted)] leading-relaxed pt-2">
              {note.summary}
            </p>
          </div>

          <div class="shrink-0 flex md:flex-col items-center md:items-end justify-between gap-3 text-xs font-mono text-[var(--muted)]">
            <span>{note.readTime}</span>
            <span class="text-[var(--accent)] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              Read Essay →
            </span>
          </div>
        </div>
      </a>
    </section>

  </main>

  <Footer />

  <!-- Interactive Scripts (CertForge Drill & Lab Workbench) -->
  <script is:inline define:vars={{ labDetails, labs }}>
    // CERTFORGE INTERACTIVE DRILL ENGINE (JOSH COMEAU STYLE)
    const drills = [
      {
        domain: 'CompTIA Network+ // Subnetting & CIDR',
        question: 'How many usable host IP addresses are available in a /27 IPv4 subnet?',
        options: [
          { text: '30 hosts', correct: true, explain: 'Correct! Formula: 2^(32 - 27) - 2 = 32 - 2 = 30 usable hosts. The first address is reserved as the Network ID and the last as the Broadcast address.' },
          { text: '32 hosts', correct: false, explain: '32 is the total count of addresses in the block (2^5), but 2 must be subtracted for the Network ID and Broadcast.' },
          { text: '62 hosts', correct: false, explain: '62 usable hosts corresponds to a /26 subnet (2^6 - 2).' },
          { text: '14 hosts', correct: false, explain: '14 usable hosts corresponds to a /28 subnet (2^4 - 2).' }
        ]
      },
      {
        domain: 'Cisco CCNA // OSI Model & Switching',
        question: 'At which OSI layer does a standard Layer 2 Network Switch inspect frames and make forwarding decisions?',
        options: [
          { text: 'Layer 2 (Data Link)', correct: true, explain: 'Correct! Layer 2 switches read the destination hardware MAC address in the Ethernet frame header and consult their CAM table.' },
          { text: 'Layer 3 (Network)', correct: false, explain: 'Layer 3 devices (routers) inspect IP packet headers. Standard switches operate strictly at Layer 2.' },
          { text: 'Layer 1 (Physical)', correct: false, explain: 'Layer 1 legacy hubs simply repeat raw electrical bits on all ports without frame inspection.' },
          { text: 'Layer 4 (Transport)', correct: false, explain: 'Layer 4 inspects TCP/UDP port numbers and segment sequencing.' }
        ]
      },
      {
        domain: 'CompTIA Network+ // Protocol Resolution',
        question: 'Which protocol dynamically maps a known IPv4 address to a physical Ethernet MAC address on a local segment?',
        options: [
          { text: 'ARP (Address Resolution Protocol)', correct: true, explain: 'Correct! ARP broadcasts a "Who has IP X? Tell my MAC" frame to obtain the hardware address for Layer 2 delivery.' },
          { text: 'DNS (Domain Name System)', correct: false, explain: 'DNS resolves human-readable domain names to IP addresses, not IPs to physical MACs.' },
          { text: 'DHCP (Dynamic Host Configuration)', correct: false, explain: 'DHCP issues IP lease configurations to network endpoints.' },
          { text: 'ICMP (Control Message Protocol)', correct: false, explain: 'ICMP provides error reporting and diagnostic packets (such as ping echo requests).' }
        ]
      },
      {
        domain: 'Cisco CCNA // VLAN Trunking',
        question: 'Which industry standard protocol inserts a 4-byte tag into an Ethernet frame to support multiple VLANs over a trunk link?',
        options: [
          { text: 'IEEE 802.1Q', correct: true, explain: 'Correct! IEEE 802.1Q inserts a 4-byte tag (including a 12-bit VLAN ID allowing 4094 VLANs) directly into the frame header.' },
          { text: 'Cisco ISL', correct: false, explain: 'ISL (Inter-Switch Link) was Cisco proprietary and fully encapsulated the frame; 802.1Q is the universal open standard.' },
          { text: 'IEEE 802.1D', correct: false, explain: '802.1D defines Spanning Tree Protocol (STP) to eliminate switching loops.' },
          { text: 'IEEE 802.1X', correct: false, explain: '802.1X defines port-based network authentication and access control.' }
        ]
      }
    ];

    let currentDrillIndex = 0;
    let currentScore = 0;
    let drillAnswered = false;

    function renderDrill() {
      const d = drills[currentDrillIndex];
      drillAnswered = false;

      document.getElementById('drill-domain').textContent = d.domain;
      document.getElementById('drill-step').textContent = `Drill ${currentDrillIndex + 1} of ${drills.length}`;
      document.getElementById('drill-question').textContent = d.question;

      const feedback = document.getElementById('drill-feedback');
      feedback.classList.add('hidden');

      const container = document.getElementById('drill-options');
      container.innerHTML = '';

      d.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left p-3.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:bg-slate-800 text-slate-200 text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-between';
        btn.innerHTML = `<span>${opt.text}</span><span class="text-xs font-mono text-slate-500">[${String.fromCharCode(65 + idx)}]</span>`;

        btn.addEventListener('click', () => {
          if (drillAnswered) return;
          drillAnswered = true;

          const fbIcon = document.getElementById('feedback-icon');
          const fbTitle = document.getElementById('feedback-title');
          const fbText = document.getElementById('feedback-text');

          feedback.classList.remove('hidden');

          if (opt.correct) {
            currentScore++;
            document.getElementById('drill-score').textContent = `Score: ${currentScore}`;
            btn.className = 'w-full text-left p-3.5 rounded-lg border border-emerald-500 bg-emerald-950/40 text-emerald-300 text-xs sm:text-sm font-medium flex items-center justify-between';
            fbIcon.textContent = '✓';
            fbTitle.className = 'block font-semibold text-emerald-400';
            fbTitle.textContent = 'Correct Answer!';
          } else {
            btn.className = 'w-full text-left p-3.5 rounded-lg border border-rose-500 bg-rose-950/40 text-rose-300 text-xs sm:text-sm font-medium flex items-center justify-between';
            fbIcon.textContent = '✕';
            fbTitle.className = 'block font-semibold text-rose-400';
            fbTitle.textContent = 'Incorrect Choice';
          }
          fbText.textContent = opt.explain;
        });

        container.appendChild(btn);
      });
    }

    document.getElementById('drill-next-btn')?.addEventListener('click', () => {
      currentDrillIndex = (currentDrillIndex + 1) % drills.length;
      renderDrill();
    });

    renderDrill();

    // INTERACTIVE LAB WORKBENCH SWITCHER
    const labTabs = document.querySelectorAll('.lab-tab');
    labTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const labId = tab.dataset.labId;
        const index = Number(tab.dataset.labIndex);
        const lab = labs[index];
        const detail = labDetails[labId];

        // Update active class
        labTabs.forEach((t) => {
          t.classList.remove('active', 'bg-[var(--bg-elevated)]', 'border-[var(--accent)]', 'shadow-md');
          t.classList.add('bg-[var(--bg-subtle)]', 'border-[var(--line)]');
        });
        tab.classList.add('active', 'bg-[var(--bg-elevated)]', 'border-[var(--accent)]', 'shadow-md');
        tab.classList.remove('bg-[var(--bg-subtle)]', 'border-[var(--line)]');

        // Update active lab display
        document.getElementById('active-lab-category').textContent = lab.category;
        document.getElementById('active-lab-name').textContent = lab.name;
        document.getElementById('active-lab-id').textContent = lab.id;
        document.getElementById('active-lab-rationale').textContent = detail ? detail.rationale : lab.description;
        document.getElementById('active-lab-map').textContent = detail ? detail.map : 'Topology map loading...';
        document.getElementById('active-lab-verify').textContent = detail ? detail.verify : '';

        // Protocols
        const protoContainer = document.getElementById('active-lab-protocols');
        protoContainer.innerHTML = '';
        lab.protocols.forEach((p) => {
          const pill = document.createElement('span');
          pill.className = 'tech-pill font-mono';
          pill.textContent = p;
          protoContainer.appendChild(pill);
        });
      });
    });

    // Copy command button
    const copyBtn = document.getElementById('copy-cmd-btn');
    copyBtn?.addEventListener('click', async () => {
      const code = document.getElementById('active-lab-verify')?.textContent;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const textSpan = document.getElementById('copy-btn-text');
        if (textSpan) {
          textSpan.textContent = '✓ Copied!';
          setTimeout(() => {
            textSpan.textContent = 'Copy Command';
          }, 2000);
        }
      } catch (e) {
        console.error('Clipboard copy failed', e);
      }
    });
  </script>
</BaseLayout>
