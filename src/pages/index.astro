<script>
  // 1. Sonoma Viewport vs. Privacy Schematic Switcher
  const sonomaTabs = document.querySelectorAll<HTMLButtonElement>('[data-sonoma-tab]');
  const sonomaUiPanel = document.getElementById('sonoma-panel-ui');
  const sonomaArchPanel = document.getElementById('sonoma-panel-arch');

  sonomaTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-sonoma-tab');
      sonomaTabs.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('bg-[var(--text-primary)]', active);
        b.classList.toggle('text-[var(--bg-surface)]', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('text-[var(--text-muted)]', !active);
      });
      if (mode === 'ui') {
        sonomaUiPanel?.classList.remove('hidden');
        sonomaArchPanel?.classList.add('hidden');
      } else {
        sonomaUiPanel?.classList.add('hidden');
        sonomaArchPanel?.classList.remove('hidden');
      }
    });
  });

  // 2. CertForge Visual vs CLI Drills Switcher
  const certforgeModes = document.querySelectorAll<HTMLButtonElement>('[data-certforge-mode]');
  const certforgeVisual = document.getElementById('certforge-panel-visual');
  const certforgeDrills = document.getElementById('certforge-panel-drills');

  certforgeModes.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-certforge-mode');
      certforgeModes.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('bg-[var(--text-primary)]', active);
        b.classList.toggle('text-[var(--bg-surface)]', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('text-[var(--text-muted)]', !active);
      });
      if (mode === 'visual') {
        certforgeVisual?.classList.remove('hidden');
        certforgeDrills?.classList.add('hidden');
      } else {
        certforgeVisual?.classList.add('hidden');
        certforgeDrills?.classList.remove('hidden');
      }
    });
  });

  // 3. Interactive 7-Lab Topology Blueprint Selector
  const labNodes = document.querySelectorAll<HTMLButtonElement>('[data-lab-node]');
  const labRows = document.querySelectorAll<HTMLElement>('[data-lab-row]');
  const activeLabIndicator = document.getElementById('active-lab-indicator');
  const inspectorTitle = document.getElementById('inspector-lab-title');
  const inspectorDesc = document.getElementById('inspector-lab-desc');
  const inspectorProto = document.getElementById('inspector-lab-proto');

  function selectLab(labId: string) {
    let selectedBtn: HTMLButtonElement | null = null;
    labNodes.forEach((btn) => {
      const isMatch = btn.getAttribute('data-lab-node') === labId;
      if (isMatch) selectedBtn = btn;
      btn.classList.toggle('border-[var(--signal)]', isMatch);
      btn.classList.toggle('bg-[var(--signal-soft)]', isMatch);
      btn.classList.toggle('border-[var(--rule-hairline)]', !isMatch);
      btn.classList.toggle('bg-[var(--bg-panel)]/50', !isMatch);
    });

    labRows.forEach((row) => {
      const isMatch = row.getAttribute('data-lab-row') === labId;
      row.setAttribute('data-active', String(isMatch));
    });

    if (selectedBtn) {
      const name = (selectedBtn as HTMLButtonElement).getAttribute('data-lab-name') || '';
      const desc = (selectedBtn as HTMLButtonElement).getAttribute('data-lab-desc') || '';
      const proto = (selectedBtn as HTMLButtonElement).getAttribute('data-lab-proto') || '';
      if (activeLabIndicator)
        activeLabIndicator.textContent = `ACTIVE: ${labId} — ${name.toUpperCase()}`;
      if (inspectorTitle) inspectorTitle.textContent = name;
      if (inspectorDesc) inspectorDesc.textContent = desc;
      if (inspectorProto) inspectorProto.textContent = proto;
    }
  }

  labNodes.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-lab-node');
      if (id) selectLab(id);
    });
  });

  labRows.forEach((row) => {
    row.addEventListener('click', () => {
      const id = row.getAttribute('data-lab-row');
      if (id) selectLab(id);
    });
    row.addEventListener('mouseenter', () => {
      const id = row.getAttribute('data-lab-row');
      if (id) selectLab(id);
    });
  });

  // 4. Essay Thesis Breakdown Drawer
  const essayBtn = document.getElementById('toggle-essay-briefing');
  const essayPanel = document.getElementById('essay-briefing-panel');

  essayBtn?.addEventListener('click', () => {
    if (!essayPanel) return;
    const isHidden = essayPanel.classList.toggle('hidden');
    essayBtn.setAttribute('aria-expanded', String(!isHidden));
    essayBtn.textContent = isHidden ? '[+ READ THESIS BREAKDOWN]' : '[— COLLAPSE BREAKDOWN]';
  });
</script>
