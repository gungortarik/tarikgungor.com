---
import '../styles/global.css';
import { siteContent } from '../data/siteContent';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeStructuredPerson?: boolean;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
  canonicalPath = '/',
  includeStructuredPerson = true,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteContent.meta.url).toString();
const ogImageUrl = new URL('/assets/opengraph-image.svg', siteContent.meta.url).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteContent.meta.name,
  jobTitle: siteContent.resume.headline,
  description: siteContent.resume.summary,
  url: siteContent.meta.url,
  email: siteContent.meta.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  sameAs: [siteContent.meta.linkedin, siteContent.meta.github],
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'George Brown College' },
    { '@type': 'EducationalOrganization', name: 'British Columbia Institute of Technology' },
  ],
  knowsAbout: [
    'Windows 10/11',
    'Active Directory',
    'Microsoft 365',
    'TCP/IP',
    'DNS',
    'DHCP',
    'VPN',
    'Network Segmentation',
    'Endpoint Management',
    'Hyper-V',
    'Ubuntu Linux',
    'TypeScript',
    'Next.js',
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme');
        const meta = document.querySelector('meta[name="color-scheme"]');
        const isLight = stored === 'light';
        if (meta) {
          meta.content = isLight ? 'light' : 'dark';
        }
        document.documentElement.classList.toggle('dark', !isLight);
      } catch {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteContent.meta.name} />
    <meta name="author" content={siteContent.meta.name} />
    <meta name="creator" content={siteContent.meta.name} />
    <meta name="publisher" content={siteContent.meta.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph & Twitter Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteContent.meta.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tarik Gungor — Building systems. Learning continuously. Living intentionally." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/icons/tarik-gungor-favicon.png" />

    <!-- Self-hosted High-Performance Font Preloads -->
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    {
      includeStructuredPerson && (
        <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
      )
    }
  </head>
  <body
    class="relative min-h-screen flex flex-col selection:bg-[var(--signal)] selection:text-slate-950 antialiased"
  >
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Brittany Chiang Style Interactive Cursor Spotlight -->
    <div class="pointer-spotlight print:hidden" aria-hidden="true"></div>

    <!-- Top Reading Progress Line -->
    <div
      class="fixed top-0 left-0 right-0 h-[2px] z-50 pointer-events-none print:hidden"
      aria-hidden="true"
    >
      <div
        id="scroll-progress-bar"
        class="h-full w-full origin-left scale-x-0 bg-gradient-to-r from-[var(--signal)] via-[var(--signal-secondary)] to-[var(--signal-emerald)] transition-none"
      >
      </div>
    </div>

    <div class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Fullscreen Interactive Image Lightbox Modal -->
    <dialog
      id="lightbox-dialog"
      class="fixed inset-0 m-auto p-4 max-w-[94vw] max-h-[92vh] bg-transparent border-none outline-none z-50 backdrop:bg-slate-950/85 backdrop:backdrop-blur-md"
      aria-label="Image Zoom Viewport"
    >
      <div class="tactile-card p-3 max-w-[1100px] mx-auto shadow-2xl">
        <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--rule-hairline)] text-xs font-mono-spec">
          <span id="lightbox-caption" class="text-[var(--text-primary)] font-medium">Preview</span>
          <button
            type="button"
            id="close-lightbox"
            class="px-2.5 py-1 rounded-md border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
          >
            Esc / Close
          </button>
        </div>
        <div class="p-2 overflow-auto max-h-[80vh] flex items-center justify-center">
          <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-w-full max-h-[76vh] object-contain rounded-lg"
          />
        </div>
      </div>
    </dialog>

    <CommandPalette />

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Josh Comeau Style Web Audio Tactile Sound Engine (Zero external audio files)
      let soundEnabled = true;
      try {
        const storedSound = localStorage.getItem('tactile-sound');
        if (storedSound !== null) {
          soundEnabled = storedSound === 'true';
        }
      } catch {}

      let audioCtx: AudioContext | null = null;

      function playTactileSound(type: 'click' | 'switch' | 'pop' = 'click') {
        if (!soundEnabled) return;
        try {
          if (!audioCtx) {
            const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
            audioCtx = new AudioContextClass();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.connect(gain);
          gain.connect(audioCtx.destination);

          if (type === 'switch') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(320, now);
            osc.frequency.exponentialRampToValueAtTime(640, now + 0.045);
            gain.gain.setValueAtTime(0.06, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
            osc.start(now);
            osc.stop(now + 0.055);
          } else if (type === 'pop') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(240, now);
            osc.frequency.exponentialRampToValueAtTime(520, now + 0.035);
            gain.gain.setValueAtTime(0.05, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
            osc.start(now);
            osc.stop(now + 0.045);
          } else {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(480, now);
            osc.frequency.exponentialRampToValueAtTime(180, now + 0.025);
            gain.gain.setValueAtTime(0.04, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
            osc.start(now);
            osc.stop(now + 0.032);
          }
        } catch {}
      }

      (window as unknown as { playTactileSound: typeof playTactileSound }).playTactileSound = playTactileSound;

      function updateSoundUI() {
        document.querySelectorAll<HTMLElement>('[data-sound-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(soundEnabled));
          const onIcon = btn.querySelector('[data-sound-on]');
          const offIcon = btn.querySelector('[data-sound-off]');
          if (onIcon && offIcon) {
            onIcon.classList.toggle('hidden', !soundEnabled);
            offIcon.classList.toggle('hidden', soundEnabled);
          }
        });
      }

      updateSoundUI();

      document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          soundEnabled = !soundEnabled;
          try {
            localStorage.setItem('tactile-sound', String(soundEnabled));
          } catch {}
          updateSoundUI();
          if (soundEnabled) playTactileSound('switch');
        });
      });

      // 2. Brittany Chiang Pointer Spotlight Tracking
      if (!reducedMotion) {
        window.addEventListener(
          'pointermove',
          (e) => {
            document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
            document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
          },
          { passive: true }
        );
      }

      // 3. Dennis Snellenberg Style Magnetic Elements
      if (!reducedMotion) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const relX = e.clientX - (rect.left + rect.width / 2);
            const relY = e.clientY - (rect.top + rect.height / 2);
            gsap.to(el, {
              x: relX * 0.22,
              y: relY * 0.22,
              duration: 0.35,
              ease: 'power2.out',
            });
          });
          el.addEventListener('mouseleave', () => {
            gsap.to(el, {
              x: 0,
              y: 0,
              duration: 0.65,
              ease: 'elastic.out(1, 0.4)',
            });
          });
        });
      }

      // 4. Lenis Smooth Scroll + GSAP Ticker Sync
      let lenis: Lenis | null = null;
      if (!reducedMotion) {
        lenis = new Lenis({
          duration: 1.1,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.95,
          touchMultiplier: 1.5,
        });

        lenis.on('scroll', () => {
          ScrollTrigger.update();
        });

        gsap.ticker.add((time) => {
          lenis?.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
      }

      // Smooth Anchor Navigation
      function scrollToTarget(targetSelector: string) {
        const targetEl = document.querySelector<HTMLElement>(targetSelector);
        if (!targetEl) return;
        playTactileSound('pop');
        if (lenis) {
          lenis.scrollTo(targetEl, { offset: -72, duration: 1.1 });
        } else {
          targetEl.scrollIntoView({ behavior: 'smooth' });
        }
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const targetId = anchor.getAttribute('href');
          if (!targetId || targetId === '#') return;
          const targetEl = document.querySelector<HTMLElement>(targetId);
          if (!targetEl) return;

          e.preventDefault();
          scrollToTarget(targetId);
          history.pushState(null, '', targetId);
        });
      });

      // 5. Top Progress Rail
      const progressBar = document.getElementById('scroll-progress-bar');
      if (progressBar && !reducedMotion) {
        gsap.to(progressBar, {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: document.documentElement,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.1,
          },
        });
      }

      // 6. GSAP Editorial Reveals & Scroll Choreography
      if (!reducedMotion) {
        const heroLines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
        const heroSpecs = gsap.utils.toArray<HTMLElement>('[data-hero-spec]');

        if (heroLines.length > 0 || heroSpecs.length > 0) {
          const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

          if (heroLines.length > 0) {
            tl.fromTo(
              heroLines,
              { yPercent: 105 },
              { yPercent: 0, duration: 1.0, stagger: 0.08 },
              0.05
            );
          }

          if (heroSpecs.length > 0) {
            tl.fromTo(
              heroSpecs,
              { y: 18, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.75, stagger: 0.06, ease: 'power3.out' },
              0.2
            );
          }
        }

        gsap.utils.toArray<HTMLElement>('[data-stagger-group]').forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('[data-stagger-item]');
          if (items.length === 0) return;

          gsap.fromTo(
            items,
            { y: 24, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.65,
              stagger: 0.07,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: group,
                start: 'top 86%',
                toggleActions: 'play none none none',
              },
            }
          );
        });
      }

      // 7. Theme Toggle Synchronization with Animated Sun/Moon Icons
      function applyColorScheme(scheme: 'light' | 'dark') {
        const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
        const isDark = scheme === 'dark';
        if (meta) {
          meta.content = scheme;
        }
        document.documentElement.classList.toggle('dark', isDark);

        document.querySelectorAll<HTMLElement>('[data-theme-sun]').forEach((el) => {
          el.classList.toggle('hidden', !isDark);
        });
        document.querySelectorAll<HTMLElement>('[data-theme-moon]').forEach((el) => {
          el.classList.toggle('hidden', isDark);
        });
      }

      const initialDark = document.documentElement.classList.contains('dark');
      applyColorScheme(initialDark ? 'dark' : 'light');

      function toggleTheme() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        const nextScheme = isCurrentlyDark ? 'light' : 'dark';
        try {
          localStorage.setItem('color-scheme', nextScheme);
        } catch {}
        playTactileSound('switch');
        applyColorScheme(nextScheme);
      }

      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', toggleTheme);
      });

      // 8. Keyboard Shortcuts with Dialog Protection
      const sectionKeyMap: Record<string, string> = {
        '1': '#right-now',
        '2': '#projects',
        '3': '#labs-showcase',
        '4': '#notes',
        '5': '#path',
        '6': '#resume',
      };

      window.addEventListener('keydown', (e) => {
        const tag = (e.target as HTMLElement | null)?.tagName?.toLowerCase();
        const cmdDialog = document.getElementById('command-dialog') as HTMLDialogElement | null;
        const lightboxDialog = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;

        if (
          tag === 'input' ||
          tag === 'textarea' ||
          cmdDialog?.open ||
          lightboxDialog?.open ||
          e.metaKey ||
          e.ctrlKey ||
          e.altKey
        ) {
          return;
        }

        if (e.key.toLowerCase() === 't') {
          e.preventDefault();
          toggleTheme();
        } else if (e.key in sectionKeyMap) {
          const target = sectionKeyMap[e.key];
          if (document.querySelector(target)) {
            e.preventDefault();
            scrollToTarget(target);
          }
        }
      });

      // 9. Lightbox Zoom Handler
      const lightbox = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      const closeLightboxBtn = document.getElementById('close-lightbox');

      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const src = trigger.getAttribute('data-lightbox-src');
          const alt = trigger.getAttribute('data-lightbox-alt') || 'Preview';
          if (!src || !lightbox || !lightboxImg) return;
          playTactileSound('pop');
          lightboxImg.src = src;
          lightboxImg.alt = alt;
          if (lightboxCaption) lightboxCaption.textContent = alt;
          lightbox.showModal();
        });
      });

      closeLightboxBtn?.addEventListener('click', () => {
        lightbox?.close();
      });

      lightbox?.addEventListener('click', (e) => {
        const rect = lightbox.getBoundingClientRect();
        const outside =
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom;
        if (outside) lightbox.close();
      });

      // 10. Live Toronto Clock
      function updateTorontoTime() {
        try {
          const formatter = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'America/Toronto',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
          const formatted = formatter.format(new Date());
          document.querySelectorAll<HTMLElement>('[data-toronto-clock]').forEach((el) => {
            el.textContent = `${formatted} EDT`;
          });
        } catch {}
      }
      updateTorontoTime();
      setInterval(updateTorontoTime, 1000);
    </script>
  </body>
</html>
