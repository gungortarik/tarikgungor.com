---
import '../styles/global.css';
import { siteContent } from '../data/siteContent';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeStructuredPerson?: boolean;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
  canonicalPath = '/',
  includeStructuredPerson = true,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteContent.meta.url).toString();
const ogImageUrl = new URL('/assets/opengraph-image.svg', siteContent.meta.url).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteContent.meta.name,
  jobTitle: siteContent.resume.headline,
  description: siteContent.resume.summary,
  url: siteContent.meta.url,
  email: siteContent.meta.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  sameAs: [siteContent.meta.linkedin, siteContent.meta.github],
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'George Brown College' },
    { '@type': 'EducationalOrganization', name: 'British Columbia Institute of Technology' },
  ],
  knowsAbout: [
    'Windows 10/11',
    'Active Directory',
    'Microsoft 365',
    'TCP/IP',
    'DNS',
    'DHCP',
    'VPN',
    'Network Segmentation',
    'Endpoint Management',
    'Hyper-V',
    'Ubuntu Linux',
    'TypeScript',
    'Next.js',
  ],
};

const isHome = canonicalPath === '/';
const h = (hash: string) => (isHome ? hash : `/${hash}`);
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#090d16" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteContent.meta.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteContent.meta.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Instant Theme Init Script (Zero FOUT) -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('tg_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    {includeStructuredPerson && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col relative selection:bg-indigo-500 selection:text-white">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Brittany Chiang Spotlight overlay -->
    <div class="spotlight-overlay" aria-hidden="true"></div>

    <!-- Glassmorphic Sticky Header -->
    <header class="sticky top-0 inset-x-0 z-40 backdrop-blur-md bg-[var(--bg)]/80 border-b border-[var(--line)] transition-colors duration-300 print:hidden">
      <div class="wrap flex items-center justify-between h-20 text-[14.5px]">
        <!-- Brand / Identity -->
        <a href="/" class="group flex items-center gap-3" aria-label="Tarik Gungor — home">
          <div class="w-9 h-9 rounded-xl bg-[var(--bg-subtle)] border border-[var(--line)] flex items-center justify-center font-heading font-semibold text-sm tracking-tight text-[var(--ink)] group-hover:border-[var(--accent)] transition-colors">
            TG
          </div>
          <div class="flex flex-col">
            <span class="font-heading font-medium tracking-tight text-[var(--ink)] text-[15px] group-hover:text-[var(--accent)] transition-colors">
              Tarik Gungor
            </span>
            <div class="flex items-center gap-1.5 text-[11.5px] text-[var(--muted)]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Toronto, Canada</span>
            </div>
          </div>
        </a>

        <!-- Center Nav -->
        <nav aria-label="Main" class="hidden md:flex items-center gap-8 font-medium">
          <a href={h('#projects')} class="nav-item">Projects</a>
          <a href={h('#workbench')} class="nav-item">Lab Studio</a>
          <a href={h('#experience')} class="nav-item">Experience</a>
          <a href={h('#writing')} class="nav-item">Writing</a>
          <a href="/resume" class="nav-item" aria-current={canonicalPath === '/resume' ? 'page' : undefined}>Resume</a>
        </nav>

        <!-- Right: Actions & Theme Toggle -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle Button -->
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle theme"
            class="w-10 h-10 rounded-xl bg-[var(--bg-subtle)] border border-[var(--line)] flex items-center justify-center text-[var(--ink-2)] hover:text-[var(--ink)] hover:border-[var(--line-strong)] transition-all cursor-pointer"
          >
            <!-- Sun icon (for dark mode) -->
            <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon (for light mode) -->
            <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Contact pill -->
          <a
            href={h('#contact')}
            data-magnetic="0.25"
            class="hidden sm:inline-flex btn-primary !py-2 !px-4 !text-xs font-medium"
          >
            <span data-magnetic-inner>Get in touch</span>
          </a>

          <!-- Mobile Menu Open -->
          <button
            type="button"
            data-menu-open
            aria-label="Open mobile navigation"
            class="md:hidden w-10 h-10 rounded-xl bg-[var(--bg-subtle)] border border-[var(--line)] flex flex-col items-center justify-center gap-1.5 cursor-pointer text-[var(--ink)]"
          >
            <span class="w-4 h-0.5 bg-current rounded-full"></span>
            <span class="w-4 h-0.5 bg-current rounded-full"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Slide-out menu for mobile -->
    <div id="menu-overlay" class="fixed inset-0 z-[55] bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 print:hidden backdrop-blur-sm"></div>
    <aside
      id="menu-panel"
      aria-label="Mobile Menu"
      class="fixed inset-y-0 right-0 z-[60] w-[min(85vw,360px)] bg-[var(--bg-elevated)] border-l border-[var(--line)] text-[var(--ink)] translate-x-full transition-transform duration-400 ease-[cubic-bezier(.16,1,.3,1)] flex flex-col justify-between p-8 print:hidden"
    >
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[var(--line)]">
          <span class="font-heading font-semibold text-sm">Navigation</span>
          <button type="button" data-menu-close class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--muted)] hover:text-[var(--ink)] cursor-pointer text-sm">✕</button>
        </div>
        <nav class="mt-8 flex flex-col gap-4 font-heading text-xl">
          <a href="/" data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Home</a>
          <a href={h('#projects')} data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Projects</a>
          <a href={h('#workbench')} data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Lab Studio</a>
          <a href={h('#experience')} data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Experience</a>
          <a href={h('#writing')} data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Writing</a>
          <a href="/resume" data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Resume</a>
          <a href={h('#contact')} data-menu-link class="py-2 hover:text-[var(--accent)] transition-colors">Contact</a>
        </nav>
      </div>
      <div class="pt-6 border-t border-[var(--line)] text-xs text-[var(--muted)] space-y-3">
        <div class="flex items-center justify-between">
          <span>Theme</span>
          <button type="button" id="theme-toggle-mobile" class="px-3 py-1.5 rounded-lg border border-[var(--line)] text-[var(--ink)]">
            Toggle Light/Dark
          </button>
        </div>
        <div class="flex gap-4 pt-2">
          <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">GitHub</a>
          <a href={siteContent.meta.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">LinkedIn</a>
          <a href={`mailto:${siteContent.meta.email}`} class="hover:text-[var(--ink)]">Email</a>
        </div>
      </div>
    </aside>

    <!-- Main Viewport Content -->
    <div class="flex-1 flex flex-col relative z-10">
      <slot />
    </div>

    <!-- Image lightbox modal -->
    <dialog
      id="lightbox-dialog"
      class="m-auto p-0 max-w-[95vw] max-h-[92vh] bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm"
      aria-label="Image preview"
    >
      <div class="relative bg-[var(--bg-elevated)] border border-[var(--line)] rounded-2xl p-3 shadow-2xl">
        <button
          type="button"
          id="close-lightbox"
          class="absolute -top-10 right-0 text-white/80 hover:text-white text-sm cursor-pointer px-3 py-1 bg-black/60 rounded-full"
        >
          Close ✕
        </button>
        <img id="lightbox-img" src="" alt="" class="max-w-[92vw] max-h-[82vh] object-contain rounded-xl" />
      </div>
    </dialog>

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scroll via Lenis
      let lenis: Lenis | null = null;
      if (!reduced) {
        lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis?.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);
      }
      (window as unknown as { __lenis: Lenis | null }).__lenis = lenis;

      // Mouse Spotlight tracker (Brittany Chiang style)
      window.addEventListener('pointermove', (e) => {
        document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
        document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
      }, { passive: true });

      // Theme Toggle Logic
      const toggleTheme = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('tg_theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      };
      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

      // Mobile Menu Drawer
      const panel = document.getElementById('menu-panel');
      const overlay = document.getElementById('menu-overlay');
      const setMenu = (open: boolean) => {
        panel?.classList.toggle('translate-x-full', !open);
        overlay?.classList.toggle('opacity-0', !open);
        overlay?.classList.toggle('pointer-events-none', !open);
        if (open) lenis?.stop();
        else lenis?.start();
      };
      document.querySelectorAll('[data-menu-open]').forEach((b) => b.addEventListener('click', () => setMenu(true)));
      document.querySelectorAll('[data-menu-close], [data-menu-link]').forEach((b) =>
        b.addEventListener('click', () => setMenu(false))
      );
      overlay?.addEventListener('click', () => setMenu(false));
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // Anchor links via Lenis
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href') || '';
          const hash = href.replace(/^\//, '');
          if (href.startsWith('/#') && location.pathname !== '/') return;
          const target = hash.length > 1 ? document.querySelector<HTMLElement>(hash) : null;
          if (!target) return;
          e.preventDefault();
          if (lenis) lenis.scrollTo(target, { offset: -80, duration: 1.2 });
          else target.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', hash);
        });
      });

      // Magnetic button physics (Dennis Snellenberg touch)
      if (!reduced && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          const strength = Number(el.dataset.magnetic) || 0.3;
          const inner = el.querySelector<HTMLElement>('[data-magnetic-inner]');
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = e.clientX - (r.left + r.width / 2);
            const y = e.clientY - (r.top + r.height / 2);
            gsap.to(el, { x: x * strength, y: y * strength, duration: 0.5, ease: 'power2.out' });
            if (inner) gsap.to(inner, { x: x * strength * 0.4, y: y * strength * 0.4, duration: 0.5, ease: 'power2.out' });
          });
          el.addEventListener('mouseleave', () => {
            gsap.to(el, { x: 0, y: 0, duration: 0.8, ease: 'elastic.out(1, 0.4)' });
            if (inner) gsap.to(inner, { x: 0, y: 0, duration: 0.8, ease: 'elastic.out(1, 0.4)' });
          });
        });
      }

      // Lightbox preview for screenshots
      const lb = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((t) =>
        t.addEventListener('click', (e) => {
          e.preventDefault();
          if (!lb || !lbImg) return;
          lbImg.src = t.dataset.lightboxSrc || '';
          lbImg.alt = t.dataset.lightboxAlt || '';
          lb.showModal();
        })
      );
      document.getElementById('close-lightbox')?.addEventListener('click', () => lb?.close());
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) lb.close();
      });

      // Toronto Live Clock
      const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Toronto',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true,
      });
      const tick = () =>
        document.querySelectorAll<HTMLElement>('[data-toronto-clock]').forEach((el) => {
          el.textContent = fmt.format(new Date());
        });
      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
