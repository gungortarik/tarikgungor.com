---
import '../styles/global.css';
import { siteContent } from '../data/siteContent';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeStructuredPerson?: boolean;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
  canonicalPath = '/',
  includeStructuredPerson = true,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteContent.meta.url).toString();
const ogImageUrl = new URL('/assets/opengraph-image.svg', siteContent.meta.url).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteContent.meta.name,
  jobTitle: siteContent.resume.headline,
  description: siteContent.resume.summary,
  url: siteContent.meta.url,
  email: siteContent.meta.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  sameAs: [siteContent.meta.linkedin, siteContent.meta.github],
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'George Brown College' },
    { '@type': 'EducationalOrganization', name: 'British Columbia Institute of Technology' },
  ],
  knowsAbout: [
    'Windows 10/11',
    'Active Directory',
    'Microsoft 365',
    'TCP/IP',
    'DNS',
    'DHCP',
    'VPN',
    'Network Segmentation',
    'Endpoint Management',
    'Hyper-V',
    'Ubuntu Linux',
    'TypeScript',
    'Next.js',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme');
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) {
          meta.content = stored ?? 'light dark';
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || ((!stored || stored === 'light dark') && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);
      } catch {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteContent.meta.name} />
    <meta name="author" content={siteContent.meta.name} />
    <meta name="creator" content={siteContent.meta.name} />
    <meta name="publisher" content={siteContent.meta.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph & Twitter Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteContent.meta.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tarik Gungor — Building systems. Learning continuously. Living intentionally." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/icons/tarik-gungor-favicon.png" />

    <!-- Self-hosted High-Performance Font Preloads -->
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    {
      includeStructuredPerson && (
        <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
      )
    }
  </head>
  <body
    class="min-h-screen flex flex-col selection:bg-[var(--signal)] selection:text-white antialiased"
  >
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Subtle Tactile Architectural Paper/Aluminum Grain -->
    <div class="tactile-grain fixed inset-0 pointer-events-none z-30 print:hidden" aria-hidden="true"></div>

    <!-- Top 2px Industrial Signal Progress Rail -->
    <div
      class="fixed top-0 left-0 right-0 h-[2px] z-50 pointer-events-none print:hidden"
      aria-hidden="true"
    >
      <div
        id="scroll-progress-bar"
        class="h-full w-full origin-left scale-x-0 bg-[var(--signal)] transition-none"
      >
      </div>
    </div>

    <slot />

    <!-- Fullscreen Interactive Image / Blueprint Lightbox Modal -->
    <dialog
      id="lightbox-dialog"
      class="fixed inset-0 m-auto p-4 max-w-[94vw] max-h-[92vh] bg-transparent border-none outline-none z-50 backdrop:bg-black/85 backdrop:backdrop-blur-sm"
      aria-label="Image Zoom Viewport"
    >
      <div class="border border-[var(--rule-strong)] bg-[var(--bg-surface)] p-2 font-mono-spec max-w-[1100px] mx-auto shadow-2xl">
        <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--rule-hairline)] text-xs">
          <span id="lightbox-caption" class="text-[var(--text-primary)] font-semibold">VIEWPORT INSPECTOR</span>
          <button
            type="button"
            id="close-lightbox"
            class="px-2 py-0.5 border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] cursor-pointer"
          >
            [ESC / CLOSE]
          </button>
        </div>
        <div class="p-2 overflow-auto max-h-[80vh] flex items-center justify-center bg-black/5">
          <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-w-full max-h-[76vh] object-contain"
          />
        </div>
      </div>
    </dialog>

    <CommandPalette />

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Lenis Smooth Scroll + GSAP Ticker Sync
      let lenis: Lenis | null = null;
      if (!reducedMotion) {
        lenis = new Lenis({
          duration: 1.1,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.95,
          touchMultiplier: 1.5,
        });

        lenis.on('scroll', ({ scroll, progress }: { scroll: number; progress: number }) => {
          ScrollTrigger.update();
          const pct = String(Math.round((progress || 0) * 100)).padStart(3, '0');
          const ypos = String(Math.round(scroll || 0)).padStart(4, '0');
          document.querySelectorAll<HTMLElement>('[data-scroll-pct]').forEach((el) => {
            el.textContent = `${pct}%`;
          });
          document.querySelectorAll<HTMLElement>('[data-scroll-ypos]').forEach((el) => {
            el.textContent = `Y: ${ypos}PX`;
          });
        });

        gsap.ticker.add((time) => {
          lenis?.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
      }

      // Smooth Anchor Navigation
      function scrollToTarget(targetSelector: string) {
        const targetEl = document.querySelector<HTMLElement>(targetSelector);
        if (!targetEl) return;
        if (lenis) {
          lenis.scrollTo(targetEl, { offset: -54, duration: 1.1 });
        } else {
          targetEl.scrollIntoView({ behavior: 'smooth' });
        }
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const targetId = anchor.getAttribute('href');
          if (!targetId || targetId === '#') return;
          const targetEl = document.querySelector<HTMLElement>(targetId);
          if (!targetEl) return;

          e.preventDefault();
          scrollToTarget(targetId);
          history.pushState(null, '', targetId);
        });
      });

      // 2. Top Progress Rail
      const progressBar = document.getElementById('scroll-progress-bar');
      if (progressBar && !reducedMotion) {
        gsap.to(progressBar, {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: document.documentElement,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.1,
          },
        });
      }

      // 3. GSAP Editorial Reveals & Scroll Choreography
      if (!reducedMotion) {
        const heroLines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
        const heroSpecs = gsap.utils.toArray<HTMLElement>('[data-hero-spec]');

        if (heroLines.length > 0 || heroSpecs.length > 0) {
          const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

          if (heroLines.length > 0) {
            tl.fromTo(
              heroLines,
              { yPercent: 110 },
              { yPercent: 0, duration: 1.05, stagger: 0.09 },
              0.05
            );
          }

          if (heroSpecs.length > 0) {
            tl.fromTo(
              heroSpecs,
              { y: 18, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.75, stagger: 0.06, ease: 'power3.out' },
              0.22
            );
          }
        }

        gsap.utils.toArray<HTMLElement>('[data-reveal-heading]').forEach((heading) => {
          gsap.fromTo(
            heading,
            { yPercent: 105 },
            {
              yPercent: 0,
              duration: 0.9,
              ease: 'expo.out',
              scrollTrigger: {
                trigger: heading,
                start: 'top 90%',
                toggleActions: 'play none none none',
              },
            }
          );
        });

        gsap.utils.toArray<HTMLElement>('[data-stagger-group]').forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('[data-stagger-item]');
          if (items.length === 0) return;

          gsap.fromTo(
            items,
            { y: 22, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.65,
              stagger: 0.06,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: group,
                start: 'top 86%',
                toggleActions: 'play none none none',
              },
            }
          );
        });

        gsap.utils.toArray<HTMLElement>('[data-parallax-img]').forEach((img) => {
          gsap.fromTo(
            img,
            { yPercent: -4, scale: 1.04 },
            {
              yPercent: 4,
              scale: 1.04,
              ease: 'none',
              scrollTrigger: {
                trigger: img.parentElement || img,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            }
          );
        });
      }

      // 5. Theme Toggle Synchronization with <meta name="color-scheme">
      function applyColorScheme(scheme: 'light' | 'dark' | 'light dark') {
        const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
        if (meta) {
          meta.content = scheme;
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = scheme === 'dark' || (scheme === 'light dark' && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);

        document.querySelectorAll<HTMLElement>('[data-theme-label]').forEach((el) => {
          el.textContent = isDark ? 'DARK' : 'LIGHT';
        });
      }

      applyColorScheme(
        (document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')?.content as
          | 'light'
          | 'dark'
          | 'light dark') || 'light dark'
      );

      function toggleTheme() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        const nextScheme = isCurrentlyDark ? 'light' : 'dark';
        try {
          localStorage.setItem('color-scheme', nextScheme);
        } catch {}
        applyColorScheme(nextScheme);
      }

      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', toggleTheme);
      });

      window.addEventListener('storage', (event) => {
        if (event.key === 'color-scheme') {
          const next = (event.newValue as 'light' | 'dark' | null) ?? 'light dark';
          applyColorScheme(next);
        }
      });

      // 6. Keyboard Shortcuts with Dialog Protection
      const sectionKeyMap: Record<string, string> = {
        '1': '#right-now',
        '2': '#projects',
        '3': '#labs-showcase',
        '4': '#notes',
        '5': '#path',
        '6': '#resume',
      };

      window.addEventListener('keydown', (e) => {
        const tag = (e.target as HTMLElement | null)?.tagName?.toLowerCase();
        const cmdDialog = document.getElementById('command-dialog') as HTMLDialogElement | null;
        const lightboxDialog = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;

        // If typing in input or if a modal is open, do not trigger single-key page jumps
        if (
          tag === 'input' ||
          tag === 'textarea' ||
          cmdDialog?.open ||
          lightboxDialog?.open ||
          e.metaKey ||
          e.ctrlKey ||
          e.altKey
        ) {
          return;
        }

        if (e.key.toLowerCase() === 't') {
          e.preventDefault();
          toggleTheme();
        } else if (e.key in sectionKeyMap) {
          const target = sectionKeyMap[e.key];
          if (document.querySelector(target)) {
            e.preventDefault();
            scrollToTarget(target);
          }
        }
      });

      // 7. Lightbox Zoom Handler for Project Visuals
      const lightbox = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      const closeLightboxBtn = document.getElementById('close-lightbox');

      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const src = trigger.getAttribute('data-lightbox-src');
          const alt = trigger.getAttribute('data-lightbox-alt') || 'Viewport Inspector';
          if (!src || !lightbox || !lightboxImg) return;
          lightboxImg.src = src;
          lightboxImg.alt = alt;
          if (lightboxCaption) lightboxCaption.textContent = `INSPECT // ${alt.toUpperCase()}`;
          lightbox.showModal();
        });
      });

      closeLightboxBtn?.addEventListener('click', () => {
        lightbox?.close();
      });

      lightbox?.addEventListener('click', (e) => {
        const rect = lightbox.getBoundingClientRect();
        const outside =
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom;
        if (outside) lightbox.close();
      });

      // 8. Live Toronto Clock
      function updateTorontoTime() {
        try {
          const formatter = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'America/Toronto',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
          const formatted = formatter.format(new Date());
          document.querySelectorAll<HTMLElement>('[data-toronto-clock]').forEach((el) => {
            el.textContent = `${formatted} TOR`;
          });
        } catch {}
      }
      updateTorontoTime();
      setInterval(updateTorontoTime, 1000);
    </script>
  </body>
</html>
