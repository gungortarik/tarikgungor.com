---
import '../styles/global.css';
import { siteContent } from '../data/siteContent';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeStructuredPerson?: boolean;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
  canonicalPath = '/',
  includeStructuredPerson = true,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteContent.meta.url).toString();
const ogImageUrl = new URL('/assets/opengraph-image.svg', siteContent.meta.url).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteContent.meta.name,
  jobTitle: siteContent.resume.headline,
  description: siteContent.resume.summary,
  url: siteContent.meta.url,
  email: siteContent.meta.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  sameAs: [siteContent.meta.linkedin, siteContent.meta.github],
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'George Brown College' },
    { '@type': 'EducationalOrganization', name: 'British Columbia Institute of Technology' },
  ],
  knowsAbout: [
    'Windows 10/11',
    'Active Directory',
    'Microsoft 365',
    'TCP/IP',
    'DNS',
    'DHCP',
    'VPN',
    'Network Segmentation',
    'Endpoint Management',
    'Hyper-V',
    'Ubuntu Linux',
    'TypeScript',
    'Next.js',
  ],
};

const isHome = canonicalPath === '/';
const h = (hash: string) => (isHome ? hash : `/${hash}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ececec" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteContent.meta.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteContent.meta.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/icons/tarik-gungor-favicon.png" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    {includeStructuredPerson && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Header (sits on top of each page, not sticky) -->
    <header class="absolute top-0 inset-x-0 z-40 print:hidden">
      <div class="wrap flex items-center justify-between h-24 sm:h-28 text-[15px]">
        <a href="/" class="group flex items-center gap-1.5" aria-label="Tarik Gungor — home">
          <span class="inline-block transition-transform duration-700 group-hover:rotate-[360deg]">©</span>
          <span class="relative block h-[1.3em] overflow-hidden">
            <span class="block transition-transform duration-500 ease-[cubic-bezier(.19,1,.22,1)] group-hover:-translate-y-full">
              Tarik Gungor
            </span>
            <span class="absolute left-0 top-full block whitespace-nowrap transition-transform duration-500 ease-[cubic-bezier(.19,1,.22,1)] group-hover:-translate-y-full">
              Toronto, Canada
            </span>
          </span>
        </a>

        <nav aria-label="Main" class="hidden md:flex items-center gap-9">
          <a href={h('#work')} class="nav-link" data-magnetic>Work</a>
          <a href={h('#labs')} class="nav-link" data-magnetic>Labs</a>
          <a href={h('#writing')} class="nav-link" data-magnetic>Writing</a>
          <a href="/resume" class="nav-link" data-magnetic aria-current={canonicalPath === '/resume' ? 'page' : undefined}>Resume</a>
          <a href={h('#contact')} class="nav-link" data-magnetic>Contact</a>
        </nav>

        <button type="button" data-menu-open class="md:hidden flex items-center gap-2 cursor-pointer">
          <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
          Menu
        </button>
      </div>
    </header>

    <!-- Floating round menu button (appears after scrolling) -->
    <button
      type="button"
      id="menu-fab"
      data-menu-open
      aria-label="Open menu"
      class="!fixed top-5 right-5 sm:top-7 sm:right-7 z-50 w-16 h-16 sm:w-[76px] sm:h-[76px] rounded-full bg-[var(--dark)] text-white grid place-items-center scale-0 transition-transform duration-500 ease-[cubic-bezier(.19,1,.22,1)] cursor-pointer btn-fill print:hidden"
    >
      <span class="flex flex-col gap-[7px]">
        <span class="block w-6 h-px bg-white"></span>
        <span class="block w-6 h-px bg-white"></span>
      </span>
    </button>

    <!-- Slide-out menu -->
    <div id="menu-overlay" class="fixed inset-0 z-[55] bg-black/30 opacity-0 pointer-events-none transition-opacity duration-500 print:hidden"></div>
    <aside
      id="menu-panel"
      aria-label="Menu"
      class="fixed inset-y-0 right-0 z-[60] w-full sm:w-[480px] bg-[var(--dark)] text-white translate-x-full transition-transform duration-700 ease-[cubic-bezier(.76,0,.24,1)] flex flex-col justify-between p-10 sm:p-16 print:hidden"
    >
      <div>
        <div class="flex items-center justify-between text-xs text-white/50 pb-6 border-b border-[var(--line-dark)]">
          <span>Navigation</span>
          <button type="button" data-menu-close class="text-white/70 hover:text-white cursor-pointer text-sm">Close</button>
        </div>
        <nav class="mt-10 flex flex-col gap-3 text-[2.6rem] sm:text-[3.4rem] leading-[1.15] tracking-[-0.03em]">
          <a href="/" data-menu-link class="hover:translate-x-2 transition-transform">Home</a>
          <a href={h('#work')} data-menu-link class="hover:translate-x-2 transition-transform">Work</a>
          <a href={h('#labs')} data-menu-link class="hover:translate-x-2 transition-transform">Labs</a>
          <a href={h('#writing')} data-menu-link class="hover:translate-x-2 transition-transform">Writing</a>
          <a href="/resume" data-menu-link class="hover:translate-x-2 transition-transform">Resume</a>
          <a href={h('#contact')} data-menu-link class="hover:translate-x-2 transition-transform">Contact</a>
        </nav>
      </div>
      <div class="text-sm">
        <div class="text-xs text-white/50 mb-3">Elsewhere</div>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="hover:text-white/60">GitHub</a>
          <a href={siteContent.meta.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white/60">LinkedIn</a>
          <a href={`mailto:${siteContent.meta.email}`} class="hover:text-white/60">Email</a>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Image lightbox -->
    <dialog
      id="lightbox-dialog"
      class="m-auto p-0 max-w-[94vw] max-h-[92vh] bg-transparent backdrop:bg-black/80"
      aria-label="Image preview"
    >
      <div class="relative">
        <button
          type="button"
          id="close-lightbox"
          class="absolute -top-12 right-0 text-white/80 hover:text-white text-sm cursor-pointer"
        >
          Close ✕
        </button>
        <img id="lightbox-img" src="" alt="" class="max-w-[94vw] max-h-[86vh] object-contain rounded-md" />
      </div>
    </dialog>

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scroll
      let lenis: Lenis | null = null;
      if (!reduced) {
        lenis = new Lenis({ duration: 1.15, smoothWheel: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis?.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);
      }
      (window as unknown as { __lenis: Lenis | null }).__lenis = lenis;

      // Menu
      const fab = document.getElementById('menu-fab');
      const panel = document.getElementById('menu-panel');
      const overlay = document.getElementById('menu-overlay');
      const setMenu = (open: boolean) => {
        panel?.classList.toggle('translate-x-full', !open);
        overlay?.classList.toggle('opacity-0', !open);
        overlay?.classList.toggle('pointer-events-none', !open);
        if (open) lenis?.stop();
        else lenis?.start();
      };
      document.querySelectorAll('[data-menu-open]').forEach((b) => b.addEventListener('click', () => setMenu(true)));
      document.querySelectorAll('[data-menu-close], [data-menu-link]').forEach((b) =>
        b.addEventListener('click', () => setMenu(false))
      );
      overlay?.addEventListener('click', () => setMenu(false));
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });

      const toggleFab = () => {
        const show = window.scrollY > window.innerHeight * 0.35;
        fab?.classList.toggle('scale-0', !show);
        fab?.classList.toggle('scale-100', show);
      };
      toggleFab();
      window.addEventListener('scroll', toggleFab, { passive: true });

      // Anchor links via Lenis
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href') || '';
          const hash = href.replace(/^\//, '');
          if (href.startsWith('/#') && location.pathname !== '/') return;
          const target = hash.length > 1 ? document.querySelector<HTMLElement>(hash) : null;
          if (!target) return;
          e.preventDefault();
          if (lenis) lenis.scrollTo(target, { offset: -20, duration: 1.4 });
          else target.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', hash);
        });
      });

      // Magnetic elements
      if (!reduced && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          const strength = Number(el.dataset.magnetic) || 0.35;
          const inner = el.querySelector<HTMLElement>('[data-magnetic-inner]');
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = e.clientX - (r.left + r.width / 2);
            const y = e.clientY - (r.top + r.height / 2);
            gsap.to(el, { x: x * strength, y: y * strength, duration: 0.6, ease: 'power3.out' });
            if (inner) gsap.to(inner, { x: x * strength * 0.5, y: y * strength * 0.5, duration: 0.6, ease: 'power3.out' });
          });
          el.addEventListener('mouseleave', () => {
            gsap.to(el, { x: 0, y: 0, duration: 1, ease: 'elastic.out(1, 0.35)' });
            if (inner) gsap.to(inner, { x: 0, y: 0, duration: 1, ease: 'elastic.out(1, 0.35)' });
          });
        });
      }

      // Reveal on scroll
      if (!reduced) {
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
          gsap.from(el, {
            y: 40,
            opacity: 0,
            duration: 1.1,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 88%' },
          });
        });
      }

      // Lightbox
      const lb = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((t) =>
        t.addEventListener('click', (e) => {
          e.preventDefault();
          if (!lb || !lbImg) return;
          lbImg.src = t.dataset.lightboxSrc || '';
          lbImg.alt = t.dataset.lightboxAlt || '';
          lb.showModal();
        })
      );
      document.getElementById('close-lightbox')?.addEventListener('click', () => lb?.close());
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) lb.close();
      });

      // Toronto local time
      const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Toronto',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZoneName: 'short',
      });
      const tick = () =>
        document.querySelectorAll<HTMLElement>('[data-toronto-clock]').forEach((el) => {
          el.textContent = fmt.format(new Date());
        });
      tick();
      setInterval(tick, 15000);
    </script>
  </body>
</html>
