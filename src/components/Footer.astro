---
import { siteContent } from '../data/siteContent';
---

<footer class="w-full border-t border-[var(--rule-hairline)] bg-[var(--bg-surface)] print:hidden">
  <div class="max-w-[960px] mx-auto px-6 sm:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-[var(--rule-hairline)]">
      <!-- Left 6 cols: Signature & Note -->
      <div class="md:col-span-6 space-y-4">
        <img
          src="/assets/logos/tarik-gungor-signature.svg"
          alt="Tarik Gungor signature"
          width="120"
          height="38"
          loading="lazy"
          class="w-[110px] h-auto object-contain dark:invert opacity-85"
        />
        <p class="text-sm text-[var(--text-secondary)] max-w-sm leading-relaxed">
          Computer Systems Technology student and IT Support Specialist in Toronto. Working with networks, Linux, Windows infrastructure, and practical software.
        </p>
      </div>

      <!-- Right 6 cols: Direct Channels & Links -->
      <div class="md:col-span-6 grid grid-cols-2 gap-8 text-sm">
        <div>
          <h4 class="text-xs font-medium text-[var(--text-muted)] mb-3">
            Contact
          </h4>
          <ul class="space-y-2">
            <li>
              <div class="flex items-center gap-2">
                <a
                  href={`mailto:${siteContent.meta.email}`}
                  class="text-[var(--text-primary)] hover:underline text-[13px]"
                >
                  {siteContent.meta.email}
                </a>
                <button
                  type="button"
                  id="footer-copy-email-btn"
                  class="text-[11px] px-1.5 py-0.5 rounded border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                  title="Copy email address"
                >
                  copy
                </button>
              </div>
              <div id="footer-copy-email-feedback" class="hidden text-[11px] text-[var(--signal)] mt-1">
                Copied to clipboard
              </div>
            </li>
            <li>
              <a
                href={siteContent.meta.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-[13px]"
              >
                GitHub (@gungortarik) ↗
              </a>
            </li>
            <li>
              <a
                href={siteContent.meta.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-[13px]"
              >
                LinkedIn ↗
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-medium text-[var(--text-muted)] mb-3">
            Pages
          </h4>
          <ul class="space-y-2 text-[13px]">
            <li>
              <a
                href="/resume"
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
              >
                Resume
              </a>
            </li>
            <li>
              <a
                href="/notes/flexible-but-not-free"
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
              >
                Flexible, but Not Free
              </a>
            </li>
            <li>
              <a
                href="/resume/tarik-gungor-resume.pdf"
                download="tarik-gungor-resume.pdf"
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
              >
                Resume PDF ↓
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <div>
        © {new Date().getFullYear()} Tarik Gungor
      </div>
      <div class="flex items-center gap-2 font-mono-spec text-[11.5px]">
        <span>Toronto, ON</span>
        <span>·</span>
        <span data-toronto-clock>--:--:-- TOR</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const footerCopyBtn = document.getElementById('footer-copy-email-btn');
  const footerFeedback = document.getElementById('footer-copy-email-feedback');
  if (footerCopyBtn && footerFeedback) {
    footerCopyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('gungortarik@icloud.com');
        footerFeedback.classList.remove('hidden');
        setTimeout(() => footerFeedback.classList.add('hidden'), 2500);
      } catch {
        footerFeedback.textContent = 'gungortarik@icloud.com';
        footerFeedback.classList.remove('hidden');
      }
    });
  }
</script>
