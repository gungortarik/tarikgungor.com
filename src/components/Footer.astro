---
import { siteContent } from '../data/siteContent';
---

<footer id="contact" class="bg-[var(--dark)] text-white print:hidden">
  <div class="wrap pt-28 sm:pt-40 pb-10">
    <div class="max-w-[1200px]">
      <div class="flex items-center gap-5" data-reveal>
        <img
          src="/assets/logos/tarik-gungor-monogram.svg"
          alt=""
          width="56"
          height="47"
          class="w-12 sm:w-14 h-auto invert opacity-90"
        />
        <h2 class="display text-[clamp(3rem,8.5vw,8.5rem)]">Let's talk</h2>
      </div>

      <div class="relative mt-14 sm:mt-20 border-t border-[var(--line-dark)]">
        <div class="absolute right-[6%] top-0 -translate-y-1/2">
          <a
            href={`mailto:${siteContent.meta.email}`}
            data-magnetic="0.4"
            class="round-btn btn-fill fill-deep !bg-[var(--accent)]"
          >
            <span data-magnetic-inner>Get in touch</span>
          </a>
        </div>
      </div>

      <div class="mt-24 sm:mt-16 flex flex-wrap gap-4">
        <a href={`mailto:${siteContent.meta.email}`} class="pill-btn btn-fill !border-[var(--line-dark)]" data-magnetic="0.25">
          <span data-magnetic-inner>{siteContent.meta.email}</span>
        </a>
        <a
          href={siteContent.meta.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="pill-btn btn-fill !border-[var(--line-dark)]"
          data-magnetic="0.25"
        >
          <span data-magnetic-inner>linkedin.com/in/tarikgungor</span>
        </a>
      </div>
    </div>

    <div class="mt-28 sm:mt-40 flex flex-col sm:flex-row sm:items-end justify-between gap-8 text-sm">
      <div class="flex gap-10 sm:gap-14">
        <div>
          <div class="text-[11px] text-white/40 mb-2">Version</div>
          <div>{new Date().getFullYear()} © Tarik Gungor</div>
        </div>
        <div>
          <div class="text-[11px] text-white/40 mb-2">Local time</div>
          <div data-toronto-clock>Toronto</div>
        </div>
      </div>
      <div>
        <div class="text-[11px] text-white/40 mb-2">Socials</div>
        <div class="flex gap-7">
          <a href={siteContent.meta.github} target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a>
          <a href={siteContent.meta.linkedin} target="_blank" rel="noopener noreferrer" class="nav-link">LinkedIn</a>
          <a href="/resume/tarik-gungor-resume.pdf" download class="nav-link">Resume PDF</a>
        </div>
      </div>
    </div>
  </div>
</footer>
