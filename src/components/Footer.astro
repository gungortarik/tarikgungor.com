---
import { siteContent } from '../data/siteContent';
---

<footer id="contact" class="border-t border-[var(--line)] bg-[var(--bg-elevated)] text-[var(--ink)] transition-colors duration-300 print:hidden relative z-10">
  <div class="wrap pt-20 sm:pt-28 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Open to IT Infrastructure, Systems & Support Opportunities</span>
        </div>
        <h2 class="font-heading text-3xl sm:text-5xl font-bold tracking-tight text-[var(--ink)] leading-[1.1]">
          Let's build something reliable together.
        </h2>
        <p class="text-[16px] text-[var(--ink-2)] max-w-xl leading-relaxed">
          Whether you're looking for an IT support specialist, need help designing a segmented network lab, or want to talk systems architecture and software — I'd love to connect.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href={`mailto:${siteContent.meta.email}`}
            data-magnetic="0.3"
            class="btn-primary"
          >
            <span data-magnetic-inner class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              {siteContent.meta.email}
            </span>
          </a>

          <a
            href={siteContent.meta.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic="0.3"
            class="btn-secondary"
          >
            <span data-magnetic-inner class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              LinkedIn ↗
            </span>
          </a>

          <a
            href={siteContent.meta.github}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic="0.3"
            class="btn-secondary"
          >
            <span data-magnetic-inner class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              GitHub ↗
            </span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col justify-between gap-8 p-6 rounded-2xl bg-[var(--bg-subtle)] border border-[var(--line)]">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-[var(--muted)] mb-3">Location & Local Time</div>
          <div class="flex items-baseline justify-between">
            <div>
              <div class="font-heading text-xl font-semibold text-[var(--ink)]">{siteContent.meta.region}, Canada</div>
              <div class="text-xs font-mono text-[var(--muted)] mt-0.5">{siteContent.meta.coordinates.lat}, {siteContent.meta.coordinates.lng}</div>
            </div>
            <div class="text-right">
              <div class="font-mono text-xl font-medium text-[var(--accent)]" data-toronto-clock>--:--:--</div>
              <div class="text-xs text-[var(--muted)]">Eastern Time (EST/EDT)</div>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-[var(--line)] flex items-center justify-between text-xs text-[var(--muted)]">
          <div>
            <span>George Brown College</span>
            <div class="text-[var(--ink-2)] mt-0.5">T147 Computer Systems Technology</div>
          </div>
          <a href="/resume/tarik-gungor-resume.pdf" download class="text-[var(--accent)] hover:underline font-medium">
            Download Resume PDF ↓
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-[var(--line)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--muted)]">
      <div>
        © {new Date().getFullYear()} Tarik Gungor. All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <a href="#main-content" class="hover:text-[var(--ink)] transition-colors">Back to top ↑</a>
        <a href="/resume" class="hover:text-[var(--ink)] transition-colors">Resume</a>
        <a href="https://github.com/gungortarik/tarikgungor.com" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">Source Code ↗</a>
      </div>
    </div>
  </div>
</footer>
