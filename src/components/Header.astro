---
interface Props {
  variant?: 'home' | 'resume';
}

const { variant = 'home' } = Astro.props;
---

<header
  class="sticky top-0 z-40 w-full border-b border-[var(--rule-hairline)] bg-[var(--bg-surface)]/92 backdrop-blur-md print:hidden"
>
  <div class="max-w-[960px] mx-auto h-16 px-6 sm:px-8 flex items-center justify-between gap-6">
    <!-- Brand / Identity -->
    <a
      href="/"
      aria-label="Tarik Gungor Home"
      class="flex items-center gap-3 group shrink-0"
    >
      <img
        src="/assets/logos/tarik-gungor-monogram.svg"
        alt="Tarik Gungor monogram"
        width="30"
        height="25"
        fetchpriority="high"
        class="w-[28px] h-auto shrink-0 dark:invert opacity-85 group-hover:opacity-100 transition-opacity"
      />
      <span class="font-display font-semibold text-[15px] tracking-tight text-[var(--text-primary)]">
        Tarik Gungor
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      aria-label="Site Navigation"
      class="hidden md:flex items-center gap-6 text-[13.5px] font-sans"
    >
      {
        variant === 'home' ? (
          <>
            <a
              href="#right-now"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Now
            </a>
            <a
              href="#projects"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Projects
            </a>
            <a
              href="#labs-showcase"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Labs
            </a>
            <a
              href="#notes"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Writing
            </a>
            <a
              href="#path"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Path
            </a>
            <a
              href="/resume"
              class="text-[var(--text-primary)] hover:opacity-70 font-medium transition-opacity"
            >
              Resume
            </a>
          </>
        ) : (
          <>
            <a
              href="/"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              ← Home
            </a>
            <a
              href="#experience"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Experience
            </a>
            <a
              href="#skills"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Skills
            </a>
            <a
              href="#labs"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Labs
            </a>
            <a
              href="#education"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              Education
            </a>
          </>
        )
      }
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-command
        aria-label="Quick navigation"
        class="hidden sm:inline-flex items-center gap-1.5 px-2 py-1 rounded border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      >
        <kbd class="font-mono-spec text-[11px]">⌘K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light and dark theme"
        class="inline-flex items-center px-2.5 py-1 rounded border border-[var(--rule-hairline)] hover:border-[var(--rule-strong)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      >
        <span data-theme-label>Light</span>
      </button>

      <button
        type="button"
        id="mobile-menu-trigger"
        class="md:hidden px-2.5 py-1 rounded border border-[var(--rule-hairline)] text-xs text-[var(--text-primary)] cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        Menu
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-nav-drawer"
    class="hidden md:hidden border-t border-[var(--rule-hairline)] bg-[var(--bg-surface)] text-sm"
  >
    <div class="max-w-[960px] mx-auto px-6 py-5 space-y-3">
      <a href="/#right-now" class="block py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Now</a>
      <a href="/#projects" class="block py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Projects</a>
      <a href="/#labs-showcase" class="block py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Labs</a>
      <a href="/#notes" class="block py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Writing</a>
      <a href="/#path" class="block py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Path</a>
      <a href="/resume" class="block py-1 font-medium text-[var(--text-primary)]">Resume →</a>
    </div>
  </div>
</header>

<script>
  const mobileTrigger = document.getElementById('mobile-menu-trigger');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');

  mobileTrigger?.addEventListener('click', () => {
    if (!mobileDrawer) return;
    const isHidden = mobileDrawer.classList.toggle('hidden');
    mobileTrigger.setAttribute('aria-expanded', String(!isHidden));
    mobileTrigger.textContent = isHidden ? 'Menu' : 'Close';
  });

  mobileDrawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileDrawer.classList.add('hidden');
      mobileTrigger?.setAttribute('aria-expanded', 'false');
      if (mobileTrigger) mobileTrigger.textContent = 'Menu';
    });
  });
</script>
