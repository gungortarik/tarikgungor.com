---
import { siteContent } from '../data/siteContent';
---

<dialog
  id="command-dialog"
  aria-labelledby="command-dialog-title"
  class="w-[92vw] max-w-[540px] rounded-lg border border-[var(--rule-strong)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-2xl overflow-hidden"
>
  <div class="flex flex-col font-sans">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-[var(--rule-hairline)] bg-[var(--bg-panel)]">
      <h2 id="command-dialog-title" class="text-xs font-medium text-[var(--text-secondary)]">
        Quick Navigation
      </h2>
      <button
        type="button"
        id="close-command-dialog"
        class="px-2 py-0.5 text-[11px] rounded border border-[var(--rule-hairline)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        aria-label="Close navigation menu"
      >
        Esc
      </button>
    </div>

    <div class="relative flex items-center px-4 py-3 border-b border-[var(--rule-hairline)]">
      <input
        type="text"
        id="command-input"
        placeholder="Jump to a section or page..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Jump to a section or page"
        class="w-full bg-transparent text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none"
      />
    </div>

    <div class="max-h-[320px] overflow-y-auto divide-y divide-[var(--rule-hairline)]" id="command-list">
      <div class="p-2">
        <div class="px-2.5 py-1 text-[11px] font-medium text-[var(--text-muted)]">
          Sections
        </div>
        <ul class="mt-1 space-y-0.5" role="list">
          <li>
            <a
              href="/#right-now"
              data-cmd-item
              data-keywords="now right now building studying learning"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Now</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/#right-now</span>
            </a>
          </li>
          <li>
            <a
              href="/#projects"
              data-cmd-item
              data-keywords="projects work sonoma certforge software code"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Projects — Sonoma &amp; CertForge</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/#projects</span>
            </a>
          </li>
          <li>
            <a
              href="/#labs-showcase"
              data-cmd-item
              data-keywords="labs infrastructure active directory dns dhcp san iscsi esxi hyper-v cluster"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Systems &amp; Infrastructure Labs</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/#labs-showcase</span>
            </a>
          </li>
          <li>
            <a
              href="/#notes"
              data-cmd-item
              data-keywords="notes writing newsletter flexible but not free toronto"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Writing</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/#notes</span>
            </a>
          </li>
          <li>
            <a
              href="/#path"
              data-cmd-item
              data-keywords="path archive timeline bcit payment source george brown beta prep bestof floor"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Path So Far</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/#path</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="p-2">
        <div class="px-2.5 py-1 text-[11px] font-medium text-[var(--text-muted)]">
          Pages &amp; Documents
        </div>
        <ul class="mt-1 space-y-0.5" role="list">
          <li>
            <a
              href="/notes/flexible-but-not-free"
              data-cmd-item
              data-keywords="note essay read flexible but not free article"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Essay: Flexible, but Not Free</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/notes/...</span>
            </a>
          </li>
          <li>
            <a
              href="/resume"
              data-cmd-item
              data-keywords="resume cv experience skills education beta prep bestof floor"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Resume</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">/resume</span>
            </a>
          </li>
          <li>
            <a
              href="/resume/tarik-gungor-resume.pdf"
              download="tarik-gungor-resume.pdf"
              data-cmd-item
              data-keywords="pdf download resume print"
              class="flex items-center justify-between px-3 py-2 rounded text-sm hover:bg-[var(--bg-panel)] transition-colors"
            >
              <span>Download Resume (PDF)</span>
              <span class="text-xs text-[var(--text-muted)] font-mono-spec">PDF ↓</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('command-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('command-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('close-command-dialog');
  const cmdItems = document.querySelectorAll<HTMLElement>('[data-cmd-item]');

  function openPalette() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    if (input) {
      input.value = '';
      filterItems('');
      input.focus();
    }
  }

  function closePalette() {
    if (!dialog || !dialog.open) return;
    dialog.close();
  }

  document.querySelectorAll<HTMLElement>('[data-open-command]').forEach((trigger) => {
    trigger.addEventListener('click', openPalette);
  });

  closeBtn?.addEventListener('click', closePalette);

  dialog?.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    const clickedOutside =
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom;
    if (clickedOutside) {
      closePalette();
    }
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) {
        closePalette();
      } else {
        openPalette();
      }
    }
  });

  let selectedIndex = -1;

  function getVisibleItems() {
    return Array.from(cmdItems).filter((item) => {
      const li = item.closest('li');
      return li && li.style.display !== 'none';
    });
  }

  function updateSelection(index: number) {
    const visible = getVisibleItems();
    if (visible.length === 0) {
      selectedIndex = -1;
      return;
    }
    selectedIndex = Math.max(0, Math.min(index, visible.length - 1));
    visible.forEach((item, i) => {
      const isActive = i === selectedIndex;
      item.classList.toggle('bg-[var(--bg-panel)]', isActive);
      if (isActive) {
        item.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  function filterItems(query: string) {
    const q = query.trim().toLowerCase();
    cmdItems.forEach((item) => {
      const text = (item.textContent ?? '').toLowerCase();
      const kw = (item.getAttribute('data-keywords') ?? '').toLowerCase();
      const match = !q || text.includes(q) || kw.includes(q);
      const li = item.closest('li');
      if (li) {
        li.style.display = match ? '' : 'none';
      }
    });
    selectedIndex = -1;
    updateSelection(0);
  }

  input?.addEventListener('input', () => {
    filterItems(input.value);
  });

  input?.addEventListener('keydown', (e) => {
    const visible = getVisibleItems();

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateSelection(selectedIndex + 1);
      return;
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateSelection(selectedIndex - 1);
      return;
    }

    if (e.key === 'Enter') {
      if (selectedIndex >= 0 && selectedIndex < visible.length) {
        e.preventDefault();
        visible[selectedIndex].click();
      } else if (visible.length > 0) {
        e.preventDefault();
        visible[0].click();
      }
    }
  });

  cmdItems.forEach((item) => {
    item.addEventListener('click', () => {
      closePalette();
    });
  });
</script>
